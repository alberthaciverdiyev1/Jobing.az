# --- App ---
NODE_ENV=development
APP_NAME=Jobing
APP_URL=http://localhost:3000
PORT=3000
APP_SUFFIX=.az

# --- Locales (comma separated) ---
DEFAULT_LOCALE=az
AVAILABLE_LOCALES=az,en,ru,tr

# --- Database (PostgreSQL) ---
# DB_URL wins over the discrete DB_* values when set.
DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=jobing
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false
DB_POOL_MIN=1
DB_POOL_MAX=10

# --- Auth (stateless JWT) ---
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-long-random-secret-value
JWT_TTL=7d

# --- CORS (comma separated; falls back to APP_URL when empty) ---
CORS_ORIGINS=

# --- Logging ---
LOG_LEVEL=debug
LOG_PRETTY=true

# --- Integrations ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MAIL_HOST=
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM="hello@example.com"
