# --- App ---
NODE_ENV=development
APP_NAME=Jobing
APP_URL=http://localhost:3000
PORT=3000
APP_SUFFIX=.az

# --- Locales ---
DEFAULT_LOCALE=az
AVAILABLE_LOCALES=az,en,ru,tr

# --- Database ---
# Placeholder — final driver is decided in the data-layer step.
DB_CONNECTION=mongodb
DB_HOST=127.0.0.1
DB_PORT=27017
DB_NAME=jobing
DB_URL=

# --- Session / Cookies ---
SESSION_SECRET=change-me-in-production
SESSION_LIFETIME=120
COOKIE_SECRET=change-me-in-production
COOKIE_DOMAIN=

# --- Logging ---
LOG_LEVEL=debug
LOG_PRETTY=true

# --- Integrations ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MAIL_HOST=
MAIL_PORT=2525
MAIL_USER=
MAIL_PASS=
MAIL_FROM="hello@example.com"
