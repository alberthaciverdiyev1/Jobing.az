<nav id="navbar" class="fixed w-full z-50 transition-all duration-500">
    <div class="max-w-[1440px] mx-auto flex justify-between items-center py-3 sm:py-4 px-3 sm:px-4 lg:px-6">
        <!-- Logo -->
        <a href="/" class="flex-shrink-0">
            <img src="/Images/Static/Logo.png" alt="Jobing.az" class="hidden sm:block h-12 lg:h-14 w-auto transition-all duration-300">
            <img src="/Images/Static/LogoMobile.png" alt="Jobing.az" class="block sm:hidden h-8 w-auto">
        </a>

        <!-- Desktop Navigation -->
        <div class="hidden md:flex items-center gap-1">
            <a href="/"
               class="nav-link <%= currentPage === 'home' ? '!text-primary-500 !bg-primary-50/50 !font-semibold' : 'text-gray-600 hover:text-primary-500' %>">Ana Səhifə</a>
            <a href="/vakansiyalar"
               class="nav-link <%= currentPage === 'jobs' ? '!text-primary-500 !bg-primary-50/50 !font-semibold' : 'text-gray-600 hover:text-primary-500' %>">Vakansiyalar</a>
            <a href="/sirketler"
               class="nav-link <%= currentPage === 'company-list' || currentPage === 'company-detail' ? '!text-primary-500 !bg-primary-50/50 !font-semibold' : 'text-gray-600 hover:text-primary-500' %>">Şirkətlər</a>
            <a href="/cv-ler"
               class="nav-link <%= currentPage === 'cv-list' ? '!text-primary-500 !bg-primary-50/50 !font-semibold' : 'text-gray-600 hover:text-primary-500' %>">CV-lər</a>
            <a href="/blogs"
               class="nav-link <%= currentPage === 'blogs' ? '!text-primary-500 !bg-primary-50/50 !font-semibold' : 'text-gray-600 hover:text-primary-500' %>">Bloqlar</a>
            <a href="/about-us"
               class="nav-link <%= currentPage === 'about' ? '!text-primary-500 !bg-primary-50/50 !font-semibold' : 'text-gray-600 hover:text-primary-500' %>">Haqqımızda</a>
            <a href="/contact"
               class="nav-link <%= currentPage === 'contact' ? '!text-primary-500 !bg-primary-50/50 !font-semibold' : 'text-gray-600 hover:text-primary-500' %>">Əlaqə</a>

            <div class="ml-4 pl-4 border-l border-gray-200 flex items-center gap-3">
                <!-- Post Job Button (hidden for user role) -->
                <% if (!user || user.role !== 'user') { %>
                <a href="/add-job"
                   class="inline-flex items-center gap-2 bg-primary-500 hover:bg-primary-600 text-white font-medium px-5 py-2.5 rounded-xl transition-all duration-200 shadow-sm hover:shadow-md hover:shadow-primary-500/20 active:scale-[0.97]">
                    <i class="fas fa-plus-circle text-sm"></i>
                    Elan Yerləşdir
                </a>
                <% } %>

                <!-- Auth: Show login if not logged in, user menu if logged in -->
                <% if (typeof user !== 'undefined' && user) { %>
                    <%- include('UserMenu') %>
                <% } else { %>
                    <a href="/auth"
                       class="inline-flex items-center gap-2 border-2 border-primary-500 text-primary-500 hover:bg-primary-50 font-medium px-5 py-2 rounded-xl transition-all duration-200">
                        <i class="fas fa-user text-sm"></i>
                        Daxil Ol
                    </a>
                <% } %>
            </div>
        </div>

        <!-- Mobile: Post Job Button -->
        <div class="md:hidden flex items-center gap-2">
            <% if (typeof user !== 'undefined' && user) { %>
                <a href="<%= user.role === 'company' || user.role === 'hr' ? '/hr/dashboard' : '/dashboard' %>"
                   class="inline-flex items-center gap-2 bg-primary-50 text-primary-600 text-sm font-medium px-3 py-2 rounded-xl transition-all">
                    <i class="fas fa-user"></i>
                </a>
            <% } else { %>
                <a href="/auth"
                   class="inline-flex items-center gap-2 text-primary-500 border-2 border-primary-500 text-sm font-medium px-3 py-2 rounded-xl">
                    <i class="fas fa-user"></i>
                </a>
            <% } %>
            <% if (!user || user.role !== 'user') { %>
            <a href="/add-job"
               class="inline-flex items-center gap-2 bg-primary-500 hover:bg-primary-600 text-white text-sm font-medium px-4 py-2 rounded-xl transition-all shadow-sm active:scale-95">
                <i class="fas fa-plus-circle text-xs"></i>
                <span>Elan</span>
            </a>
            <% } %>
        </div>
    </div>
</nav>

<!-- Scroll navbar script -->
<script>
(function() {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;
    const isHome = window.location.pathname === '/';
    const updateNavbar = () => {
        if (window.scrollY > 40) {
            navbar.classList.remove('bg-transparent');
            navbar.classList.add('bg-white/95', 'backdrop-blur-lg', 'shadow-sm');
            if (isHome) navbar.classList.add('shadow-[0_1px_3px_rgba(0,0,0,0.06)]');
        } else {
            if (isHome) {
                navbar.classList.add('bg-transparent');
                navbar.classList.remove('bg-white/95', 'backdrop-blur-lg', 'shadow-sm', 'shadow-[0_1px_3px_rgba(0,0,0,0.06)]');
            } else {
                navbar.classList.remove('bg-transparent');
                navbar.classList.add('bg-white/95', 'backdrop-blur-lg', 'shadow-sm');
            }
        }
    };
    if (isHome) {
        navbar.classList.add('bg-transparent');
    } else {
        navbar.classList.add('bg-white/95', 'backdrop-blur-lg', 'shadow-sm');
    }
    window.addEventListener('scroll', updateNavbar, { passive: true });
})();
</script>
