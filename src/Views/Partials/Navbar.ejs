<nav id="navbar" class="fixed w-full z-50 transition-all duration-500">
    <div class="max-w-[1440px] mx-auto flex justify-between items-center py-3 px-3 sm:px-4 lg:px-6">
        <!-- Logo -->
        <a href="/" class="flex-shrink-0">
            <img src="/Images/Static/Logo.png" alt="Jobing.az" class="hidden sm:block h-16 lg:h-14 w-auto transition-all duration-300">
            <img src="/Images/Static/LogoMobile.png" alt="Jobing.az" class="block sm:hidden h-8 w-auto">
        </a>

        <!-- Desktop Navigation -->
        <div class="hidden md:flex items-center gap-1">
            <a href="/"
               class="nav-link <%= currentPage === 'home' ? '!text-primary-500 !bg-primary-50/50 !font-semibold' : 'text-gray-600 hover:text-primary-500' %>"><%= __('nav.home') %></a>
            <a href="/vakansiyalar"
               class="nav-link <%= currentPage === 'jobs' ? '!text-primary-500 !bg-primary-50/50 !font-semibold' : 'text-gray-600 hover:text-primary-500' %>"><%= __('nav.jobs') %></a>
            <a href="/sirketler"
               class="nav-link <%= currentPage === 'company-list' || currentPage === 'company-detail' ? '!text-primary-500 !bg-primary-50/50 !font-semibold' : 'text-gray-600 hover:text-primary-500' %>"><%= __('nav.companies') %></a>
            <a href="/cv-ler"
               class="nav-link <%= currentPage === 'cv-list' ? '!text-primary-500 !bg-primary-50/50 !font-semibold' : 'text-gray-600 hover:text-primary-500' %>"><%= __('nav.cvs') %></a>
            <a href="/about-us"
               class="nav-link <%= currentPage === 'about' ? '!text-primary-500 !bg-primary-50/50 !font-semibold' : 'text-gray-600 hover:text-primary-500' %>"><%= __('nav.about') %></a>
            <a href="/contact"
               class="nav-link <%= currentPage === 'contact' ? '!text-primary-500 !bg-primary-50/50 !font-semibold' : 'text-gray-600 hover:text-primary-500' %>"><%= __('nav.contact') %></a>

            <div class="ml-4 pl-4 border-l border-gray-200 flex items-center gap-3">
                <!-- Post Job Button (visible only for company/hr) -->
                <% if (user && user.role !== 'user') { %>
                <a href="/add-job"
                   class="inline-flex items-center gap-2 bg-primary-500 hover:bg-primary-600 text-white font-medium px-5 py-2.5 rounded-xl transition-all duration-200 shadow-sm hover:shadow-md hover:shadow-primary-500/20 hover:scale-[1.02] active:scale-[0.97]">
                    <i class="fas fa-plus-circle text-sm"></i>
                    <%= __('nav.postJob') %>
                </a>
                <% } %>
                

                <!-- Language Switcher Dropdown (shown on both desktop and mobile) -->
                <div class="relative" id="lang-switcher">
                    <button onclick="toggleLangDropdown()" class="flex items-center gap-1.5 px-2.5 py-2 rounded-lg text-gray-500 hover:text-primary-500 hover:bg-gray-50 transition-all text-sm font-medium">
                        <i class="fas fa-globe text-xs"></i>
                        <span class="uppercase font-semibold"><%= (typeof locale !== 'undefined' ? locale : 'az') %></span>
                        <i class="fas fa-chevron-down text-[8px] ml-0.5"></i>
                    </button>
                    <div id="lang-dropdown" class="absolute right-0 top-full mt-1 bg-white rounded-xl shadow-lg border border-gray-100 py-1 min-w-[110px] hidden z-50 overflow-hidden">
                        <button onclick="changeLang('az')" class="block w-full text-left px-4 py-2.5 text-sm text-gray-700 hover:bg-primary-50 hover:text-primary-500 transition-colors">AZ</button>
                        <button onclick="changeLang('en')" class="block w-full text-left px-4 py-2.5 text-sm text-gray-700 hover:bg-primary-50 hover:text-primary-500 transition-colors">EN</button>
                        <button onclick="changeLang('ru')" class="block w-full text-left px-4 py-2.5 text-sm text-gray-700 hover:bg-primary-50 hover:text-primary-500 transition-colors">RU</button>
                    </div>
                </div>

                <!-- Dark Mode Toggle -->
                <button onclick="toggleDarkMode()" id="darkModeToggle" class="flex items-center justify-center w-11 h-11 rounded-xl text-gray-500 hover:text-yellow-500 hover:bg-gray-50 transition-all dark-mode-toggle" aria-label="Toggle dark mode">
                    <i class="fas fa-moon text-base"></i>
                </button>

                <!-- Auth: Show login if not logged in, user menu if logged in -->
                <% if (typeof user !== 'undefined' && user) { %>
                    <%- include('UserMenu') %>
                <% } else { %>
                    <a href="/auth"
                       class="inline-flex items-center gap-2 border-2 border-primary-500 text-primary-500 hover:bg-primary-50 font-medium px-5 py-2 rounded-xl transition-all duration-200">
                        <i class="fas fa-user text-sm"></i>
                        <%= __('nav.login') %>
                    </a>
                <% } %>
            </div>
        </div>

        <!-- Mobile: Language Dropdown & Dark Mode Toggle -->
        <div class="md:hidden flex items-center gap-2">
            <!-- Mobile Dark Mode Toggle -->
            <button onclick="toggleDarkMode()" id="darkModeToggleMobile" class="flex items-center justify-center w-11 h-11 rounded-xl text-gray-500 hover:text-yellow-500 hover:bg-gray-100 transition-all" aria-label="Toggle dark mode">
                <i class="fas fa-moon text-base"></i>
            </button>
            <!-- Mobile Language Dropdown -->
            <div class="relative">
                <button onclick="toggleLangDropdownMobile()" class="flex items-center gap-1 px-2 py-2 rounded-lg text-gray-500 hover:text-primary-500 hover:bg-gray-100 transition-all text-sm">
                    <i class="fas fa-globe text-xs"></i>
                    <span class="uppercase font-semibold text-[11px]"><%= (typeof locale !== 'undefined' ? locale : 'az') %></span>
                    <i class="fas fa-chevron-down text-[8px]"></i>
                </button>
                <div id="lang-dropdown-mobile" class="absolute right-0 top-full mt-1 bg-white rounded-xl shadow-lg border border-gray-100 py-1 min-w-[110px] hidden z-50 overflow-hidden">
                    <button onclick="changeLang('az')" class="block w-full text-left px-4 py-2.5 text-sm text-gray-700 hover:bg-primary-50 hover:text-primary-500 transition-colors">AZ</button>
                    <button onclick="changeLang('en')" class="block w-full text-left px-4 py-2.5 text-sm text-gray-700 hover:bg-primary-50 hover:text-primary-500 transition-colors">EN</button>
                    <button onclick="changeLang('ru')" class="block w-full text-left px-4 py-2.5 text-sm text-gray-700 hover:bg-primary-50 hover:text-primary-500 transition-colors">RU</button>
                </div>
            </div>
        </div>
    </div>
</nav>

<!-- Scroll navbar script -->
<script>
(function() {
    const navbar = document.getElementById('navbar');
    if (!navbar) return;
    const isHome = window.location.pathname === '/';
    const updateNavbar = () => {
        if (window.scrollY > 40) {
            navbar.classList.remove('bg-transparent');
            navbar.classList.add('bg-white/95', 'backdrop-blur-lg', 'shadow-sm');
            if (isHome) navbar.classList.add('shadow-[0_1px_3px_rgba(0,0,0,0.06)]');
        } else {
            if (isHome) {
                navbar.classList.add('bg-transparent');
                navbar.classList.remove('bg-white/95', 'backdrop-blur-lg', 'shadow-sm', 'shadow-[0_1px_3px_rgba(0,0,0,0.06)]');
            } else {
                navbar.classList.remove('bg-transparent');
                navbar.classList.add('bg-white/95', 'backdrop-blur-lg', 'shadow-sm');
            }
        }
    };
    if (isHome) {
        navbar.classList.add('bg-transparent');
    } else {
        navbar.classList.add('bg-white/95', 'backdrop-blur-lg', 'shadow-sm');
    }
    window.addEventListener('scroll', updateNavbar, { passive: true });
})();
</script>

<!-- Language Switcher & Dark Mode Script -->
<script>
function toggleLangDropdown() {
    const d = document.getElementById('lang-dropdown');
    if (d) d.classList.toggle('hidden');
}
function toggleLangDropdownMobile() {
    const d = document.getElementById('lang-dropdown-mobile');
    if (d) d.classList.toggle('hidden');
}
function changeLang(lang) {
    fetch('/set-lang', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ language: lang })
    }).then(() => { location.reload(); }).catch(() => { location.reload(); });
}
document.addEventListener('click', function(e) {
    const s = document.getElementById('lang-switcher');
    if (s && !s.contains(e.target)) {
        const d = document.getElementById('lang-dropdown');
        if (d) d.classList.add('hidden');
    }
    const sm = document.getElementById('lang-dropdown-mobile');
    if (sm && !e.target.closest('.relative') && !e.target.closest('#lang-dropdown-mobile')) {
        if (sm) sm.classList.add('hidden');
    }
});

// Dark Mode Toggle
function toggleDarkMode() {
    var html = document.documentElement;
    html.classList.toggle('dark');
    var isDark = html.classList.contains('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
    updateDarkModeIcons();
}
function updateDarkModeIcons() {
    var isDark = document.documentElement.classList.contains('dark');
    var iconClass = isDark ? 'fa-sun text-yellow-500' : 'fa-moon';
    document.querySelectorAll('#darkModeToggle i, #darkModeToggleMobile i').forEach(function(icon) {
        icon.className = 'fas ' + iconClass + ' text-base';
    });
}
// Set initial icons
updateDarkModeIcons();
</script>
