<!--
  FilterContent partial
  Reusable filter controls. Used by:
    - Desktop: sidebar layout
    - Mobile: bottom sheet overlay
  The wrapping container is provided by the parent template.
-->
<div class="filter-content">
    <!-- Search -->
    <div class="mb-4">
        <label class="block text-xs font-medium text-gray-500 mb-1.5">Açar söz</label>
        <div class="relative">
            <input type="text" id="search"
                   placeholder="Vəzifə, şirkət..."
                   class="w-full pl-9 pr-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 placeholder:text-gray-400">
            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm"></i>
        </div>
    </div>

    <!-- Job Type -->
    <div class="mb-4">
        <label class="block text-xs font-medium text-gray-500 mb-1.5">İş Tipi</label>
        <div class="flex gap-2" id="job-type-tabs">
            <button class="job-type-btn active flex-1 px-3 py-2 text-xs font-medium rounded-xl bg-primary-500 text-white transition-all" data-type="all">Hamısı</button>
            <button class="job-type-btn flex-1 px-3 py-2 text-xs font-medium rounded-xl bg-gray-100 text-gray-600 hover:bg-gray-200 transition-all" data-type="jobing">Jobing</button>
        </div>
    </div>

    <!-- Category -->
    <div class="mb-4">
        <label class="block text-xs font-medium text-gray-500 mb-1.5">Kateqoriya</label>
        <div class="relative">
            <select id="category-select-filter"
                    class="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all text-gray-900 appearance-none cursor-pointer">
                <option value="">Bütün Kateqoriyalar</option>
            </select>
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">
                <i class="fas fa-chevron-down text-xs"></i>
            </span>
        </div>
    </div>

    <!-- City -->
    <div class="mb-4">
        <label class="block text-xs font-medium text-gray-500 mb-1.5">Şəhər</label>
        <div class="relative">
            <select id="city-select-filter"
                    class="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all text-gray-900 appearance-none cursor-pointer">
                <option value="">Bütün Şəhərlər</option>
            </select>
            <span class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">
                <i class="fas fa-chevron-down text-xs"></i>
            </span>
        </div>
    </div>

    <!-- Advanced Filters Toggle -->
    <div class="mb-4 pt-4 border-t border-gray-100">
        <button id="toggleAdvanced"
                class="text-xs text-primary-500 hover:text-primary-600 transition-colors flex items-center gap-1 w-full">
            <i class="fas fa-plus-circle"></i>
            Ətraflı filtrlər
        </button>
    </div>

    <!-- Advanced Filters -->
    <div id="advancedFilters" class="hidden space-y-4 mb-4">
        <!-- Education -->
        <div>
            <label class="block text-xs font-medium text-gray-500 mb-1.5">Təhsil</label>
            <div class="relative">
                <select id="education-select"
                        class="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all text-gray-900 appearance-none cursor-pointer">
                    <option value="">Bütün təhsil səviyyələri</option>
                </select>
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">
                    <i class="fas fa-chevron-down text-xs"></i>
                </span>
            </div>
        </div>
        <!-- Experience -->
        <div>
            <label class="block text-xs font-medium text-gray-500 mb-1.5">Təcrübə</label>
            <div class="relative">
                <select id="experience-select"
                        class="w-full px-3 py-2.5 bg-gray-50 border border-gray-200 rounded-xl text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all text-gray-900 appearance-none cursor-pointer">
                    <option value="">Bütün təcrübə səviyyələri</option>
                </select>
                <span class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">
                    <i class="fas fa-chevron-down text-xs"></i>
                </span>
            </div>
        </div>
    </div>

    <!-- Apply Button -->
    <button id="applyFiltersBtn"
            class="w-full bg-primary-500 hover:bg-primary-600 text-white text-sm font-medium px-5 py-2.5 rounded-xl transition-all shadow-sm">
        <i class="fas fa-search mr-1.5"></i>
        Tətbiq et
    </button>
</div>
