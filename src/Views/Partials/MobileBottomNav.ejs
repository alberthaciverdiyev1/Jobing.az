<!-- Mobile Bottom Navigation (Instagram-style) -->
<nav class="md:hidden fixed bottom-0 left-0 right-0 z-50 bg-white border-t border-gray-200 safe-area-bottom">
    <div class="flex items-center justify-around h-16">
        <!-- Home -->
        <a href="/"
           class="flex flex-col items-center justify-center gap-0.5 w-16 py-1 <%= currentPage === 'home' ? 'text-primary-500' : 'text-gray-400' %>">
            <i class="fas fa-home text-xl"></i>
            <span class="text-[10px] font-medium">Ana Səhifə</span>
        </a>

        <!-- Jobs -->
        <a href="/vakansiyalar"
           class="flex flex-col items-center justify-center gap-0.5 w-16 py-1 <%= currentPage === 'jobs' ? 'text-primary-500' : 'text-gray-400' %>">
            <i class="fas fa-search text-xl"></i>
            <span class="text-[10px] font-medium">Vakansiyalar</span>
        </a>

        <!-- Add Job (Prominent Center) -->
        <a href="/add-job"
           class="flex flex-col items-center justify-center -mt-4">
            <div class="w-14 h-14 bg-primary-500 rounded-2xl shadow-lg shadow-primary-500/30 flex items-center justify-center text-white hover:bg-primary-600 transition-colors">
                <i class="fas fa-plus text-2xl"></i>
            </div>
            <span class="text-[10px] font-medium text-gray-400 mt-1">Elan</span>
        </a>

        <!-- Blogs -->
        <a href="/blogs"
           class="flex flex-col items-center justify-center gap-0.5 w-16 py-1 <%= currentPage === 'blogs' ? 'text-primary-500' : 'text-gray-400' %>">
            <i class="fas fa-newspaper text-xl"></i>
            <span class="text-[10px] font-medium">Bloqlar</span>
        </a>

        <!-- More -->
        <button id="bottomNavMore"
                class="flex flex-col items-center justify-center gap-0.5 w-16 py-1 text-gray-400">
            <i class="fas fa-ellipsis-h text-xl"></i>
            <span class="text-[10px] font-medium">Daha çox</span>
        </button>
    </div>
</nav>

<script>
(function() {
    const moreBtn = document.getElementById('bottomNavMore');
    const menuToggle = document.getElementById('menuToggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const menuBackdrop = document.getElementById('menuBackdrop');

    if (moreBtn && mobileMenu) {
        moreBtn.addEventListener('click', function() {
            mobileMenu.classList.toggle('open');
            if (menuBackdrop) menuBackdrop.classList.toggle('open');
        });
    }

    // Close mobile menu when a link inside it is clicked
    if (mobileMenu) {
        mobileMenu.querySelectorAll('a').forEach(link => {
            link.addEventListener('click', function() {
                mobileMenu.classList.remove('open');
                if (menuBackdrop) menuBackdrop.classList.remove('open');
            });
        });
    }

    // Add safe area padding for iPhone X+ notch
    const nav = document.querySelector('.safe-area-bottom');
    if (nav && CSS.supports('padding-bottom', 'env(safe-area-inset-bottom)')) {
        nav.style.paddingBottom = 'env(safe-area-inset-bottom)';
    }
})();
</script>
