<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />

    <%
      var seoTitle = (typeof seo !== 'undefined' && seo && seo.title) ? seo.title : (typeof title !== 'undefined' ? title : 'Jobing.az');
      var seoDescription = (typeof seo !== 'undefined' && seo && seo.description) ? seo.description : (typeof description !== 'undefined' ? description : 'Azərbaycanda ən son vakansiyalar, iş elanları və karyera imkanları. Jobing.az ilə iş axtarışınızı başlayın.');
      var seoCanonical = (typeof seo !== 'undefined' && seo && seo.canonical) ? seo.canonical : (typeof canonical !== 'undefined' ? canonical : 'https://jobing.az' + (req && req.originalUrl ? req.originalUrl.split('?')[0] : '/'));
      var seoOgTitle = (typeof seo !== 'undefined' && seo && seo.ogTitle) ? seo.ogTitle : (typeof ogTitle !== 'undefined' ? ogTitle : seoTitle);
      var seoOgDescription = (typeof seo !== 'undefined' && seo && seo.ogDescription) ? seo.ogDescription : (typeof ogDescription !== 'undefined' ? ogDescription : seoDescription);
      var seoOgImage = (typeof seo !== 'undefined' && seo && seo.ogImage) ? seo.ogImage : (typeof ogImage !== 'undefined' ? ogImage : 'https://jobing.az/Images/Static/Logo.png');
    %>


    <!-- Meta Pixel Code -->
    <script>
        !function(f,b,e,v,n,t,s)
        {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
            n.callMethod.apply(n,arguments):n.queue.push(arguments)};
            if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
            n.queue=[];t=b.createElement(e);t.async=!0;
            t.src=v;s=b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t,s)}(window, document,'script',
            'https://connect.facebook.net/en_US/fbevents.js');
        fbq('init', '2033268548067657');
        fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none"
                   src="https://www.facebook.com/tr?id=2033268548067657&ev=PageView&noscript=1"
        /></noscript>
    <!-- End Meta Pixel Code -->

    <!-- Primary Meta -->
    <title><%= seoTitle %> | Jobing.az</title>
    <meta name="description" content="<%= seoDescription %>">
    <meta name="keywords" content="vakansiya, iş elanları, iş axtarışı, Azərbaycan vakansiyalar, jobing.az, boss.az, hello job, karyera">
    <meta name="robots" content="<%= (typeof seo !== 'undefined' && seo && seo.noindex) ? 'noindex, nofollow' : 'index, follow, max-snippet:-1, max-image-preview:large' %>">
    <meta name="google-site-verification" content="DKxrd6e6GbNPPd0KnuDbbsMtnVgmKDdA2jgk3QC-MJc" />
    <meta name="google-adsense-account" content="ca-pub-6130649958615254">
    <link rel="canonical" href="<%= seoCanonical %>" />

    <!-- Hreflang -->
    <link rel="alternate" href="https://jobing.az<%= req ? req.originalUrl.split('?')[0] : '/' %>" hreflang="az" />
    <link rel="alternate" href="https://jobing.az/en<%= req ? req.originalUrl.split('?')[0] : '/' %>" hreflang="en" />
    <link rel="alternate" href="https://jobing.az/ru<%= req ? req.originalUrl.split('?')[0] : '/' %>" hreflang="ru" />
    <link rel="alternate" href="https://jobing.az<%= req ? req.originalUrl.split('?')[0] : '/' %>" hreflang="x-default" />

    <!-- Open Graph -->
    <meta property="og:type" content="<%= typeof ogType !== 'undefined' ? ogType : 'website' %>" />
    <meta property="og:title" content="<%= seoOgTitle %>" />
    <meta property="og:description" content="<%= seoOgDescription %>" />
    <meta property="og:url" content="<%= seoCanonical %>" />
    <meta property="og:image" content="<%= seoOgImage %>" />
    <meta property="og:site_name" content="Jobing.az" />
    <meta property="og:locale" content="az_AZ" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="<%= seoOgTitle %>" />
    <meta name="twitter:description" content="<%= seoOgDescription %>" />
    <meta name="twitter:image" content="<%= seoOgImage %>" />

    <!-- JSON-LD: Organization -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "Jobing.az",
        "url": "https://jobing.az",
        "logo": "https://jobing.az/Images/Static/Logo.png",
        "sameAs": [
            "https://www.facebook.com/profile.php?id=61569206672024",
            "https://www.linkedin.com/company/jobing-az/",
            "https://www.instagram.com/jobing.az/"
        ],
        "description": "Azərbaycanın ən böyük iş axtarış platforması",
        "address": {
            "@type": "PostalAddress",
            "addressCountry": "AZ"
        }
    }
    </script>

    <!-- JSON-LD: WebSite -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Jobing.az",
        "url": "https://jobing.az",
        "potentialAction": {
            "@type": "SearchAction",
            "target": {
                "@type": "EntryPoint",
                "urlTemplate": "https://jobing.az/vakansiyalar?keyword={search_term_string}"
            },
            "query-input": "required name=search_term_string"
        }
    }
    </script>

    <!-- JSON-LD: BreadcrumbList (default) -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Ana Səhifə", "item": "https://jobing.az/" },
            { "@type": "ListItem", "position": 2, "name": "<%= seoTitle %>", "item": "https://jobing.az<%= req ? req.originalUrl.split('?')[0] : '/' %>" }
        ]
    }
    </script>

    <!-- Fonts: preconnect + optimized loading -->
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin>
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"></noscript>

    <!-- FontAwesome (deferred) -->
    <link rel="preload" as="style" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" onload="this.onload=null;this.rel='stylesheet'">
    <noscript><link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"></noscript>

    <!-- Dark Mode: prevent flash -->
    <script>
    (function() {
        var theme = localStorage.getItem('theme');
        if (theme === 'dark') {
            document.documentElement.classList.add('dark');
        }
    })();
    </script>

    <!-- Styles -->
    <link rel="stylesheet" href="/Css/Output.css?v=20260512">
    <link rel="stylesheet" href="/Css/Custom.css?v=20260512">
    <link rel="stylesheet" href="/Css/Dark.css?v=20260513">
    <link rel="stylesheet" href="/Css/Loader.css?v=20260512">
    <link rel="stylesheet" href="/Css/Libraries/Alertify/alertify.min.css?v=20260512">

    <style>
        .modal-open { overflow: hidden; }
    </style>

    <!-- Favicons -->
    <link rel="icon" href="/Images/Favicons/favicon.ico" type="image/x-icon">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link rel="icon" href="/Images/Favicons/favicon-32x32.png" type="image/png" sizes="32x32">
    <link rel="icon" href="/Images/Favicons/favicon-16x16.png" type="image/png" sizes="16x16">
    <link rel="manifest" href="/Images/Favicons/site.webmanifest">
    <link rel="icon" href="/Images/Favicons/android-chrome-192x192.png" type="image/png" sizes="192x192">
    <link rel="icon" href="/Images/Favicons/android-chrome-512x512.png" type="image/png" sizes="512x512">

    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2932L7DPW8"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-2932L7DPW8');
    </script>
    <meta name="google-adsense-account" content="ca-pub-8722833871752467">

    <!-- DNS prefetch for external resources -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://fonts.gstatic.com">
    <link rel="dns-prefetch" href="https://cdnjs.cloudflare.com">
    <link rel="dns-prefetch" href="https://pagead2.googlesyndication.com">
    <link rel="dns-prefetch" href="https://www.googletagmanager.com">
    <link rel="dns-prefetch" href="https://googleads.g.doubleclick.net">

    <% if (typeof seo !== 'undefined' && seo && seo.headerHtml) { %>
      <%- seo.headerHtml %>
    <% } %>
</head>
