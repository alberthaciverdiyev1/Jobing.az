<footer class="bg-white border-t border-gray-100 relative">
    <!-- CTA Section -->
    <div class="max-w-[1440px] mx-auto px-3 sm:px-4 lg:px-6 pt-16 pb-8">
        <div class="relative overflow-hidden bg-gradient-to-br from-primary-500 via-primary-600 to-amber-600 rounded-3xl p-8 md:p-12 animate-fade-in-up shadow-xl shadow-primary-500/10">
            <!-- Decorative circles -->
            <div class="absolute -top-20 -right-20 w-64 h-64 rounded-full bg-white/5"></div>
            <div class="absolute -bottom-10 -left-10 w-40 h-40 rounded-full bg-white/5"></div>
            <div class="absolute top-1/2 left-1/3 w-2 h-2 rounded-full bg-white/20"></div>
            <div class="absolute top-1/4 right-1/4 w-3 h-3 rounded-full bg-white/10"></div>

            <div class="relative z-10 flex flex-col md:flex-row items-center justify-between gap-6">
                <div class="text-center md:text-left">
                    <h3 class="text-2xl md:text-3xl font-bold text-white mb-2">
                        <%= __('cta.jobseekerTitle') %>
                    </h3>
                    <p class="text-white/80 text-lg">
                        <%= __('cta.jobseekerSubtitle') %>
                    </p>
                </div>
                <div class="flex flex-col sm:flex-row gap-3 flex-shrink-0 w-full sm:w-auto">
                    <a href="/vakansiyalar"
                       class="flex-1 sm:flex-initial text-center bg-white hover:bg-gray-50 text-primary-600 font-semibold px-8 py-3.5 rounded-xl transition-all duration-200 shadow-lg shadow-black/10 hover:shadow-xl active:scale-[0.98]">
                        <%= __('cta.showJobs') %>
                    </a>
                    <% if (user && user.role !== 'user') { %>
                    <a href="/add-job"
                       class="flex-1 sm:flex-initial text-center bg-white/10 hover:bg-white/20 text-white font-semibold px-8 py-3.5 rounded-xl border border-white/20 transition-all duration-200 active:scale-[0.98]">
                        <i class="fas fa-plus-circle mr-1.5"></i>
                        <%= __('cta.button') %>
                    </a>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Footer Content -->
    <div class="max-w-[1440px] mx-auto px-3 sm:px-4 lg:px-6 pb-12">
        <div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
            <!-- Company Info -->
            <div class="col-span-2 sm:col-span-2 lg:col-span-1">
<!--                <img src="/Images/Static/Logo.png" alt="Jobing.az" class="h-16 w-auto mb-5">-->
                <p class="text-gray-500 text-sm leading-relaxed mb-5">
                    <%= __('footer.description') %>
                </p>
                <div class="flex gap-2.5">
                    <a href="https://www.facebook.com/profile.php?id=61569206672024" target="_blank" rel="noopener"
                       class="w-10 h-10 flex items-center justify-center rounded-xl bg-gray-100 text-gray-500 hover:bg-primary-100 hover:text-primary-500 hover:scale-105 transition-all duration-200">
                        <i class="fab fa-facebook-f"></i>
                    </a>
                    <a href="#" target="_blank" rel="noopener"
                       class="w-10 h-10 flex items-center justify-center rounded-xl bg-gray-100 text-gray-500 hover:bg-primary-100 hover:text-primary-500 hover:scale-105 transition-all duration-200">
                        <i class="fab fa-twitter"></i>
                    </a>
                    <a href="https://www.linkedin.com/company/jobing-az/" target="_blank" rel="noopener"
                       class="w-10 h-10 flex items-center justify-center rounded-xl bg-gray-100 text-gray-500 hover:bg-primary-100 hover:text-primary-500 hover:scale-105 transition-all duration-200">
                        <i class="fab fa-linkedin-in"></i>
                    </a>
                    <a href="https://www.instagram.com/jobing.az/" target="_blank" rel="noopener"
                       class="w-10 h-10 flex items-center justify-center rounded-xl bg-gray-100 text-gray-500 hover:bg-primary-100 hover:text-primary-500 hover:scale-105 transition-all duration-200">
                        <i class="fab fa-instagram"></i>
                    </a>
                </div>
            </div>

            <!-- Quick Links -->
            <div>
                <h4 class="font-semibold text-gray-900 mb-5 text-sm uppercase tracking-wider"><%= __('footer.quickLinks') %></h4>
                <ul class="space-y-3.5">
                    <li><a href="/" class="text-gray-500 hover:text-primary-500 text-sm transition-colors flex items-center gap-2"><i class="fas fa-chevron-right text-[8px] text-gray-300"></i><%= __('nav.home') %></a></li>
                    <li><a href="/vakansiyalar" class="text-gray-500 hover:text-primary-500 text-sm transition-colors flex items-center gap-2"><i class="fas fa-chevron-right text-[8px] text-gray-300"></i><%= __('nav.jobs') %></a></li>
                    <li><a href="/cv-ler" class="text-gray-500 hover:text-primary-500 text-sm transition-colors flex items-center gap-2"><i class="fas fa-chevron-right text-[8px] text-gray-300"></i><%= __('nav.cvs') %></a></li>
                    <li><a href="/blogs" class="text-gray-500 hover:text-primary-500 text-sm transition-colors flex items-center gap-2"><i class="fas fa-chevron-right text-[8px] text-gray-300"></i><%= __('nav.blogs') %></a></li>
                    <li><a href="/xeberler" class="text-gray-500 hover:text-primary-500 text-sm transition-colors flex items-center gap-2"><i class="fas fa-chevron-right text-[8px] text-gray-300"></i><%= __('nav.news') %></a></li>
                </ul>
            </div>


            <!-- Contact -->
            <div class="col-span-2 sm:col-span-1 lg:col-span-1">
                <h4 class="font-semibold text-gray-900 mb-5 text-sm uppercase tracking-wider"><%= __('footer.contact') %></h4>
                <ul class="space-y-4">
                    <li>
                        <a href="tel:+9944709990569" class="text-gray-500 hover:text-primary-500 text-sm transition-colors flex items-center gap-3">
                            <span class="w-9 h-9 flex items-center justify-center rounded-xl bg-primary-50 text-primary-500 flex-shrink-0">
                                <i class="fas fa-phone text-xs"></i>
                            </span>
                            <span>+994 470 999 05 69</span>
                        </a>
                    </li>
                    <li>
                        <a href="mailto:contact@jobing.az" class="text-gray-500 hover:text-primary-500 text-sm transition-colors flex items-center gap-3">
                            <span class="w-9 h-9 flex items-center justify-center rounded-xl bg-primary-50 text-primary-500 flex-shrink-0">
                                <i class="fas fa-envelope text-xs"></i>
                            </span>
                            <span>contact@jobing.az</span>
                        </a>
                    </li>
                    <li class="text-gray-500 text-sm flex items-center gap-3">
                        <span class="w-9 h-9 flex items-center justify-center rounded-xl bg-primary-50 text-primary-500 flex-shrink-0">
                            <i class="fas fa-globe text-xs"></i>
                        </span>
                        <span>Az / En / Ru</span>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-100 bg-gray-50/50">
        <div class="max-w-[1440px] mx-auto px-3 sm:px-4 lg:px-6 py-5 flex flex-col sm:flex-row justify-between items-center gap-3">
            <p class="text-gray-400 text-sm">
                <%= __('footer.copyright') %>
            </p>
            <div class="flex gap-6">
                <a href="#" class="text-gray-400 hover:text-gray-600 text-xs transition-colors"><%= __('footer.privacy') %></a>
                <a href="#" class="text-gray-400 hover:text-gray-600 text-xs transition-colors"><%= __('footer.terms') %></a>
                <a href="#" class="text-gray-400 hover:text-gray-600 text-xs transition-colors"><%= __('footer.cookies') %></a>
            </div>
        </div>
    </div>

    <!-- Scroll to Top -->
    <button id="scrollTopBtn" onclick="window.scrollTo({ top: 0, behavior: 'smooth' })"
            class="fixed bottom-20 right-6 md:bottom-10 md:right-10 w-12 h-12 flex items-center justify-center bg-gradient-to-br from-primary-500 to-primary-600 text-white rounded-2xl shadow-lg shadow-primary-500/25 opacity-0 pointer-events-none z-50">
        <i class="fas fa-arrow-up text-sm"></i>
    </button>
</footer>

<script>
(function() {
    const btn = document.getElementById('scrollTopBtn');
    if (!btn) return;
    window.addEventListener('scroll', () => {
        if (window.scrollY > 300) {
            btn.classList.remove('opacity-0', 'pointer-events-none');
            btn.classList.add('visible');
        } else {
            btn.classList.remove('visible');
            btn.classList.add('opacity-0', 'pointer-events-none');
        }
    }, { passive: true });
})();
</script>

<% if (typeof seo !== 'undefined' && seo && seo.footerHtml) { %>
  <%- seo.footerHtml %>
<% } %>
