<section class="min-h-screen bg-gray-50 pt-24 md:pt-28 pb-20">
    <div class="max-w-3xl mx-auto px-3 sm:px-4 lg:px-6">
        <!-- Header -->
        <div class="text-center mb-8 animate-fade-in-up">
            <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3">Profil Ayarları</h1>
            <p class="text-gray-500 text-lg">Şəxsi məlumatlarınızı yeniləyin</p>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8 animate-fade-in-up">
            <form id="profileForm" onsubmit="return false;">
                <!-- Personal Info -->
                <div class="mb-8">
                    <div class="flex items-center gap-3 mb-6 pb-4 border-b border-gray-100">
                        <div class="w-10 h-10 rounded-xl bg-primary-50 flex items-center justify-center text-primary-500">
                            <i class="fas fa-user"></i>
                        </div>
                        <div>
                            <h2 class="text-lg font-semibold text-gray-900">Şəxsi Məlumatlar</h2>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">Ad</label>
                            <input type="text" value="<%= user.name %>" disabled
                                   class="w-full px-4 py-3 bg-gray-100 border border-gray-200 rounded-xl text-gray-500 cursor-not-allowed">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">Soyad</label>
                            <input type="text" value="<%= user.surname %>" disabled
                                   class="w-full px-4 py-3 bg-gray-100 border border-gray-200 rounded-xl text-gray-500 cursor-not-allowed">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">Email</label>
                            <input type="email" value="<%= user.email %>" disabled
                                   class="w-full px-4 py-3 bg-gray-100 border border-gray-200 rounded-xl text-gray-500 cursor-not-allowed">
                        </div>
                        <div>
                            <label for="phone" class="block text-sm font-medium text-gray-700 mb-1.5">Telefon</label>
                            <input id="phone" type="tel" value="<%= user.phone || '' %>"
                                   class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all">
                        </div>
                        <div>
                            <label for="age" class="block text-sm font-medium text-gray-700 mb-1.5">Yaş</label>
                            <input id="age" type="number" min="15" max="99" value="<%= user.age || '' %>" placeholder="Yaşınız"
                                   class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all">
                        </div>
                        <div>
                            <label for="profileCity" class="block text-sm font-medium text-gray-700 mb-1.5">Şəhər</label>
                            <select id="profileCity"
                                    class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all">
                                <option value="">Seçin</option>
                                <% (typeof cities !== 'undefined' ? cities : []).forEach(city => { %>
                                    <option value="<%= city.cityId || city._id %>" <%= (String(user.cityId) === String(city.cityId || city._id)) ? 'selected' : '' %>><%= city.name %></option>
                                <% }); %>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Save -->
                <div class="flex justify-end pt-6 border-t border-gray-100">
                    <button type="button" id="saveProfileBtn"
                            class="inline-flex items-center gap-2 bg-gradient-to-r from-primary-500 to-primary-600 hover:from-primary-600 hover:to-primary-700 text-white font-semibold px-8 py-3 rounded-xl transition-all duration-200 shadow-md hover:shadow-lg active:scale-[0.97]">
                        <i class="fas fa-save"></i>
                        Yadda Saxla
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<script>
document.getElementById('saveProfileBtn')?.addEventListener('click', async function() {
    const btn = this;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saxlanılır...';

    try {
        const res = await axios.put('/api/user/profile', {
            phone: document.getElementById('phone').value.trim(),
            age: document.getElementById('age').value || undefined,
            cityId: document.getElementById('profileCity').value || undefined
        });
        if (res.data.status === 200 || res.status === 200) {
            alertify.success('Profil yeniləndi');
        }
    } catch (err) {
        alertify.error(err.response?.data?.error || 'Xəta baş verdi');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-save"></i> Yadda Saxla';
    }
});
</script>
</section>
