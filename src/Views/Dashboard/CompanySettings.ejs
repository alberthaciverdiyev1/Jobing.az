<!-- ============================================ -->
<!-- COMPANY SETTINGS - Professional Profile Page -->
<!-- ============================================ -->
<section class="min-h-screen bg-gray-50 pt-24 md:pt-28 pb-28">
    <div class="max-w-4xl mx-auto px-3 sm:px-4 lg:px-6">
        <!-- Page Header -->
        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8 animate-fade-in-up">
            <div>
                <h1 class="text-2xl sm:text-3xl font-bold text-gray-900">Şirkət Profili</h1>
                <p class="text-gray-500 mt-1">Şirkət məlumatlarınızı peşəkar şəkildə tamamlayın</p>
            </div>
            <div class="flex gap-3">
                <a href="/company/dashboard"
                   class="inline-flex items-center gap-2 bg-white hover:bg-gray-50 text-gray-700 font-medium px-4 py-2.5 rounded-xl border border-gray-200 transition-all duration-200 shadow-sm text-sm">
                    <i class="fas fa-arrow-left text-xs"></i>
                    Panelə Qayıt
                </a>
            </div>
        </div>

        <!-- Error / Success alerts -->
        <div id="alertContainer" class="hidden animate-fade-in-up mb-6">
            <div id="alertMessage" class="px-5 py-3 rounded-xl text-sm font-medium flex items-center gap-3"></div>
        </div>

        <form id="companyProfileForm" class="space-y-6">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <!-- ========== SECTION: Logo & Banner ========== -->
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden animate-fade-in-up" style="animation-delay: 50ms;">
                <div class="px-6 py-5 border-b border-gray-100">
                    <h2 class="text-lg font-semibold text-gray-900">Logo & Banner</h2>
                    <p class="text-sm text-gray-400 mt-0.5">Şirkətinizin görünüşünü fərdiləşdirin</p>
                </div>
                <div class="p-6 space-y-6">
                    <!-- Banner -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Banner Şəkli</label>
                        <div id="bannerPreview" class="w-full h-40 sm:h-52 rounded-xl bg-gray-100 border-2 border-dashed border-gray-200 overflow-hidden flex items-center justify-center relative group cursor-pointer" onclick="document.getElementById('bannerInput').click()">
                            <div id="bannerPlaceholder" class="text-center text-gray-400">
                                <i class="fas fa-image text-3xl mb-2"></i>
                                <p class="text-sm">Banner şəkli yüklə</p>
                                <p class="text-xs mt-1">1920 x 480 px tövsiyə olunur</p>
                            </div>
                            <img id="bannerImg" src="" alt="Banner" class="w-full h-full object-cover hidden">
                            <div class="absolute inset-0 bg-black/0 hover:bg-black/20 transition-colors flex items-center justify-center">
                                <span class="bg-white/90 text-gray-700 text-xs font-medium px-3 py-1.5 rounded-lg opacity-0 group-hover:opacity-100 transition-opacity shadow-sm">
                                    <i class="fas fa-camera mr-1"></i> Dəyiş
                                </span>
                            </div>
                        </div>
                        <input type="file" id="bannerInput" accept="image/*" class="hidden" onchange="uploadBanner(this)">
                    </div>

                    <!-- Logo -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Logo</label>
                        <div class="flex items-center gap-6">
                            <div id="logoPreview" class="w-24 h-24 rounded-xl bg-gray-100 border-2 border-dashed border-gray-200 overflow-hidden flex items-center justify-center relative group cursor-pointer flex-shrink-0" onclick="document.getElementById('logoInput').click()">
                                <div id="logoPlaceholder" class="text-center text-gray-400">
                                    <i class="fas fa-camera text-xl"></i>
                                </div>
                                <img id="logoImg" src="" alt="Logo" class="w-full h-full object-cover hidden">
                                <div class="absolute inset-0 bg-black/0 hover:bg-black/20 transition-colors rounded-xl"></div>
                            </div>
                            <div class="text-sm text-gray-400">
                                <p>Şirkət loqotipi</p>
                                <p class="text-xs mt-1">PNG, JPG, WEBP • 512x512 px tövsiyə</p>
                            </div>
                        </div>
                        <input type="file" id="logoInput" accept="image/*" class="hidden" onchange="uploadLogo(this)">
                    </div>
                </div>
            </div>

            <!-- ========== SECTION: Basic Info ========== -->
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden animate-fade-in-up" style="animation-delay: 100ms;">
                <div class="px-6 py-5 border-b border-gray-100">
                    <h2 class="text-lg font-semibold text-gray-900">Əsas Məlumatlar</h2>
                    <p class="text-sm text-gray-400 mt-0.5">Şirkətiniz haqqında ümumi məlumat</p>
                </div>
                <div class="p-6 space-y-5">
                    <!-- Company Name -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Şirkət Adı <span class="text-red-400">*</span></label>
                        <input type="text" id="companyName" name="companyName"
                               class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none transition-all text-sm bg-gray-50 text-gray-400 cursor-not-allowed"
                               readonly
                               value="<%= user.companyName %>">
                    </div>

                    <!-- Industry & Founded Year & Employee Count -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">Sektor / Sənaye</label>
                            <select id="industry" name="industry"
                                    class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none transition-all text-sm bg-white">
                                <option value="">Seçin</option>
                                <option value="IT & Proqramlaşdırma">IT & Proqramlaşdırma</option>
                                <option value="Maliyyə & Mühasiblik">Maliyyə & Mühasiblik</option>
                                <option value="Marketinq & Reklam">Marketinq & Reklam</option>
                                <option value="Satış & Ticarət">Satış & Ticarət</option>
                                <option value="İnsan Resursları">İnsan Resursları</option>
                                <option value="Logistika & Nəqliyyat">Logistika & Nəqliyyat</option>
                                <option value="Təhsil & Elm">Təhsil & Elm</option>
                                <option value="Səhiyyə & Tibb">Səhiyyə & Tibb</option>
                                <option value="İnşaat & Memarlıq">İnşaat & Memarlıq</option>
                                <option value="Qida & Aqrar">Qida & Aqrar</option>
                                <option value="Media & Dizayn">Media & Dizayn</option>
                                <option value="Hüquq">Hüquq</option>
                                <option value="Turizm & Qonaqpərvərlik">Turizm & Qonaqpərvərlik</option>
                                <option value="Enerji & Təbii Sərvətlər">Enerji & Təbii Sərvətlər</option>
                                <option value="Digər">Digər</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">Qurum İli</label>
                            <input type="number" id="foundedYear" name="foundedYear" min="1900" max="2099"
                                   class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none transition-all text-sm"
                                   placeholder="məs: 2010">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">İşçi Sayı</label>
                            <select id="employeeCount" name="employeeCount"
                                    class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none transition-all text-sm bg-white">
                                <option value="">Seçin</option>
                                <option value="1-10">1-10</option>
                                <option value="11-50">11-50</option>
                                <option value="51-200">51-200</option>
                                <option value="201-500">201-500</option>
                                <option value="501-1000">501-1000</option>
                                <option value="1000+">1000+</option>
                            </select>
                        </div>
                    </div>

                    <!-- Description -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Şirkət Haqqında</label>
                        <textarea id="description" name="description" rows="5"
                                  class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none transition-all text-sm resize-y"
                                  placeholder="Şirkətiniz haqqında qısa məlumat..."></textarea>
                    </div>

                    <!-- Website -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Vebsayt</label>
                        <input type="url" id="website" name="website"
                               class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none transition-all text-sm"
                               placeholder="https://sirketiniz.az">
                    </div>
                </div>
            </div>

            <!-- ========== SECTION: Contact ========== -->
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden animate-fade-in-up" style="animation-delay: 150ms;">
                <div class="px-6 py-5 border-b border-gray-100">
                    <h2 class="text-lg font-semibold text-gray-900">Əlaqə Məlumatları</h2>
                    <p class="text-sm text-gray-400 mt-0.5">Müraciət edənlərin sizə çatması üçün</p>
                </div>
                <div class="p-6 space-y-5">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">Telefon</label>
                            <input type="tel" id="phone" name="phone"
                                   class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none transition-all text-sm"
                                   placeholder="+994 XX XXX XX XX">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">Email</label>
                            <input type="email" id="email" name="email"
                                   class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none transition-all text-sm"
                                   placeholder="info@sirketiniz.az">
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Ünvan</label>
                        <input type="text" id="address" name="address"
                               class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none transition-all text-sm"
                               placeholder="Bakı, Nizami küçəsi, 1">
                    </div>
                </div>
            </div>

            <!-- ========== SECTION: Social Media ========== -->
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden animate-fade-in-up" style="animation-delay: 200ms;">
                <div class="px-6 py-5 border-b border-gray-100">
                    <h2 class="text-lg font-semibold text-gray-900">Sosial Media</h2>
                    <p class="text-sm text-gray-400 mt-0.5">Sosial şəbəkə hesablarınızı əlavə edin</p>
                </div>
                <div class="p-6 space-y-4">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">
                                <i class="fab fa-facebook text-blue-600 mr-1.5"></i>Facebook
                            </label>
                            <input type="url" id="socialFacebook" name="socialLinks[facebook]"
                                   class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none transition-all text-sm"
                                   placeholder="https://facebook.com/sirketiniz">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">
                                <i class="fab fa-instagram text-pink-600 mr-1.5"></i>Instagram
                            </label>
                            <input type="url" id="socialInstagram" name="socialLinks[instagram]"
                                   class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none transition-all text-sm"
                                   placeholder="https://instagram.com/sirketiniz">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">
                                <i class="fab fa-twitter text-sky-500 mr-1.5"></i>Twitter
                            </label>
                            <input type="url" id="socialTwitter" name="socialLinks[twitter]"
                                   class="w-full px-4 py-2.5 rounded-xl border border-gray-200 focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none transition-all text-sm"
                                   placeholder="https://twitter.com/sirketiniz">
                        </div>
                    </div>
                </div>
            </div>

            <!-- ========== SECTION: Working Hours ========== -->
            <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden animate-fade-in-up" style="animation-delay: 250ms;">
                <div class="px-6 py-5 border-b border-gray-100">
                    <h2 class="text-lg font-semibold text-gray-900">İş Saatları</h2>
                    <p class="text-sm text-gray-400 mt-0.5">Həftəlik iş rejiminizi təyin edin</p>
                </div>
                <div class="p-6">
                    <div class="space-y-3">
                        <% const days = [
                            { key: 'monday', label: 'Bazar ertəsi' },
                            { key: 'tuesday', label: 'Çərşənbə axşamı' },
                            { key: 'wednesday', label: 'Çərşənbə' },
                            { key: 'thursday', label: 'Cümə axşamı' },
                            { key: 'friday', label: 'Cümə' },
                            { key: 'saturday', label: 'Şənbə' },
                            { key: 'sunday', label: 'Bazar' }
                        ]; %>
                        <% days.forEach(d => { %>
                        <div class="flex items-center gap-4">
                            <span class="w-36 text-sm font-medium text-gray-600"><%= d.label %></span>
                            <input type="text" id="wh_<%= d.key %>" data-day="<%= d.key %>"
                                   class="wh-input flex-1 px-4 py-2 rounded-xl border border-gray-200 focus:border-primary-400 focus:ring-2 focus:ring-primary-100 outline-none transition-all text-sm"
                                   placeholder="09:00 - 18:00">
                            <button type="button" onclick="clearWorkingHour('<%= d.key %>')"
                                    class="text-gray-300 hover:text-red-400 transition-colors text-sm px-2">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                        <% }); %>
                    </div>
                </div>
            </div>

            <!-- ========== SUBMIT ========== -->
            <div class="flex flex-col sm:flex-row items-center justify-between gap-4 animate-fade-in-up" style="animation-delay: 300ms;">
                <p class="text-sm text-gray-400">
                    <i class="fas fa-info-circle mr-1"></i> Dəyişikliklər dərhal tətbiq olunacaq
                </p>
                <div class="flex gap-3 w-full sm:w-auto">
                    <a href="/company/dashboard"
                       class="flex-1 sm:flex-none text-center px-6 py-2.5 rounded-xl border border-gray-200 text-gray-600 hover:bg-gray-50 transition-all text-sm font-medium">
                        Ləğv Et
                    </a>
                    <button type="submit"
                            class="flex-1 sm:flex-none px-8 py-2.5 bg-gradient-to-r from-primary-500 to-primary-600 hover:from-primary-600 hover:to-primary-700 text-white rounded-xl transition-all duration-200 shadow-sm hover:shadow-md active:scale-[0.97] text-sm font-medium">
                        <i class="fas fa-save mr-1.5"></i> Yadda Saxla
                    </button>
                </div>
            </div>
        </form>
    </div>
</section>

<script>
// Pre-fill form with existing company data
(function() {
    const company = <%- JSON.stringify(company || {}) %>;
    if (!company || !company._id) return;

    // Basic fields
    if (company.industry) document.getElementById('industry').value = company.industry;
    if (company.foundedYear) document.getElementById('foundedYear').value = company.foundedYear;
    if (company.employeeCount) document.getElementById('employeeCount').value = company.employeeCount;
    if (company.description) document.getElementById('description').value = company.description;
    if (company.website) document.getElementById('website').value = company.website;
    if (company.phone) document.getElementById('phone').value = company.phone;
    if (company.email) document.getElementById('email').value = company.email;
    if (company.address) document.getElementById('address').value = company.address;

    // Social links
    if (company.socialLinks) {
        if (company.socialLinks.facebook) document.getElementById('socialFacebook').value = company.socialLinks.facebook;
        if (company.socialLinks.instagram) document.getElementById('socialInstagram').value = company.socialLinks.instagram;
        if (company.socialLinks.twitter) document.getElementById('socialTwitter').value = company.socialLinks.twitter;
    }

    // Working hours
    if (company.workingHours) {
        document.querySelectorAll('.wh-input').forEach(inp => {
            const day = inp.dataset.day;
            if (company.workingHours[day]) inp.value = company.workingHours[day];
        });
    }

    // Logo & Banner
    if (company.imageUrl) {
        const logoImg = document.getElementById('logoImg');
        const logoPlaceholder = document.getElementById('logoPlaceholder');
        logoImg.src = company.imageUrl;
        logoImg.classList.remove('hidden');
        logoPlaceholder.classList.add('hidden');
    }
    if (company.bannerUrl) {
        const bannerImg = document.getElementById('bannerImg');
        const bannerPlaceholder = document.getElementById('bannerPlaceholder');
        bannerImg.src = company.bannerUrl;
        bannerImg.classList.remove('hidden');
        bannerPlaceholder.classList.add('hidden');
    }
})();
</script>
