<!DOCTYPE html>
<html lang="<%= (typeof req !== 'undefined' && req.locale ? req.locale : 'az') %>">
    <!-- Head -->
    <%- include('Partials/Head') %>
  <body class="bg-gray-50 font-sans text-gray-900 antialiased flex flex-col min-h-screen pb-16 md:pb-0">
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PV8D5X3V"
                    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->

    <% if (typeof seo !== 'undefined' && seo && seo.bodyTopHtml) { %>
      <%- seo.bodyTopHtml %>
    <% } %>
    <!-- Navbar -->
    <%- include('Partials/Navbar') %>
    <!-- Mobile Bottom Nav -->
    <%- include('Partials/MobileBottomNav') %>
    <!-- Main Content -->
    <main id="main-content">
      <%- include(body) %>
    </main>
    <!-- Footer -->
    <%- include('Partials/Footer') %>
    <% if (typeof seo !== 'undefined' && seo && seo.bodyBottomHtml) { %>
      <%- seo.bodyBottomHtml %>
    <% } %>
    <!-- Js -->
    <%- include('Partials/Js') %>
  </body>

</html>