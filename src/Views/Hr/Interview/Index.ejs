<div class="space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-800"><%= __('hr.interviews') %></h1>
  </div>

  <!-- Stats -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <p class="text-sm text-gray-500"><%= __('hr.pending') %></p>
      <p id="statPending" class="text-xl font-bold text-amber-600 mt-1">0</p>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <p class="text-sm text-gray-500"><%= __('hr.confirmed') %></p>
      <p id="statConfirmed" class="text-xl font-bold text-emerald-600 mt-1">0</p>
    </div>
    <div class="bg-white rounded-xl border border-gray-200 p-4">
      <p class="text-sm text-gray-500"><%= __('hr.cancelled') %></p>
      <p id="statCancelled" class="text-xl font-bold text-red-600 mt-1">0</p>
    </div>
  </div>

  <!-- Table -->
  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="text-left px-5 py-3 font-medium text-gray-600"><%= __('hr.applicant') %></th>
            <th class="text-left px-5 py-3 font-medium text-gray-600"><%= __('hr.job') %></th>
            <th class="text-left px-5 py-3 font-medium text-gray-600"><%= __('hr.dateTimeTable') %></th>
            <th class="text-left px-5 py-3 font-medium text-gray-600"><%= __('hr.location') %></th>
            <th class="text-left px-5 py-3 font-medium text-gray-600"><%= __('hr.status') %></th>
            <th class="text-right px-5 py-3 font-medium text-gray-600"><%= __('hr.tableActions') %></th>
          </tr>
        </thead>
        <tbody id="interviewsTableBody" class="divide-y divide-gray-100"></tbody>
      </table>
    </div>
  </div>
</div>
