<div class="max-w-4xl mx-auto space-y-6">
  <!-- Back + Actions -->
  <div class="flex items-center justify-between">
    <a href="/hr/jobs" class="inline-flex items-center gap-2 text-sm text-gray-500 hover:text-gray-700 transition-colors">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
      <%= __('hr.backToJobs') %>
    </a>
    <div class="flex gap-2">
      <button onclick="toggleJob()" class="px-4 py-2 text-sm font-medium rounded-lg transition-colors <%= job.isActive ? 'bg-red-50 text-red-600 hover:bg-red-100' : 'bg-green-50 text-green-600 hover:bg-green-100' %>">
        <%= job.isActive ? 'Deactivate' : 'Activate' %>
      </button>
    </div>
  </div>

  <!-- Main Card -->
  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <!-- Header -->
    <div class="p-6 border-b border-gray-100">
      <div class="flex items-start justify-between">
        <div>
          <h1 class="text-2xl font-bold text-gray-900"><%= job.title %></h1>
          <p class="text-lg text-gray-500 mt-1"><%= job.companyName || '-' %></p>
        </div>
        <span class="px-3 py-1 text-sm font-medium rounded-full <%= job.isActive ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700' %>">
          <%= job.isActive ? 'Active' : 'Inactive' %>
        </span>
      </div>
    </div>

    <!-- Stats Row -->
    <div class="grid grid-cols-3 divide-x divide-gray-100 bg-gray-50/50">
      <div class="p-4 text-center">
        <p class="text-2xl font-bold text-gray-900" id="appCount">-</p>
        <p class="text-xs text-gray-500 mt-1"><%= __('hr.applications') %></p>
      </div>
      <div class="p-4 text-center">
        <p class="text-2xl font-bold text-gray-900"><%= job.viewCount || 0 %></p>
        <p class="text-xs text-gray-500 mt-1"><%= __('hr.views') %></p>
      </div>
      <div class="p-4 text-center">
        <p class="text-2xl font-bold text-gray-900"><%= job.postedAt ? new Date(job.postedAt).toLocaleDateString() : '-' %></p>
        <p class="text-xs text-gray-500 mt-1"><%= __('hr.posted') %></p>
      </div>
    </div>

    <!-- Details -->
    <div class="p-6 space-y-6">
      <!-- Info Grid -->
      <div class="grid grid-cols-2 gap-6">
        <div>
          <label class="text-xs font-medium text-gray-400 uppercase tracking-wider"><%= __('hr.location') %></label>
          <p class="text-sm text-gray-900 mt-1"><%= job.location || '-' %></p>
        </div>
        <div>
          <label class="text-xs font-medium text-gray-400 uppercase tracking-wider"><%= __('hr.jobType') %></label>
          <p class="text-sm text-gray-900 mt-1"><%= job._jobTypeName || '-' %></p>
        </div>
        <div>
          <label class="text-xs font-medium text-gray-400 uppercase tracking-wider"><%= __('hr.salary') %></label>
          <p class="text-sm text-gray-900 mt-1"><%= job.minSalary ? job.minSalary : '' %><%= job.minSalary && job.maxSalary ? ' - ' : '' %><%= job.maxSalary ? job.maxSalary + ' ' + job.currencySign : (job.minSalary ? job.currencySign : '-') %></p>
        </div>
        <div>
          <label class="text-xs font-medium text-gray-400 uppercase tracking-wider"><%= __('hr.category') %></label>
          <p class="text-sm text-gray-900 mt-1"><%= job.categoryId || '-' %></p>
        </div>
        <div>
          <label class="text-xs font-medium text-gray-400 uppercase tracking-wider"><%= __('hr.education') %></label>
          <p class="text-sm text-gray-900 mt-1"><%= job._educationName || '-' %></p>
        </div>
        <div>
          <label class="text-xs font-medium text-gray-400 uppercase tracking-wider"><%= __('hr.experience') %></label>
          <p class="text-sm text-gray-900 mt-1"><%= job._experienceName || '-' %></p>
        </div>
        <div>
          <label class="text-xs font-medium text-gray-400 uppercase tracking-wider"><%= __('hr.email') %></label>
          <p class="text-sm text-gray-900 mt-1"><%= job.email || '-' %></p>
        </div>
        <div>
          <label class="text-xs font-medium text-gray-400 uppercase tracking-wider"><%= __('hr.phone') %></label>
          <p class="text-sm text-gray-900 mt-1"><%= job.phone || '-' %></p>
        </div>
      </div>

      <!-- Description -->
      <div>
        <label class="text-xs font-medium text-gray-400 uppercase tracking-wider mb-2 block"><%= __('hr.description') %></label>
        <div class="text-sm text-gray-700 leading-relaxed bg-gray-50 rounded-lg p-4"><%= job.description || '<%= __('hr.noDescription') %>' %></div>
      </div>

      <!-- Timestamps -->
      <div class="flex gap-6 text-xs text-gray-400 border-t border-gray-100 pt-4">
        <span><%= __('hr.created') %> <%= job.createdAt ? new Date(job.createdAt).toLocaleString() : '-' %></span>
        <span><%= __('hr.updated') %> <%= job.updatedAt ? new Date(job.updatedAt).toLocaleString() : '-' %></span>
      </div>
    </div>
  </div>
</div>

<script>
async function toggleJob() {
    try {
        var res = await axios.patch('/api/hr/jobs/<%= job._id %>/toggle');
        alertify.success(res.data.isActive ? '<%= __('hr.jobActivated') %>' : '<%= __('hr.jobDeactivated') %>');
        location.reload();
    } catch (err) {
        alertify.error(err.message);
    }
}

// Load application counts
document.addEventListener('DOMContentLoaded', async function() {
    try {
        var res = await axios.get('/api/hr/application-counts', {
            params: { jobIds: '<%= job._id %>' }
        });
        var counts = res.data['<%= job._id %>'];
        if (counts) {
            document.getElementById('appCount').textContent = counts.total || 0;
        }
    } catch (err) {
        console.error(err);
    }
});
</script>
