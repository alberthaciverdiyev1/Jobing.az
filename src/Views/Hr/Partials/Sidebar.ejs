<aside id="hr-sidebar" class="fixed top-0 left-0 z-[9998] w-64 h-screen pt-20 transition-transform -translate-x-full bg-white border-r border-gray-200 sm:translate-x-0" aria-label="HR Sidebar">
  <div class="h-full px-3 pb-4 overflow-y-auto bg-white">
    <ul class="space-y-2 font-medium">
      <li>
        <a href="/hr/dashboard" class="sidebar-link flex items-center p-2 text-gray-900 rounded-lg hover:bg-gray-100 group">
          <svg class="w-5 h-5 text-gray-500 transition duration-75 group-hover:text-gray-900" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 22 21">
            <path d="M16.975 11H10V4.025a1 1 0 0 0-1.066-.998 8.5 8.5 0 1 0 9.039 9.039.999.999 0 0 0-1-1.066h.002Z"/>
            <path d="M12.5 0c-.157 0-.311.01-.565.027A1 1 0 0 0 11 1.02V10h8.975a1 1 0 0 0 1-.935c.013-.188.028-.374.028-.565A8.51 8.51 0 0 0 12.5 0Z"/>
          </svg>
          <span class="ms-3">Dashboard</span>
        </a>
      </li>
      <li>
        <a href="/hr/jobs" class="sidebar-link flex items-center p-2 text-gray-900 rounded-lg hover:bg-gray-100 group">
          <svg class="flex-shrink-0 w-5 h-5 text-gray-500 transition duration-75 group-hover:text-gray-900" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
            <path d="M6 15h8V5H6v10Zm-2 0V5H2V3h16v2h-2v10h2v2H2v-2h2ZM4 3V1h12v2H4Z"/>
          </svg>
          <span class="flex-1 ms-3 whitespace-nowrap">Jobs</span>
          <span id="sidebar-jobs-count" class="hidden inline-flex items-center justify-center px-2 py-0.5 text-xs font-medium rounded-full bg-blue-100 text-blue-700 min-w-[20px]">0</span>
        </a>
      </li>
      <li>
        <a href="/hr/applications" class="sidebar-link flex items-center p-2 text-gray-900 rounded-lg hover:bg-gray-100 group">
          <svg class="flex-shrink-0 w-5 h-5 text-gray-500 transition duration-75 group-hover:text-gray-900" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
            <path d="M4 0h12a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2zm3 4a1 1 0 0 0 0 2h6a1 1 0 0 0 0-2H7zm0 3a1 1 0 0 0 0 2h6a1 1 0 0 0 0-2H7zm0 3a1 1 0 0 0 0 2h4a1 1 0 0 0 0-2H7z"/>
          </svg>
          <span class="flex-1 ms-3 whitespace-nowrap">Applications</span>
          <span id="sidebar-pending-count" class="hidden inline-flex items-center justify-center px-2 py-0.5 text-xs font-medium rounded-full bg-red-100 text-red-700 min-w-[20px]">0</span>
        </a>
      </li>
      <li>
        <a href="/hr/interviews" class="sidebar-link flex items-center p-2 text-gray-900 rounded-lg hover:bg-gray-100 group">
          <svg class="flex-shrink-0 w-5 h-5 text-gray-500 transition duration-75 group-hover:text-gray-900" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
            <path d="M17 5.923A1 1 0 0 0 16 5h-3V4a4 4 0 1 0-8 0v1H2a1 1 0 0 0-1 .923L.086 17.846A2 2 0 0 0 2.08 20h13.84a2 2 0 0 0 1.994-2.153L17 5.923ZM7 9a1 1 0 0 1-2 0V7h2v2Zm0-5a2 2 0 1 1 4 0v1H7V4Zm6 5a1 1 0 1 1-2 0V7h2v2Z"/>
          </svg>
          <span class="flex-1 ms-3 whitespace-nowrap">Interviews</span>
          <span id="sidebar-interview-count" class="hidden inline-flex items-center justify-center px-2 py-0.5 text-xs font-medium rounded-full bg-amber-100 text-amber-700 min-w-[20px]">0</span>
        </a>
      </li>
    </ul>
    <div class="pt-4 mt-4 border-t border-gray-200">
      <a href="/" target="_blank" class="flex items-center p-2 text-gray-600 rounded-lg hover:bg-gray-100 group">
        <svg class="w-5 h-5 text-gray-500 transition duration-75 group-hover:text-gray-900" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 18 18">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 1v16M1 9h16"/>
        </svg>
        <span class="ms-3">View Website</span>
      </a>
      <a href="/api/auth/logout" class="flex items-center p-2 text-red-600 rounded-lg hover:bg-red-50 group">
        <svg class="w-5 h-5 text-red-500 transition duration-75 group-hover:text-red-700" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 18 15">
          <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 7.5h11m0 0L8.5 4M12 7.5 8.5 11M7 1.5h7a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H7"/>
        </svg>
        <span class="ms-3">Logout</span>
      </a>
    </div>
  </div>
</aside>

<script>
document.addEventListener('DOMContentLoaded', function() {
  var jobsBadge = document.getElementById('sidebar-jobs-count');
  var pendingBadge = document.getElementById('sidebar-pending-count');
  var interviewBadge = document.getElementById('sidebar-interview-count');

  axios.get('/api/hr/stats').then(function(res) {
    var data = res.data;

    if (data.activeJobs > 0) {
      jobsBadge.textContent = data.activeJobs;
      jobsBadge.classList.remove('hidden');
    }

    if (data.pendingApplications > 0) {
      pendingBadge.textContent = data.pendingApplications;
      pendingBadge.classList.remove('hidden');
    }

    if (data.upcomingInterviews > 0) {
      interviewBadge.textContent = data.upcomingInterviews;
      interviewBadge.classList.remove('hidden');
    }
  }).catch(function() {});
});
</script>
