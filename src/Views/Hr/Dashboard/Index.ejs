<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-900">HR Dashboard</h1>
      <p class="text-sm text-gray-500 mt-1">Overview of your recruitment activity</p>
    </div>
    <span class="text-xs text-gray-400" id="liveTimestamp"></span>
  </div>

  <!-- Stats Cards -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4" id="statsContainer">
    <div class="relative group">
      <div class="absolute inset-0 bg-gradient-to-br from-blue-500 to-blue-600 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      <div class="relative bg-white border border-gray-200 rounded-xl p-5 group-hover:border-transparent group-hover:text-white transition-all duration-300">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-gray-500 group-hover:text-blue-100 transition-colors">Total Jobs</p>
            <p id="statTotalJobs" class="text-2xl font-bold text-gray-800 group-hover:text-white mt-1">-</p>
          </div>
          <div class="w-12 h-12 bg-blue-100 group-hover:bg-white/20 rounded-lg flex items-center justify-center transition-colors">
            <svg class="w-6 h-6 text-blue-600 group-hover:text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M6 15h8V5H6v10Zm-2 0V5H2V3h16v2h-2v10h2v2H2v-2h2ZM4 3V1h12v2H4Z"/></svg>
          </div>
        </div>
        <p id="statActiveJobs" class="text-xs text-green-600 group-hover:text-green-200 mt-2"><span class="font-medium">Active:</span> -</p>
      </div>
    </div>

    <div class="relative group">
      <div class="absolute inset-0 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      <div class="relative bg-white border border-gray-200 rounded-xl p-5 group-hover:border-transparent group-hover:text-white transition-all duration-300">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-gray-500 group-hover:text-emerald-100 transition-colors">Applications</p>
            <p id="statApplications" class="text-2xl font-bold text-gray-800 group-hover:text-white mt-1">-</p>
          </div>
          <div class="w-12 h-12 bg-emerald-100 group-hover:bg-white/20 rounded-lg flex items-center justify-center transition-colors">
            <svg class="w-6 h-6 text-emerald-600 group-hover:text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M4 0h12a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2zm3 4a1 1 0 0 0 0 2h6a1 1 0 0 0 0-2H7zm0 3a1 1 0 0 0 0 2h6a1 1 0 0 0 0-2H7zm0 3a1 1 0 0 0 0 2h4a1 1 0 0 0 0-2H7z"/></svg>
          </div>
        </div>
        <p id="statInterviews" class="text-xs text-emerald-600 group-hover:text-emerald-200 mt-2"><span class="font-medium">Interviews:</span> -</p>
      </div>
    </div>

    <div class="relative group">
      <div class="absolute inset-0 bg-gradient-to-br from-amber-500 to-amber-600 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      <div class="relative bg-white border border-gray-200 rounded-xl p-5 group-hover:border-transparent group-hover:text-white transition-all duration-300">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-gray-500 group-hover:text-amber-100 transition-colors">Upcoming Interviews</p>
            <p id="statUpcomingInterviews" class="text-2xl font-bold text-gray-800 group-hover:text-white mt-1">-</p>
          </div>
          <div class="w-12 h-12 bg-amber-100 group-hover:bg-white/20 rounded-lg flex items-center justify-center transition-colors">
            <svg class="w-6 h-6 text-amber-600 group-hover:text-white" fill="currentColor" viewBox="0 0 20 20"><path d="M17 5.923A1 1 0 0 0 16 5h-3V4a4 4 0 1 0-8 0v1H2a1 1 0 0 0-1 .923L.086 17.846A2 2 0 0 0 2.08 20h13.84a2 2 0 0 0 1.994-2.153L17 5.923ZM7 9a1 1 0 0 1-2 0V7h2v2Zm0-5a2 2 0 1 1 4 0v1H7V4Zm6 5a1 1 0 1 1-2 0V7h2v2Z"/></svg>
          </div>
        </div>
        <p class="text-xs text-gray-400 group-hover:text-amber-200 mt-2">Scheduled interviews</p>
      </div>
    </div>

    <div class="relative group">
      <div class="absolute inset-0 bg-gradient-to-br from-purple-500 to-purple-600 rounded-xl opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
      <div class="relative bg-white border border-gray-200 rounded-xl p-5 group-hover:border-transparent group-hover:text-white transition-all duration-300">
        <div class="flex items-center justify-between">
          <div>
            <p class="text-sm text-gray-500 group-hover:text-purple-100 transition-colors">Companies</p>
            <p id="statCompanies" class="text-2xl font-bold text-gray-800 group-hover:text-white mt-1">-</p>
          </div>
          <div class="w-12 h-12 bg-purple-100 group-hover:bg-white/20 rounded-lg flex items-center justify-center transition-colors">
            <svg class="w-6 h-6 text-purple-600 group-hover:text-white" fill="currentColor" viewBox="0 0 20 18"><path d="M14 2a3.963 3.963 0 0 0-1.4.267 6.439 6.439 0 0 1-1.331 6.638A4 4 0 1 0 14 2Zm1 9h-1.264A6.957 6.957 0 0 1 15 15v2a2.97 2.97 0 0 1-.184 1H19a1 1 0 0 0 1-1v-1a5.006 5.006 0 0 0-5-5ZM6.5 9a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9ZM8 10H5a5.006 5.006 0 0 0-5 5v2a1 1 0 0 0 1 1h11a1 1 0 0 0 1-1v-2a5.006 5.006 0 0 0-5-5Z"/></svg>
          </div>
        </div>
        <p id="statCompanyNames" class="text-xs text-gray-500 group-hover:text-purple-200 mt-2 truncate">-</p>
      </div>
    </div>
  </div>

  <!-- Quick Actions -->
  <div class="bg-white rounded-xl border border-gray-200 p-5">
    <h2 class="text-lg font-semibold text-gray-800 mb-4">Quick Actions</h2>
    <div class="flex flex-wrap gap-3">
      <a href="/hr/jobs" class="inline-flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-emerald-500 to-emerald-600 text-white rounded-lg hover:from-emerald-600 hover:to-emerald-700 transition-all duration-200 text-sm font-medium shadow-sm hover:shadow-md">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Manage Jobs
      </a>
      <a href="/hr/applications" class="inline-flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-blue-500 to-blue-600 text-white rounded-lg hover:from-blue-600 hover:to-blue-700 transition-all duration-200 text-sm font-medium shadow-sm hover:shadow-md">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
        View Applications
      </a>
      <a href="/hr/interviews" class="inline-flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-amber-500 to-amber-600 text-white rounded-lg hover:from-amber-600 hover:to-amber-700 transition-all duration-200 text-sm font-medium shadow-sm hover:shadow-md">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        Manage Interviews
      </a>
    </div>
  </div>

  <!-- Recent Applications -->
  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <div class="px-5 py-4 border-b border-gray-100 flex items-center justify-between">
      <h2 class="text-lg font-semibold text-gray-800">Recent Applications</h2>
      <a href="/hr/applications" class="text-sm text-blue-600 hover:text-blue-700 font-medium">View All →</a>
    </div>
    <div id="recentApplicationsContainer">
      <table class="w-full">
        <thead>
          <tr class="text-left text-xs font-medium text-gray-400 uppercase tracking-wider bg-gray-50">
            <th class="px-5 py-3">Applicant</th>
            <th class="px-5 py-3">Job</th>
            <th class="px-5 py-3">Status</th>
            <th class="px-5 py-3">Date</th>
          </tr>
        </thead>
        <tbody id="recentAppsBody" class="divide-y divide-gray-100">
          <tr><td colspan="4" class="px-5 py-8 text-center text-gray-400">Loading...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>
