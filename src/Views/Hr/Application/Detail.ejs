<div class="space-y-6">
  <a href="/hr/applications" class="inline-flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
    Back to Applications
  </a>

  <h1 class="text-2xl font-bold text-gray-800">Application Detail</h1>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Info -->
    <div class="lg:col-span-2 space-y-6">
      <!-- Job Info -->
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <h2 class="text-lg font-semibold text-gray-800 mb-3">Job Details</h2>
        <p class="text-sm text-gray-600"><strong>Title:</strong> <span id="appJobTitle"></span></p>
        <p class="text-sm text-gray-600"><strong>Company:</strong> <span id="appCompany"></span></p>
        <p class="text-sm text-gray-600"><strong>Location:</strong> <span id="appLocation"></span></p>
      </div>

      <!-- Applicant CV -->
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <h2 class="text-lg font-semibold text-gray-800 mb-3">Applicant CV</h2>
        <div id="cvContent" class="text-sm text-gray-600 space-y-3"></div>
      </div>

      <!-- User Response -->
      <div id="userResponseSection" class="bg-white rounded-xl border border-gray-200 p-5 hidden">
        <h2 class="text-lg font-semibold text-gray-800 mb-3">Applicant Response</h2>
        <p id="userResponseText" class="text-sm text-gray-600"></p>
      </div>
    </div>

    <!-- Sidebar -->
    <div class="space-y-6">
      <!-- Status Card -->
      <div class="bg-white rounded-xl border border-gray-200 p-5">
        <h2 class="text-lg font-semibold text-gray-800 mb-3">Status</h2>
        <p id="appStatus" class="text-sm font-medium"></p>
        <p class="text-xs text-gray-400 mt-1">Applied: <span id="appDate"></span></p>
      </div>

      <!-- Actions -->
      <div class="bg-white rounded-xl border border-gray-200 p-5 space-y-3">
        <h2 class="text-lg font-semibold text-gray-800">Actions</h2>

        <div id="pendingActions">
          <button onclick="showAcceptModal()" class="w-full px-4 py-2 text-sm text-white bg-emerald-500 rounded-lg hover:bg-emerald-600 mb-2">Accept</button>
          <button onclick="showRejectModal()" class="w-full px-4 py-2 text-sm text-white bg-red-500 rounded-lg hover:bg-red-600">Reject</button>
        </div>

        <div id="interviewActions" class="hidden">
          <button onclick="showInterviewModal()" class="w-full px-4 py-2 text-sm text-white bg-amber-500 rounded-lg hover:bg-amber-600">Schedule Interview</button>
        </div>

        <div id="resolvedActions" class="hidden">
          <p class="text-sm text-gray-500">Application resolved.</p>
          <p id="decisionReason" class="text-xs text-gray-400 mt-1"></p>
        </div>
      </div>

      <!-- Interview Card -->
      <div id="interviewCard" class="bg-white rounded-xl border border-gray-200 p-5 hidden">
        <h2 class="text-lg font-semibold text-gray-800 mb-3">Interview</h2>
        <p class="text-sm text-gray-600"><strong>Date:</strong> <span id="interviewDate"></span></p>
        <p class="text-sm text-gray-600"><strong>Duration:</strong> <span id="interviewDuration"></span> min</p>
        <p class="text-sm text-gray-600"><strong>Location:</strong> <span id="interviewLocation"></span></p>
        <p class="text-sm text-gray-600"><strong>Notes:</strong> <span id="interviewNotes"></span></p>
        <p class="text-sm text-gray-600"><strong>Status:</strong> <span id="interviewStatus"></span></p>
      </div>
    </div>
  </div>
</div>

<!-- Accept Modal -->
<div id="acceptModal" class="hidden fixed inset-0 z-[99999] bg-black/50 flex items-center justify-center p-4">
  <div class="bg-white rounded-xl w-full max-w-md p-5">
    <h3 class="text-lg font-semibold text-gray-800 mb-4">Accept Application</h3>
    <textarea id="acceptReason" rows="3" placeholder="Optional: Add a message to the applicant..." class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-emerald-500 outline-none mb-4"></textarea>
    <div class="flex justify-end gap-3">
      <button onclick="closeModal('acceptModal')" class="px-4 py-2 text-sm text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200">Cancel</button>
      <button onclick="confirmAccept()" class="px-4 py-2 text-sm text-white bg-emerald-500 rounded-lg hover:bg-emerald-600">Confirm Accept</button>
    </div>
  </div>
</div>

<!-- Reject Modal -->
<div id="rejectModal" class="hidden fixed inset-0 z-[99999] bg-black/50 flex items-center justify-center p-4">
  <div class="bg-white rounded-xl w-full max-w-md p-5">
    <h3 class="text-lg font-semibold text-gray-800 mb-4">Reject Application</h3>
    <textarea id="rejectReason" rows="3" placeholder="Explain why (the applicant will see this)..." class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-red-500 outline-none mb-4"></textarea>
    <div class="flex justify-end gap-3">
      <button onclick="closeModal('rejectModal')" class="px-4 py-2 text-sm text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200">Cancel</button>
      <button onclick="confirmReject()" class="px-4 py-2 text-sm text-white bg-red-500 rounded-lg hover:bg-red-600">Confirm Reject</button>
    </div>
  </div>
</div>

<!-- Interview Modal -->
<div id="interviewModal" class="hidden fixed inset-0 z-[99999] bg-black/50 flex items-center justify-center p-4">
  <div class="bg-white rounded-xl w-full max-w-md p-5">
    <h3 class="text-lg font-semibold text-gray-800 mb-4">Schedule Interview</h3>
    <div class="space-y-3">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Date & Time *</label>
        <input id="interviewScheduledAt" type="datetime-local" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-amber-500 outline-none">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Duration (minutes)</label>
        <input id="interviewDurationInput" type="number" value="30" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-amber-500 outline-none">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Location / Meeting Link</label>
        <input id="interviewLocationInput" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-amber-500 outline-none">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Notes</label>
        <textarea id="interviewNotesInput" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-amber-500 outline-none"></textarea>
      </div>
    </div>
    <div class="flex justify-end gap-3 mt-4 pt-4 border-t border-gray-200">
      <button onclick="closeModal('interviewModal')" class="px-4 py-2 text-sm text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200">Cancel</button>
      <button onclick="confirmInterview()" class="px-4 py-2 text-sm text-white bg-amber-500 rounded-lg hover:bg-amber-600">Schedule</button>
    </div>
  </div>
</div>
