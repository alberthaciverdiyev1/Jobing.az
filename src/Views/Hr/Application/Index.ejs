<div class="space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-800"><%= __('hr.applicationsPage') %></h1>
  </div>

  <!-- Filters -->
  <div class="flex flex-wrap gap-3">
    <select id="jobFilter" onchange="loadApplications()" class="px-3 py-2 border border-gray-300 rounded-lg text-sm outline-none focus:ring-2 focus:ring-emerald-500">
      <option value=""><%= __('hr.allJobs') %></option>
    </select>
    <select id="statusFilter" onchange="loadApplications()" class="px-3 py-2 border border-gray-300 rounded-lg text-sm outline-none focus:ring-2 focus:ring-emerald-500">
      <option value=""><%= __('hr.allStatus') %></option>
      <option value="pending"><%= __('hr.pending') %></option>
      <option value="accepted"><%= __('hr.accepted') %></option>
      <option value="rejected"><%= __('hr.rejected') %></option>
      <option value="interview"><%= __('hr.interview') %></option>
    </select>
  </div>

  <!-- Table -->
  <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="text-left px-5 py-3 font-medium text-gray-600"><%= __('hr.applicant') %></th>
            <th class="text-left px-5 py-3 font-medium text-gray-600"><%= __('hr.job') %></th>
            <th class="text-left px-5 py-3 font-medium text-gray-600"><%= __('hr.tableCompany') %></th>
            <th class="text-left px-5 py-3 font-medium text-gray-600"><%= __('hr.status') %></th>
            <th class="text-left px-5 py-3 font-medium text-gray-600"><%= __('hr.tableApplied') %></th>
            <th class="text-right px-5 py-3 font-medium text-gray-600"><%= __('hr.tableActions') %></th>
          </tr>
        </thead>
        <tbody id="applicationsTableBody" class="divide-y divide-gray-100"></tbody>
      </table>
    </div>
    <div id="pagination" class="flex items-center justify-between px-5 py-3 border-t border-gray-200"></div>
  </div>
</div>
