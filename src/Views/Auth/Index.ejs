<!-- ============================================ -->
<!-- AUTH PAGE: Login / Register with Role Selection -->
<!-- ============================================ -->
<section class="min-h-screen bg-gradient-to-b from-gray-50 to-white pt-28 pb-16 md:pt-36 md:pb-20">
    <div class="max-w-lg mx-auto px-3 sm:px-4">
        <!-- Header -->
        <div class="text-center mb-8 animate-fade-in-up">
            <div class="w-16 h-16 mx-auto bg-gradient-to-br from-primary-50 to-amber-50 rounded-2xl flex items-center justify-center mb-4 shadow-sm border border-primary-100">
                <i class="fas fa-user text-2xl text-primary-500"></i>
            </div>
            <h1 class="text-3xl font-bold text-gray-900 mb-2"><%= __('auth.welcome') %></h1>
            <p class="text-gray-500"><%= __('auth.welcomeSub') %></p>
        </div>

        <!-- Message Banner -->
        <% if (typeof authMessage !== 'undefined' && authMessage === 'post_job') { %>
        <div class="mb-6 p-4 bg-amber-50 border border-amber-200 rounded-xl text-sm text-amber-800 flex items-start gap-3 animate-fade-in-up">
            <i class="fas fa-info-circle mt-0.5"></i>
            <span><%= __('auth.postJobRequired') %></span>
        </div>
        <% } %>

        <!-- Main Card -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8 animate-fade-in-up">
            <!-- Tabs -->
            <div class="flex bg-gray-100 rounded-xl p-1 mb-8">
                <button type="button" id="login-tab" class="flex-1 py-2.5 text-sm font-semibold rounded-lg transition-all duration-200 bg-white text-gray-900 shadow-sm"><%= __('auth.login') %></button>
                <button type="button" id="register-tab" class="flex-1 py-2.5 text-sm font-semibold rounded-lg transition-all duration-200 text-gray-500 hover:text-gray-700"><%= __('auth.register') %></button>
            </div>

            <!-- ==================== LOGIN FORM ==================== -->
            <form id="login-form" class="space-y-5">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5"><%= __('auth.email') %></label>
                    <div class="relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"><i class="fas fa-envelope"></i></span>
                        <input type="email" id="login-email" placeholder="email@example.com" required
                               class="w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 placeholder:text-gray-400">
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5"><%= __('auth.password') %></label>
                    <div class="relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"><i class="fas fa-lock"></i></span>
                        <input type="password" id="login-password" placeholder="••••••••" required
                               class="w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 placeholder:text-gray-400">
                    </div>
                </div>
                <div class="flex items-center justify-between">
                    <label class="flex items-center gap-2 cursor-pointer">
                        <input type="checkbox" id="login-remember" class="w-4 h-4 rounded border-gray-300 text-primary-500 focus:ring-primary-500 accent-primary-500">
                        <span class="text-sm text-gray-600"><%= __('auth.remember') %></span>
                    </label>
                </div>
                <button type="submit"
                        class="w-full bg-gradient-to-r from-primary-500 to-primary-600 hover:from-primary-600 hover:to-primary-700 text-white font-semibold py-3.5 rounded-xl transition-all duration-200 shadow-sm hover:shadow-md hover:shadow-primary-500/20 active:scale-[0.98] flex items-center justify-center gap-2">
                    <i class="fas fa-sign-in-alt"></i>
                    <span><%= __('auth.loginButton') %></span>
                </button>
            </form>

            <!-- ==================== REGISTER FORM ==================== -->
            <form id="register-form" class="space-y-5 hidden">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <!-- Name -->
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5"><%= __('auth.name') %></label>
                        <input type="text" id="reg-name" placeholder="Adınız" required
                               class="w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 placeholder:text-gray-400">
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5"><%= __('auth.surname') %></label>
                        <input type="text" id="reg-surname" placeholder="Soyadınız" required
                               class="w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 placeholder:text-gray-400">
                    </div>
                </div>
                <!-- Email -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Email</label>
                    <div class="relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"><i class="fas fa-envelope"></i></span>
                        <input type="email" id="reg-email" placeholder="email@example.com" required
                               class="w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 placeholder:text-gray-400">
                    </div>
                </div>
                <!-- Phone -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5"><%= __('auth.phone') %></label>
                    <div class="relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"><i class="fas fa-phone"></i></span>
                        <input type="tel" id="reg-phone" placeholder="+994 XX XXX XX XX"
                               class="w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 placeholder:text-gray-400">
                    </div>
                </div>
                <!-- Password -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">Şifrə</label>
                    <div class="relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"><i class="fas fa-lock"></i></span>
                        <input type="password" id="reg-password" placeholder="<%= __('auth.passPlaceholder') %>" required
                               class="w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 placeholder:text-gray-400">
                    </div>
                </div>
                <!-- Confirm Password -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1.5"><%= __('auth.confirmPassword') %></label>
                    <div class="relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"><i class="fas fa-lock"></i></span>
                        <input type="password" id="reg-confirm-password" placeholder="<%= __('auth.confirmPassPlaceholder') %>" required
                               class="w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 placeholder:text-gray-400">
                    </div>
                </div>

                <!-- Role Selection -->
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-3"><%= __('auth.accountType') %></label>
                    <div class="grid grid-cols-2 gap-3">
                        <button type="button" id="role-user"
                                class="role-selector active flex items-center gap-3 p-4 rounded-xl border-2 border-primary-500 bg-primary-50/30 transition-all duration-200">
                            <div class="w-10 h-10 rounded-lg bg-primary-100 flex items-center justify-center text-primary-500">
                                <i class="fas fa-user"></i>
                            </div>
                            <div class="text-left">
                                <p class="text-sm font-semibold text-gray-900"><%= __('auth.roleUser') %></p>
                                <p class="text-xs text-gray-500"><%= __('auth.postCV') %></p>
                            </div>
                        </button>
                        <button type="button" id="role-company"
                                class="role-selector flex items-center gap-3 p-4 rounded-xl border-2 border-gray-200 hover:border-gray-300 bg-white transition-all duration-200">
                            <div class="w-10 h-10 rounded-lg bg-gray-100 flex items-center justify-center text-gray-400">
                                <i class="fas fa-building"></i>
                            </div>
                            <div class="text-left">
                                <p class="text-sm font-semibold text-gray-900"><%= __('auth.roleCompany') %></p>
                                <p class="text-xs text-gray-500"><%= __('auth.postJob') %></p>
                            </div>
                        </button>
                    </div>
                    <input type="hidden" id="reg-role" value="user">
                </div>

                <!-- Company Name (shown only for company role) -->
                <div id="company-name-field" class="hidden">
                    <label class="block text-sm font-medium text-gray-700 mb-1.5"><%= __('auth.companyName') %> <span class="text-red-500">*</span></label>
                    <div class="relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"><i class="fas fa-building"></i></span>
                        <input type="text" id="reg-company-name" placeholder="Şirkətinizin adı"
                               class="w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 placeholder:text-gray-400">
                    </div>
                </div>

                <button type="submit"
                        class="w-full bg-gradient-to-r from-primary-500 to-primary-600 hover:from-primary-600 hover:to-primary-700 text-white font-semibold py-3.5 rounded-xl transition-all duration-200 shadow-sm hover:shadow-md hover:shadow-primary-500/20 active:scale-[0.98] flex items-center justify-center gap-2">
                    <i class="fas fa-user-plus"></i>
                    <span><%= __('auth.registerButton') %></span>
                </button>
            </form>
        </div>

        <!-- Info Text -->
        <p class="text-center text-xs text-gray-400 mt-6 animate-fade-in-up">
            <i class="fas fa-shield-alt mr-1 text-primary-400"></i>
            <%= __('auth.secure') %>
        </p>
    </div>
</section>
