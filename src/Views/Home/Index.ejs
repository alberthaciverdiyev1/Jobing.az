<!-- ============================================ -->
<!-- HERO — Apple-inspired Minimal -->
<!-- ============================================ -->
<section class="bg-white pt-28 pb-20 md:pt-36 md:pb-28">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center">
            <h1 class="text-[2.25rem] sm:text-[3rem] lg:text-[3.5rem] font-bold text-gray-900 leading-[1.1] tracking-[-0.02em] mb-4">
                <%= __('hero.title') %>
                <span class="text-primary-500"><%= __('hero.titleHighlight') %></span>
            </h1>
            <p class="text-lg sm:text-xl text-gray-400 max-w-xl mx-auto mb-10 leading-relaxed">
                <%= __('hero.subtitle') %>
            </p>

            <!-- Search — floating card -->
            <div class="bg-white rounded-2xl border border-gray-100 shadow-xl shadow-gray-200/40 p-2">
                <form action="/vakansiyalar" method="GET" class="flex flex-col sm:flex-row gap-2">
                    <div class="flex-1 relative">
                        <input type="text" name="keyword" id="keyword"
                               placeholder="<%= __('hero.searchPlaceholder') %>"
                               class="w-full pl-4 pr-4 py-3.5 bg-transparent border-0 focus:outline-none text-sm placeholder:text-gray-300">
                    </div>
                    <div class="sm:w-44 relative border-t sm:border-t-0 sm:border-l border-gray-100">
                        <select id="city-select" name="cityId"
                                class="w-full pl-4 pr-8 py-3.5 bg-transparent border-0 focus:outline-none text-sm appearance-none cursor-pointer text-gray-400">
                            <option value="" class="text-gray-400"><%= __('hero.cityPlaceholder') %></option>
                        </select>
                    </div>
                    <button type="submit"
                            class="bg-primary-500 hover:bg-primary-600 text-white font-medium px-8 py-3.5 rounded-xl transition-all duration-200 text-sm">
                        <%= __('hero.search') %>
                    </button>
                </form>
            </div>

            <!-- Trending -->
            <div class="flex flex-wrap items-center justify-center gap-2 mt-5">
                <span class="text-[11px] text-gray-300 font-medium tracking-wide uppercase"><%= __('hero.trending') %></span>
                <a href="/vakansiyalar?keyword=Proqramist"
                   class="px-3 py-1.5 text-[13px] text-gray-500 hover:text-gray-900 transition-colors">Proqramist</a>
                <a href="/vakansiyalar?keyword=Design"
                   class="px-3 py-1.5 text-[13px] text-gray-500 hover:text-gray-900 transition-colors">Dizayner</a>
                <a href="/vakansiyalar?keyword=Manager"
                   class="px-3 py-1.5 text-[13px] text-gray-500 hover:text-gray-900 transition-colors">Menecer</a>
                <a href="/vakansiyalar?keyword=Marketinq"
                   class="px-3 py-1.5 text-[13px] text-gray-500 hover:text-gray-900 transition-colors">Marketinq</a>
            </div>
        </div>
    </div>
</section>

<!-- ============================================ -->
<!-- STATS — Simple numbers, clean divider -->
<!-- ============================================ -->
<section class="hidden sm:block bg-gray-50 border-y border-gray-100">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <div class="flex items-center justify-center gap-12 md:gap-20">
            <% const stats = [
                { id: 'vacancy', value: '0', label: __('stats.vacancy') },
                { id: 'company', value: '0', label: __('stats.company') },
                { id: 'visitor', value: '0', label: __('stats.monthlyVisitors') },
                { id: 'totalVisitor', value: '0', label: __('stats.totalVisitors') },
            ]; %>
            <% stats.forEach((stat, i) => { %>
                <% if (i > 0) { %><div class="w-px h-10 bg-gray-200 hidden md:block"></div><% } %>
                <div class="text-center">
                    <div class="text-2xl font-bold text-gray-900" id="<%= stat.id %>"><%= stat.value %></div>
                    <div class="text-sm text-gray-400 mt-0.5"><%= stat.label %></div>
                </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- ============================================ -->
<!-- CATEGORIES — 8 items, icon circles -->
<!-- ============================================ -->
<% if (typeof topCategories !== 'undefined' && topCategories.length > 0) { %>
<section class="py-20 sm:py-24 bg-white">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14">
            <h2 class="text-[1.75rem] sm:text-[2.25rem] font-bold text-gray-900 tracking-[-0.015em]"><%= __('categories.title') %></h2>
            <p class="text-gray-400 text-base mt-2"><%= __('categories.subtitle') %></p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-8">
            <% topCategories.forEach(function(cat) { %>
            <a href="/vakansiyalar?categoryId=<%= cat.categoryId %>"
               class="group flex flex-col items-center text-center px-2">
                <div class="w-16 h-16 mb-4 flex items-center justify-center rounded-full bg-gray-50 group-hover:bg-primary-50 transition-colors duration-200">
                    <i class="fas <%= cat.icon || 'fa-folder' %> text-xl text-gray-600 group-hover:text-primary-500 transition-colors duration-200"></i>
                </div>
                <h3 class="text-sm font-semibold text-gray-900 group-hover:text-primary-600 transition-colors leading-snug"><%= cat.name %></h3>
                <p class="text-xs text-gray-400 mt-1"><%= cat.count %> <%= __('categories.vacancyCount') %></p>
            </a>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<!-- ============================================ -->
<!-- RECENT JOBS -->
<!-- ============================================ -->
<section class="py-20 sm:py-24 bg-gray-50">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14">
            <h2 class="text-[1.75rem] sm:text-[2.25rem] font-bold text-gray-900 tracking-[-0.015em]">
                <%= __('recentJobs.title') %>
            </h2>
            <p class="text-gray-400 text-base mt-2">
                <%= __('recentJobs.subtitle') %>
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4" id="home-card-section">
            <div class="col-span-full flex items-center justify-center py-24">
                <div class="flex flex-col items-center gap-3">
                    <div class="w-6 h-6 border-2 border-gray-200 border-t-gray-900 rounded-full animate-spin"></div>
                    <span class="text-sm text-gray-400"><%= __('recentJobs.loading') %></span>
                </div>
            </div>
        </div>

        <div class="text-center mt-12">
            <a href="/vakansiyalar"
               class="inline-flex items-center gap-2 text-sm font-medium text-primary-500 hover:text-primary-600 transition-colors">
                <%= __('recentJobs.viewAll') %> <i class="fas fa-arrow-right text-xs"></i>
            </a>
        </div>
    </div>
</section>

