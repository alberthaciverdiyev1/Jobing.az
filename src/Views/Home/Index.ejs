<!-- ============================================ -->
<!-- HERO SECTION — Modern Redesign -->
<!-- ============================================ -->
<section class="relative bg-gradient-to-br from-primary-600 via-primary-700 to-indigo-800 pt-28 pb-20 md:pt-40 md:pb-28 overflow-hidden">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-10">
        <div class="absolute top-0 right-0 w-96 h-96 bg-white rounded-full blur-3xl -translate-y-1/2 translate-x-1/4"></div>
        <div class="absolute bottom-0 left-0 w-80 h-80 bg-indigo-300 rounded-full blur-3xl translate-y-1/3 -translate-x-1/4"></div>
    </div>
    <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cg fill=\'none\' fill-rule=\'evenodd\'%3E%3Cg fill=\'%23ffffff\' fill-opacity=\'0.05\'%3E%3Cpath d=\'M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z\'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>

    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-3xl mx-auto text-center">
            <!-- Badge -->
            <div class="inline-flex items-center gap-2 bg-white/10 backdrop-blur-sm text-white/90 text-sm font-medium px-4 py-1.5 rounded-full mb-6 border border-white/10 animate-fade-in-up">
                <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
                <%= __('hero.badge') %>
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight mb-4 animate-fade-in-up" style="animation-delay: 50ms;">
                <%= __('hero.title') %>
                <span class="text-transparent bg-clip-text bg-gradient-to-r from-yellow-300 to-orange-400"><%= __('hero.titleHighlight') %></span>
            </h1>

            <p class="text-lg sm:text-xl text-white/70 max-w-xl mx-auto mb-10 animate-fade-in-up" style="animation-delay: 100ms;">
                <%= __('hero.subtitle') %>
            </p>

            <!-- Search Form -->
            <div class="bg-white/10 backdrop-blur-md rounded-2xl border border-white/10 p-2 animate-fade-in-up" style="animation-delay: 150ms;">
                <form action="/vakansiyalar" method="GET" class="flex flex-col sm:flex-row gap-2">
                    <div class="flex-1 relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-white/40">
                            <i class="fas fa-search text-sm"></i>
                        </span>
                        <input type="text" name="keyword" id="keyword"
                               placeholder="<%= __('hero.searchPlaceholder') %>"
                               class="w-full pl-10 pr-4 py-3.5 bg-white/95 border-0 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-400/50 transition-all text-sm text-gray-900 placeholder-gray-400">
                    </div>
                    <div class="sm:w-48 relative">
                        <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
                            <i class="fas fa-map-marker-alt text-sm"></i>
                        </span>
                        <select id="city-select" name="cityId"
                                class="w-full pl-10 pr-8 py-3.5 bg-white/95 border-0 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-400/50 transition-all text-sm text-gray-900 appearance-none cursor-pointer">
                            <option value=""><%= __('hero.cityPlaceholder') %></option>
                        </select>
                    </div>
                    <button type="submit"
                            class="bg-gradient-to-r from-orange-500 to-orange-600 hover:from-orange-600 hover:to-orange-700 text-white font-semibold px-8 py-3.5 rounded-xl transition-all duration-200 text-sm shadow-lg shadow-orange-500/25 hover:shadow-orange-500/40 active:scale-[0.98]">
                        <i class="fas fa-search mr-2"></i>
                        <%= __('hero.search') %>
                    </button>
                </form>
            </div>

            <!-- Trending Keywords -->
            <div class="flex flex-wrap items-center justify-center gap-2 mt-6 animate-fade-in-up" style="animation-delay: 200ms;">
                <span class="text-xs text-white/50"><%= __('hero.trending') %></span>
                <a href="/vakansiyalar?keyword=Proqramist"
                   class="px-3 py-1 bg-white/10 backdrop-blur-sm rounded-md text-xs text-white/70 hover:bg-white/20 hover:text-white transition-all border border-white/10">
                    Proqramist
                </a>
                <a href="/vakansiyalar?keyword=Design"
                   class="px-3 py-1 bg-white/10 backdrop-blur-sm rounded-md text-xs text-white/70 hover:bg-white/20 hover:text-white transition-all border border-white/10">
                    Dizayner
                </a>
                <a href="/vakansiyalar?keyword=Manager"
                   class="px-3 py-1 bg-white/10 backdrop-blur-sm rounded-md text-xs text-white/70 hover:bg-white/20 hover:text-white transition-all border border-white/10">
                    Menecer
                </a>
                <a href="/vakansiyalar?keyword=Marketinq"
                   class="px-3 py-1 bg-white/10 backdrop-blur-sm rounded-md text-xs text-white/70 hover:bg-white/20 hover:text-white transition-all border border-white/10">
                    Marketinq
                </a>
            </div>
        </div>
    </div>
</section>

<!-- ============================================ -->
<!-- STATS SECTION -->
<!-- ============================================ -->
<section class="hidden sm:block bg-white border-b border-gray-100 animate-fade-in-up" style="animation-delay: 200ms;">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-6">
            <% const stats = [
                { id: 'vacancy', value: '0', label: __('stats.vacancy') },
                { id: 'company', value: '0', label: __('stats.company') },
                { id: 'visitor', value: '0', label: __('stats.monthlyVisitors') },
                { id: 'totalVisitor', value: '0', label: __('stats.totalVisitors') },
            ]; %>
            <% stats.forEach(stat => { %>
                <div class="text-center">
                    <div class="text-xl sm:text-2xl font-bold text-primary-500" id="<%= stat.id %>"><%= stat.value %></div>
                    <div class="text-xs sm:text-sm text-gray-500 mt-0.5"><%= stat.label %></div>
                </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- ============================================ -->
<!-- CATEGORIES SECTION -->
<!-- ============================================ -->
<% if (typeof topCategories !== 'undefined' && topCategories.length > 0) { %>
<section class="py-14 sm:py-18 bg-white animate-fade-in-up" style="animation-delay: 250ms;">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-10">
            <p class="text-xs font-semibold text-primary-500 mb-1"><%= __('categories.section') %></p>
            <h2 class="text-2xl sm:text-3xl font-bold text-gray-900"><%= __('categories.title') %></h2>
            <p class="text-gray-500 text-sm sm:text-base mt-1"><%= __('categories.subtitle') %></p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
            <% topCategories.forEach(function(cat) { %>
            <a href="/vakansiyalar?categoryId=<%= cat.categoryId %>" class="bg-white border border-gray-200 rounded-lg p-4 hover:border-gray-300 hover:shadow-sm transition-all flex flex-col items-center text-center group">
                <div class="w-12 h-12 mb-3 flex items-center justify-center bg-gray-50 rounded-lg">
                    <% if (cat.logoUrl) { %>
                    <img src="<%= cat.logoUrl %>" alt="<%= cat.name %>" class="w-8 h-8 object-contain" onerror="this.onerror=null;this.style.display='none';this.parentElement.innerHTML='<i class=\\'fas fa-folder text-gray-300 text-xl\\'></i>'">
                    <% } else { %>
                    <i class="fas fa-folder text-gray-300 text-xl"></i>
                    <% } %>
                </div>
                <h3 class="text-sm font-medium text-gray-900 group-hover:text-primary-500 transition-colors line-clamp-2"><%= cat.name %></h3>
                <p class="text-xs text-gray-400 mt-1"><%= cat.count %> <%= __('categories.vacancyCount') %></p>
            </a>
            <% }); %>
        </div>
    </div>
</section>
<% } %>

<!-- ============================================ -->
<!-- RECENT JOBS SECTION -->
<!-- ============================================ -->
<section class="py-14 sm:py-18 bg-gray-50 animate-fade-in-up" style="animation-delay: 300ms;">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Section Header -->
        <div class="mb-10">
            <p class="text-xs font-semibold text-primary-500 mb-1"><%= __('recentJobs.section') %></p>
            <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">
                <%= __('recentJobs.title') %>
            </h2>
            <p class="text-gray-500 text-sm sm:text-base mt-1">
                <%= __('recentJobs.subtitle') %>
            </p>
        </div>

        <!-- Job Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3" id="home-card-section">
            <div class="col-span-full flex items-center justify-center py-16">
                <div class="flex flex-col items-center gap-2">
                    <div class="w-6 h-6 border-2 border-primary-500/30 border-t-primary-500 rounded-full animate-spin"></div>
                    <span class="text-gray-400 text-sm"><%= __('recentJobs.loading') %></span>
                </div>
            </div>
        </div>

        <!-- View All -->
        <div class="text-center mt-8">
            <a href="/vakansiyalar"
               class="inline-flex items-center gap-2 text-sm font-medium text-primary-500 hover:text-primary-600 transition-colors">
                <%= __('recentJobs.viewAll') %>
                <i class="fas fa-arrow-right text-xs"></i>
            </a>
        </div>
    </div>
</section>

<!-- ============================================ -->
<!-- HOW IT WORKS SECTION -->
<!-- ============================================ -->
<section class="py-14 sm:py-18 bg-white">
    <div class="max-w-[1200px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="mb-10">
            <p class="text-xs font-semibold text-primary-500 mb-1"><%= __('howItWorks.section') %></p>
            <h2 class="text-2xl sm:text-3xl font-bold text-gray-900">
                <%= __('howItWorks.title') %>
            </h2>
            <p class="text-gray-500 text-sm sm:text-base mt-1">
                <%= __('howItWorks.subtitle') %>
            </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <% const steps = [
                { img: '/Images/Static/WhoWeAre1.png', title: __('howItWorks.step1Title'), subtitle: __('howItWorks.step1Sub'), desc: __('howItWorks.step1Desc') },
                { img: '/Images/Static/WhoWeAre3.png', title: __('howItWorks.step2Title'), subtitle: __('howItWorks.step2Sub'), desc: __('howItWorks.step2Desc') },
                { img: '/Images/Static/WhoWeAre2.png', title: __('howItWorks.step3Title'), subtitle: __('howItWorks.step3Sub'), desc: __('howItWorks.step3Desc') },
                { img: '/Images/Static/WhoWeAre4.png', title: __('howItWorks.step4Title'), subtitle: __('howItWorks.step4Sub'), desc: __('howItWorks.step4Desc') },
            ]; %>
            <% steps.forEach((step, i) => { %>
                <div class="bg-white border border-gray-100 rounded-lg p-5 hover:border-gray-200 transition-colors">
                    <div class="flex items-center gap-2 mb-3">
                        <span class="w-6 h-6 rounded-full bg-primary-50 text-primary-500 text-xs font-bold flex items-center justify-center"><%= i + 1 %></span>
                        <span class="text-xs font-medium text-gray-400"><%= step.subtitle %></span>
                    </div>
                    <img src="<%= step.img %>" alt="<%= step.title %>" class="h-12 w-auto mb-3">
                    <h4 class="text-sm font-semibold text-gray-900 mb-1"><%= step.title %></h4>
                    <p class="text-xs text-gray-400 leading-relaxed"><%= step.desc %></p>
                </div>
            <% }); %>
        </div>
    </div>
</section>
