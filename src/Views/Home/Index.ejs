<!-- ============================================ -->
<!-- HERO SECTION -->
<!-- ============================================ -->
<section class="relative overflow-hidden pt-28 pb-16 md:pt-36 md:pb-24"
         style="background: linear-gradient(to bottom, #fff7ed 0%, #f9fafb 50%, #ffffff 100%);">
    <!-- Background Image -->
    <div class="absolute inset-0 opacity-[0.08] md:opacity-[0.06] bg-cover bg-center bg-no-repeat"
         style="background-image: url('/Images/Static/HomeFormBG.png');"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="max-w-5xl mx-auto text-center">
            <!-- Badge -->
            <div class="inline-flex items-center gap-2 bg-primary-500/10 text-primary-600 text-sm font-medium px-4 py-1.5 rounded-full mb-6">
                <span class="w-2 h-2 bg-primary-500 rounded-full animate-pulse"></span>
                Azərbaycanda 10,000+ vakansiya
            </div>

            <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-gray-900 leading-tight mb-6">
                Karyeranın yeni
                <span class="text-primary-500">səhifəsi</span>
            </h1>

            <p class="text-lg sm:text-xl text-gray-500 max-w-2xl mx-auto mb-10">
                Minlərlə iş elanı arasından sənə ən uyğun olanı tap. Yeni karyera imkanlarını kəşf et.
            </p>

            <!-- Search Form -->
            <div class="bg-white/95 backdrop-blur-sm rounded-2xl shadow-xl shadow-gray-200/60 p-4 sm:p-6">
                <form action="/vakansiyalar" method="GET" class="flex flex-col sm:flex-row gap-3 sm:gap-4">
                    <div class="flex-1 relative">
                        <span class="absolute left-5 top-1/2 -translate-y-1/2 text-gray-400">
                            <i class="fas fa-search text-lg"></i>
                        </span>
                        <input type="text" name="keyword" id="keyword"
                               placeholder="Vəzifə, şirkət və ya şəhər..."
                               class="w-full pl-14 pr-5 py-4 sm:py-5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 placeholder:text-gray-400 text-base sm:text-lg">
                    </div>
                    <div class="sm:w-56 relative">
                        <span class="absolute left-5 top-1/2 -translate-y-1/2 text-gray-400">
                            <i class="fas fa-map-marker-alt text-lg"></i>
                        </span>
                        <select id="city-select"
                                class="w-full pl-14 pr-12 py-4 sm:py-5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 appearance-none cursor-pointer text-base sm:text-lg">
                            <option value="">Bütün şəhərlər</option>
                        </select>
                        <span class="absolute right-5 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">
                            <i class="fas fa-chevron-down"></i>
                        </span>
                    </div>
                    <button type="submit"
                            class="bg-primary-500 hover:bg-primary-600 text-white font-semibold px-10 py-4 sm:py-5 rounded-xl transition-all duration-200 shadow-sm hover:shadow-md flex items-center justify-center gap-2 sm:w-auto text-base sm:text-lg">
                        <i class="fas fa-search"></i>
                        <span>Axtar</span>
                    </button>
                </form>
            </div>

            <!-- Trending Keywords -->
            <div class="flex flex-wrap items-center justify-center gap-2 mt-6 sm:mt-8 text-sm">
                <span class="text-gray-400">Populyar:</span>
                <a href="/vakansiyalar?keyword=Proqramist" class="px-3 py-1.5 bg-white border border-gray-200 rounded-full text-gray-600 hover:border-primary-500 hover:text-primary-500 hover:bg-primary-50/50 transition-all">Proqramist</a>
                <a href="/vakansiyalar?keyword=Design" class="px-3 py-1.5 bg-white border border-gray-200 rounded-full text-gray-600 hover:border-primary-500 hover:text-primary-500 hover:bg-primary-50/50 transition-all">Dizayner</a>
                <a href="/vakansiyalar?keyword=Manager" class="px-3 py-1.5 bg-white border border-gray-200 rounded-full text-gray-600 hover:border-primary-500 hover:text-primary-500 hover:bg-primary-50/50 transition-all">Menecer</a>
                <a href="/vakansiyalar?keyword=Marketinq" class="px-3 py-1.5 bg-white border border-gray-200 rounded-full text-gray-600 hover:border-primary-500 hover:text-primary-500 hover:bg-primary-50/50 transition-all">Marketinq</a>
            </div>
        </div>
    </div>
</section>

<!-- ============================================ -->
<!-- STATS SECTION -->
<!-- ============================================ -->
<section class="-mt-8 relative z-20 hidden md:block">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
        <div class="bg-white rounded-2xl shadow-lg shadow-gray-200/50 border border-gray-100 px-8 py-6 grid grid-cols-2 md:grid-cols-4 gap-6">
            <% const stats = [
                { id: 'vacancy', value: '0', label: 'Vakansiya', icon: 'fa-briefcase' },
                { id: 'company', value: '0', label: 'Şirkət', icon: 'fa-building' },
                { id: 'visitor', value: '0', label: 'Aylıq Ziyarətçi', icon: 'fa-users' },
                { id: 'totalVisitor', value: '0', label: 'Ümumi Ziyarətçi', icon: 'fa-chart-line' },
            ]; %>
            <% stats.forEach(stat => { %>
                <div class="text-center">
                    <div class="text-2xl font-bold text-primary-500" id="<%= stat.id %>"><%= stat.value %></div>
                    <div class="text-xs sm:text-sm text-gray-500 mt-1"><%= stat.label %></div>
                </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- ============================================ -->
<!-- RECENT JOBS SECTION -->
<!-- ============================================ -->
<section class="py-16 sm:py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Section Header -->
        <div class="text-center mb-12">
            <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3">
                Ən Son Vakansiyalar
            </h2>
            <p class="text-gray-500 text-lg max-w-xl mx-auto">
                Karyera arzularını reallaşdırmağa buradan başla
            </p>
        </div>

        <!-- Job Cards Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5" id="home-card-section">
            <!-- Cards loaded dynamically via JS -->
            <div class="col-span-full flex items-center justify-center py-20">
                <div class="flex flex-col items-center gap-3">
                    <div class="w-8 h-8 border-2 border-primary-500/30 border-t-primary-500 rounded-full animate-spin"></div>
                    <span class="text-gray-400 text-sm">Vakansiyalar yüklənir...</span>
                </div>
            </div>
        </div>

        <!-- View All Button -->
        <div class="text-center mt-12">
            <a href="/vakansiyalar"
               class="inline-flex items-center gap-2 bg-white hover:bg-gray-50 text-gray-700 font-medium px-8 py-3.5 rounded-xl border border-gray-200 transition-all duration-200 shadow-sm hover:shadow-md">
                Bütün Vakansiyalar
                <i class="fas fa-arrow-right text-sm"></i>
            </a>
        </div>
    </div>
</section>

<!-- ============================================ -->
<!-- HOW IT WORKS SECTION -->
<!-- ============================================ -->
<section class="py-16 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14">
            <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3">
                Platforma necə işləyir?
            </h2>
            <p class="text-gray-500 text-lg max-w-xl mx-auto">
                Bütün iş imkanları üçün tək ünvan
            </p>
        </div>

        <!-- Mobile: horizontal scroll, Desktop: grid -->
        <div class="flex md:grid md:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8 overflow-x-auto snap-x snap-mandatory scrollbar-hide pb-4 md:pb-0 -mx-4 sm:-mx-6 md:mx-0 px-4 sm:px-6 md:px-0"
             style="-webkit-overflow-scrolling: touch; scroll-snap-type: x mandatory;">
            <% const steps = [
                { img: '/Images/Static/WhoWeAre1.png', title: 'Hesab yaratmadan', subtitle: 'axtarış et' },
                { img: '/Images/Static/WhoWeAre3.png', title: 'Bütün iş elanlarını', subtitle: 'kəşf et' },
                { img: '/Images/Static/WhoWeAre2.png', title: 'Ən uyğun olanı', subtitle: 'tap' },
                { img: '/Images/Static/WhoWeAre4.png', title: 'İş elanına', subtitle: 'keçid et' },
            ]; %>
            <% steps.forEach((step, i) => { %>
                <div class="text-center group min-w-[220px] md:min-w-0 snap-start">
                    <!-- Step Number -->
                    <div class="w-12 h-12 rounded-full bg-primary-50 text-primary-500 font-bold text-lg flex items-center justify-center mx-auto mb-6 group-hover:bg-primary-500 group-hover:text-white transition-all duration-300">
                        <%= i + 1 %>
                    </div>
                    <!-- Icon -->
                    <div class="w-28 h-28 mx-auto mb-5 flex items-center justify-center">
                        <img src="<%= step.img %>" alt="<%= step.title %>"
                             class="h-24 w-auto transition-transform duration-300 group-hover:scale-110">
                    </div>
                    <h4 class="text-lg font-semibold text-gray-900"><%= step.title %></h4>
                    <p class="text-gray-500"><%= step.subtitle %></p>
                </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- ============================================ -->
<!-- CTA SECTION -->
<!-- ============================================ -->
<section class="py-16 sm:py-20 bg-gray-50">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="bg-white rounded-2xl shadow-lg shadow-gray-200/50 border border-gray-100 p-8 sm:p-12 lg:p-16">
            <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-4">
                İşəgötürənsən?
            </h2>
            <p class="text-gray-500 text-lg mb-8 max-w-lg mx-auto">
                Vakansiyanızı paylaşın, ən uyğun namizədlər sizi tapsın
            </p>
            <a href="/add-job"
               class="inline-flex items-center gap-2 bg-primary-500 hover:bg-primary-600 text-white font-medium px-8 py-3.5 rounded-xl transition-all duration-200 shadow-sm hover:shadow-md">
                <i class="fas fa-plus-circle"></i>
                Elan Yerləşdir
            </a>
        </div>
    </div>
</section>
