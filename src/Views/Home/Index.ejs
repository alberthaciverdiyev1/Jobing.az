<!-- ============================================ -->
<!-- HERO — 4:3 Split Layout with Illustration -->
<!-- ============================================ -->
<section class="bg-gradient-to-b from-orange-50/30 via-white to-white pt-20 md:pt-28 pb-0 overflow-hidden">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col lg:flex-row items-center gap-10 lg:gap-0">

            <!-- Left Content — 4/7 width -->
            <div class="w-full lg:w-[57.14%] lg:pr-12 xl:pr-16">
                <div class="max-w-[600px] mx-auto lg:mx-0">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-primary-50 text-primary-600 text-xs font-medium mb-6">
                        <span class="w-1.5 h-1.5 rounded-full bg-primary-500"></span>
                        <%= __('hero.badge') || '2500+ aktiv vakansiya' %>
                    </span>

                    <h1 class="text-[2.5rem] sm:text-[3.2rem] lg:text-[3.8rem] font-bold text-gray-900 leading-[1.08] tracking-[-0.03em] mb-5">
                        <%= __('hero.title') %>
                        <span class="text-primary-500 block sm:inline"><%= __('hero.titleHighlight') %></span>
                    </h1>

                    <p class="text-lg sm:text-xl text-gray-500 leading-relaxed mb-8 max-w-[520px]">
                        <%= __('hero.subtitle') %>
                    </p>

                    <!-- Search Card -->
                    <div class="bg-white rounded-2xl border border-gray-200/60 shadow-lg shadow-gray-200/30 p-1.5 mb-5">
                        <form action="/vakansiyalar" method="GET" class="flex flex-col sm:flex-row gap-1.5" id="home-search-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <div class="flex-1 relative">
                                <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-gray-300 text-sm"></i>
                                <label for="keyword" class="sr-only"><%= __('hero.searchPlaceholder') %></label>
                                <input type="text" name="keyword" id="keyword"
                                       placeholder="<%= __('hero.searchPlaceholder') %>"
                                       class="w-full pl-10 pr-4 py-3.5 bg-transparent border-0 focus:outline-none text-sm placeholder:text-gray-300 rounded-xl">
                            </div>
                            <div class="sm:w-44 relative">
                                <i class="fas fa-chevron-down absolute right-4 top-1/2 -translate-y-1/2 text-gray-300 text-[10px] pointer-events-none"></i>
                                <label for="city-select" class="sr-only"><%= __('hero.cityPlaceholder') %></label>
                                <select id="city-select" name="cityId"
                                        class="w-full pl-10 pr-8 py-3.5 bg-gray-50 border border-gray-200 focus:border-primary-300 focus:ring-2 focus:ring-primary-500/10 text-sm appearance-none cursor-pointer text-gray-500 hover:border-gray-300 hover:bg-gray-100/50 transition-all rounded-xl outline-none">
                                    <option value="" class="text-gray-400"><%= __('hero.cityPlaceholder') %></option>
                                </select>
                            </div>
                            <button type="submit" id="home-search-btn"
                                    class="bg-primary-500 hover:bg-primary-600 text-white font-semibold px-8 py-3.5 rounded-xl transition-all duration-200 text-sm whitespace-nowrap shadow-sm shadow-primary-500/20 hover:shadow-md hover:shadow-primary-500/30 hover:scale-[1.02] active:scale-[0.98]"
                                    aria-label="<%= __('hero.search') %>">
                                <i class="fas fa-arrow-right mr-1.5"></i>
                                <%= __('hero.search') %>
                            </button>
                        </form>
                    </div>

                    <!-- Trending -->
                    <div class="hidden sm:block flex flex-wrap items-center gap-2">
                        <span class="text-[11px] text-gray-300 font-semibold tracking-wider uppercase"><%= __('hero.trending') %></span>
                        <% ['Proqramist', 'Dizayner', 'Menecer', 'Marketinq', 'Satış'].forEach(function(tag) { %>
                            <a href="/vakansiyalar?keyword=<%= tag %>"
                               class="px-3 py-1.5 text-[13px] text-gray-400 hover:text-gray-900 hover:bg-gray-100 rounded-lg transition-all"><%= tag %></a>
                        <% }); %>
                    </div>
                </div>
            </div>

            <!-- Right Illustration — 3/7 width (hidden on mobile) -->
            <div class="hidden lg:block w-full lg:w-[42.86%] flex-shrink-0">
                <div class="relative max-w-[520px] mx-auto">
                    <!-- Main illustration SVG -->
                    <svg viewBox="0 0 520 480" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full h-auto hero-illustration" role="img" aria-label="<%= __('hero.illustrationAlt') || 'Jobing.az - iş axtarışı platforması illustrasiyası' %>">
                        <!-- Background circle -->
                        <circle cx="260" cy="240" r="200" fill="#FFF7ED" opacity="0.5"/>
                        <circle cx="260" cy="240" r="145" fill="#FFEDD5" opacity="0.4"/>

                        <!-- Decorative dots -->
                        <circle cx="80" cy="100" r="6" fill="#FFEDD5"/>
                        <circle cx="440" cy="80" r="4" fill="#FFEDD5"/>
                        <circle cx="460" cy="380" r="5" fill="#FFEDD5"/>
                        <circle cx="60" cy="360" r="3" fill="#FFEDD5"/>

                        <!-- Laptop/desk surface -->
                        <rect x="115" y="310" width="290" height="8" rx="4" fill="#E5E7EB"/>
                        <rect x="100" y="318" width="320" height="12" rx="6" fill="#D1D5DB"/>

                        <!-- Monitor -->
                        <rect x="160" y="178" width="200" height="130" rx="10" fill="#1F2937"/>
                        <rect x="168" y="186" width="184" height="102" rx="6" fill="#F9FAFB"/>

                        <!-- Monitor content: graph bars -->
                        <rect x="185" y="240" width="18" height="40" rx="3" fill="#FF8C00" opacity="0.3"/>
                        <rect x="210" y="220" width="18" height="60" rx="3" fill="#FF8C00" opacity="0.5"/>
                        <rect x="235" y="250" width="18" height="30" rx="3" fill="#FF8C00" opacity="0.3"/>
                        <rect x="260" y="200" width="18" height="80" rx="3" fill="#FF8C00"/>
                        <rect x="285" y="230" width="18" height="50" rx="3" fill="#FF8C00" opacity="0.6"/>
                        <rect x="310" y="245" width="18" height="35" rx="3" fill="#FF8C00" opacity="0.4"/>

                        <!-- Monitor stand -->
                        <rect x="247" y="308" width="14" height="18" rx="2" fill="#9CA3AF"/>
                        <rect x="228" y="326" width="52" height="4" rx="2" fill="#9CA3AF"/>

                        <!-- Person (sitting, side view) -->
                        <!-- Body -->
                        <path d="M340 280 C340 240, 360 195, 395 195 C430 195, 445 240, 445 280" fill="#F3F4F6"/>
                        <!-- Head -->
                        <circle cx="395" cy="172" r="28" fill="#F3F4F6"/>
                        <!-- Hair -->
                        <path d="M370 158 C375 140, 415 140, 420 158" fill="#374151"/>
                        <!-- Arm reaching toward laptop -->
                        <path d="M345 235 C345 235, 290 260, 290 290" stroke="#F3F4F6" stroke-width="16"
                              stroke-linecap="round"/>
                        <path d="M345 235 C345 235, 290 260, 290 290" stroke="#E5E7EB" stroke-width="16"
                              stroke-linecap="round" opacity="0.3"/>

                        <!-- Floating elements -->
                        <!-- Briefcase -->
                        <g transform="translate(380, 120)">
                            <rect x="0" y="8" width="32" height="24" rx="4" fill="#FF8C00"/>
                            <rect x="8" y="0" width="16" height="10" rx="2" fill="none" stroke="#FF8C00"
                                  stroke-width="2"/>
                            <rect x="8" y="8" width="16" height="4" rx="1" fill="#CC7000" opacity="0.3"/>
                            <circle cx="16" cy="20" r="3" fill="#CC7000" opacity="0.3"/>
                        </g>

                        <!-- Document with checklist -->
                        <g transform="translate(130, 100)">
                            <rect x="0" y="0" width="28" height="36" rx="3" fill="white" stroke="#D1D5DB"
                                  stroke-width="1.5"/>
                            <rect x="10" y="6" width="12" height="2" rx="1" fill="#FF8C00"/>
                            <rect x="6" y="12" width="16" height="1.5" rx="0.75" fill="#E5E7EB"/>
                            <rect x="6" y="17" width="16" height="1.5" rx="0.75" fill="#E5E7EB"/>
                            <rect x="6" y="22" width="16" height="1.5" rx="0.75" fill="#E5E7EB"/>
                            <!-- Checkmark circle -->
                            <circle cx="8" cy="30" r="5" fill="#10B981"/>
                            <path d="M5.5 30L7 31.5L10.5 28" stroke="white" stroke-width="1.5" stroke-linecap="round"
                                  stroke-linejoin="round"/>
                        </g>

                        <!-- Cup of coffee -->
                        <g transform="translate(140, 340)">
                            <rect x="0" y="4" width="20" height="18" rx="3" fill="white" stroke="#D1D5DB"
                                  stroke-width="1.5"/>
                            <rect x="20" y="8" width="6" height="10" rx="2" fill="none" stroke="#D1D5DB"
                                  stroke-width="1.5"/>
                            <path d="M4 10 Q10 12 16 10" stroke="#D1D5DB" stroke-width="1" fill="none"/>
                        </g>

                        <!-- Sparkle/star decorations -->
                        <path d="M470 170 L474 162 L478 170 L470 170Z" fill="#FF8C00" opacity="0.6"/>
                        <path d="M55 170 L58 164 L61 170 L55 170Z" fill="#FF8C00" opacity="0.4"/>
                        <path d="M350 90 L353 84 L356 90 L350 90Z" fill="#FF8C00" opacity="0.3"/>

                        <!-- Connection lines (decoration) -->
                        <path d="M180 176 C220 160, 250 160, 290 176" stroke="#FFEDD5" stroke-width="2" fill="none"/>

                        <!-- Avatar circle suggestion -->
                        <circle cx="395" cy="172" r="24" fill="none" stroke="#E5E7EB" stroke-width="1"/>

                        <!-- Waiting/search overlay on screen -->
                        <rect x="300" y="195" width="22" height="14" rx="7" fill="#FF8C00" opacity="0.15"/>
                        <text x="304" y="207" font-size="7" fill="#CC7000" font-family="sans-serif" font-weight="bold">
                            HR
                        </text>
                    </svg>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ============================================ -->
<!-- STATS — Modern Elevated Cards -->
<!-- ============================================ -->
<section class="hidden sm:block bg-gray-50 border-y border-gray-100">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-3">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
            <% const statCards = [
                {
                    id: 'vacancy',
                    icon: 'fa-briefcase',
                    color: 'from-primary-500 to-amber-500',
                    label: __('stats.vacancy'),
                    bg: 'from-orange-50 to-amber-50'
                },
                {
                    id: 'company',
                    icon: 'fa-building',
                    color: 'from-blue-500 to-indigo-500',
                    label: __('stats.company'),
                    bg: 'from-blue-50 to-indigo-50'
                },
                {
                    id: 'visitor',
                    icon: 'fa-eye',
                    color: 'from-emerald-500 to-teal-500',
                    label: __('stats.monthlyVisitors'),
                    bg: 'from-emerald-50 to-teal-50'
                },
                {
                    id: 'totalVisitor',
                    icon: 'fa-users',
                    color: 'from-violet-500 to-purple-500',
                    label: __('stats.totalVisitors'),
                    bg: 'from-violet-50 to-purple-50'
                },
            ]; %>
            <% statCards.forEach(function(s) { %>
                <div class="group bg-white rounded-2xl p-5 border border-gray-200 hover:border-gray-300 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300">
                    <div class="flex items-center gap-4">
                        <div class="w-11 h-11 flex-shrink-0 rounded-xl bg-gradient-to-br <%= s.bg %> flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                            <i class="fas <%= s.icon %> text-base bg-gradient-to-br <%= s.color %> bg-clip-text text-transparent"></i>
                        </div>
                        <div>
                            <div class="text-2xl font-bold text-gray-900" id="<%= s.id %>">0</div>
                            <div class="text-xs text-gray-400 mt-0.5 group-hover:text-gray-500 transition-colors"><%= s.label %></div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>
</section>

<!-- ============================================ -->
<!-- POPULAR CATEGORIES — Premium Glass Cards -->
<!-- ============================================ -->
<% if (typeof topCategories !== 'undefined' && topCategories.length > 0) { %>
    <section class="py-16 md:py-24 bg-gradient-to-b from-gray-50/50 via-white to-white relative overflow-hidden">
        <!-- Subtle background decoration -->
        <div class="absolute inset-0 pointer-events-none">
            <div class="absolute top-0 left-1/4 w-96 h-96 bg-primary-500/5 rounded-full blur-3xl"></div>
            <div class="absolute bottom-0 right-1/4 w-80 h-80 bg-amber-500/5 rounded-full blur-3xl"></div>
        </div>

        <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 relative">
            <!-- Section Header -->
            <div class="text-center md:text-left md:flex md:items-end md:justify-between mb-10 md:mb-14">
                <div>
                    <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-primary-50 text-primary-600 text-xs font-semibold uppercase tracking-[0.12em]">
                        <span class="w-1.5 h-1.5 rounded-full bg-primary-500 animate-pulse-subtle"></span>
                        <%= __('categories.section') %>
                    </span>
                    <h2 class="text-[1.75rem] sm:text-[2.25rem] lg:text-[2.5rem] font-bold text-gray-900 tracking-[-0.02em] mt-4 leading-tight">
                        <%= __('categories.title') %>
                    </h2>
                    <p class="text-gray-400 text-base mt-2 max-w-xl mx-auto md:mx-0"><%= __('categories.subtitle') %></p>
                </div>
                <a href="/vakansiyalar"
                   class="hidden md:inline-flex items-center gap-2.5 text-sm font-semibold text-primary-500 hover:text-primary-600 transition-all duration-300 group flex-shrink-0">
                    <span class="border-b-2 border-primary-500/30 group-hover:border-primary-500 transition-colors pb-0.5"><%= __('recentJobs.viewAll') %></span>
                    <i class="fas fa-arrow-right text-xs group-hover:translate-x-1.5 transition-transform duration-300"></i>
                </a>
            </div>

            <!-- Color themes -->
            <% const categoryThemes = [
                { gradient: 'from-orange-500 to-amber-500', glow: 'shadow-orange-500/20 hover:shadow-orange-500/30', iconBg: 'from-orange-50 to-amber-50', border: 'hover:border-orange-200' },
                { gradient: 'from-blue-500 to-indigo-500', glow: 'shadow-blue-500/20 hover:shadow-blue-500/30', iconBg: 'from-blue-50 to-indigo-50', border: 'hover:border-blue-200' },
                { gradient: 'from-emerald-500 to-teal-500', glow: 'shadow-emerald-500/20 hover:shadow-emerald-500/30', iconBg: 'from-emerald-50 to-teal-50', border: 'hover:border-emerald-200' },
                { gradient: 'from-violet-500 to-purple-500', glow: 'shadow-purple-500/20 hover:shadow-purple-500/30', iconBg: 'from-purple-50 to-pink-50', border: 'hover:border-purple-200' },
                { gradient: 'from-rose-500 to-pink-500', glow: 'shadow-rose-500/20 hover:shadow-rose-500/30', iconBg: 'from-rose-50 to-red-50', border: 'hover:border-rose-200' },
                { gradient: 'from-cyan-500 to-sky-500', glow: 'shadow-cyan-500/20 hover:shadow-cyan-500/30', iconBg: 'from-cyan-50 to-sky-50', border: 'hover:border-cyan-200' },
                { gradient: 'from-amber-500 to-yellow-500', glow: 'shadow-amber-500/20 hover:shadow-amber-500/30', iconBg: 'from-amber-50 to-yellow-50', border: 'hover:border-amber-200' },
                { gradient: 'from-pink-500 to-fuchsia-500', glow: 'shadow-pink-500/20 hover:shadow-pink-500/30', iconBg: 'from-pink-50 to-fuchsia-50', border: 'hover:border-pink-200' },
            ]; %>

            <!-- Cards: 7 categories grid -->
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-7 gap-3 md:gap-4">
                <% topCategories.slice(0, 8).forEach(function(cat, idx) {
                    const t = categoryThemes[idx % categoryThemes.length];
                    const catCount = cat.count || 0;
                %>
                    <a href="/vakansiyalar?categoryId=<%= cat.categoryId %>"
                       class="group relative bg-white rounded-2xl p-4 md:p-5 border border-gray-200 hover:border-gray-300 <%= t.border %> hover:shadow-xl <%= t.glow %> hover:-translate-y-1.5 all transition-all duration-300">
                        <!-- Top gradient bar -->
                        <div class="absolute top-0 left-5 right-5 h-1 bg-gradient-to-r <%= t.gradient %> rounded-b-md opacity-0 group-hover:opacity-100 transition-all duration-300 scale-x-0 group-hover:scale-x-100 origin-left"></div>

                        <div class="flex flex-col items-center md:items-start text-center md:text-left">
                            <!-- Icon with gradient + arrow indicator -->
                            <div class="w-12 h-12 md:w-14 md:h-14 flex items-center justify-center rounded-2xl bg-gradient-to-br <%= t.iconBg %> mb-3 md:mb-4 group-hover:shadow-lg group-hover:scale-105 transition-all duration-300 relative overflow-visible">
                                <div class="absolute inset-0 bg-gradient-to-br <%= t.gradient %> opacity-0 group-hover:opacity-10 transition-opacity duration-300 rounded-2xl"></div>
                                <i class="fas <%= cat.icon || 'fa-folder' %> text-xl md:text-2xl bg-gradient-to-br <%= t.gradient %> bg-clip-text text-transparent group-hover:scale-110 transition-all duration-300"></i>
                                <!-- Hover arrow (iconun yaninda) -->
                                <div class="absolute -right-2 -bottom-1 w-5 h-5 md:w-6 md:h-6 rounded-full bg-gradient-to-br <%= t.gradient %> flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 scale-50 group-hover:scale-100 shadow-md shadow-black/10">
                                    <i class="fas fa-arrow-right text-[7px] md:text-[8px] text-white"></i>
                                </div>
                            </div>

                            <!-- Category name -->
                            <h3 class="text-[13px] md:text-[15px] font-bold text-gray-900 leading-snug mb-2"><%= cat.name %></h3>

                            <!-- Job count badge -->
                            <div class="inline-flex items-center gap-1.5 px-2.5 md:px-3 py-1 rounded-full bg-gray-100 text-gray-500 text-[11px] md:text-xs font-medium group-hover:bg-gradient-to-r <%- t.gradient.replace(/(from-|to-)/g, 'group-hover:$1') %> group-hover:text-gray-900 transition-all duration-300">
                                <i class="fas fa-briefcase text-[9px] md:text-[10px]"></i>
                                <span><%= catCount %><span class="hidden sm:inline"> vakansiya</span></span>
                            </div>
                        </div>
                    </a>
                <% }); %>
            </div>

            <!-- Mobile view all link -->
            <div class="md:hidden text-center mt-8">
                <a href="/vakansiyalar"
                   class="inline-flex items-center gap-2 text-sm font-semibold text-primary-500 hover:text-primary-600 transition-colors">
                    <%= __('recentJobs.viewAll') %>
                    <i class="fas fa-arrow-right text-xs"></i>
                </a>
            </div>
        </div>
    </section>
<% } %>

<!-- ============================================ -->
<!-- RECENT JOBS -->
<!-- ============================================ -->
<section class="bg-gray-50">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-14">
            <h2 class="text-[1.75rem] sm:text-[2.25rem] font-bold text-gray-900 tracking-[-0.015em]">
                <%= __('recentJobs.title') %>
            </h2>
            <p class="text-gray-400 text-base mt-2">
                <%= __('recentJobs.subtitle') %>
            </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5" id="home-card-section">
            <div class="col-span-full flex items-center justify-center py-24">
                <div class="flex flex-col items-center gap-3">
                    <div class="w-6 h-6 border-2 border-gray-200 border-t-gray-900 rounded-full animate-spin"></div>
                    <span class="text-sm text-gray-400"><%= __('recentJobs.loading') %></span>
                </div>
            </div>
        </div>

        <div class="text-center mt-12">
            <a href="/vakansiyalar"
               class="group inline-flex items-center gap-2 text-sm font-medium text-primary-500 hover:text-primary-600 transition-all duration-300">
                <%= __('recentJobs.viewAll') %> <i
                        class="fas fa-arrow-right text-xs group-hover:translate-x-1 transition-transform duration-300"></i>
            </a>
        </div>
    </div>
</section>
