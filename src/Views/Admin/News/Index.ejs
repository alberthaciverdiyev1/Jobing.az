<div class="p-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">News Management</h1>
    <a href="/admin/news/add" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm font-medium">+ Add News</a>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left text-gray-500">
        <thead class="text-xs text-gray-700 uppercase bg-gray-50">
          <tr>
            <th class="px-5 py-3">Title</th>
            <th class="px-5 py-3">Category</th>
            <th class="px-5 py-3">Views</th>
            <th class="px-5 py-3">Status</th>
            <th class="px-5 py-3">Date</th>
            <th class="px-5 py-3">Actions</th>
          </tr>
        </thead>
        <tbody id="newsTableBody">
          <tr>
            <td colspan="6" class="px-5 py-8 text-center text-gray-400">Loading...</td>
          </tr>
        </tbody>
      </table>
    </div>
    <div id="newsPagination"></div>
  </div>
</div>

<!-- Delete Confirm Modal -->
<div id="deleteModal" class="fixed inset-0 z-50 hidden overflow-y-auto">
  <div class="flex items-center justify-center min-h-screen px-4">
    <div class="fixed inset-0 bg-black opacity-50"></div>
    <div class="relative bg-white rounded-lg shadow-xl max-w-md w-full p-6">
      <h3 class="text-lg font-semibold text-gray-900 mb-2">Confirm Delete</h3>
      <p class="text-sm text-gray-500 mb-4">Are you sure you want to delete this news article? This action cannot be undone.</p>
      <div class="flex justify-end gap-3">
        <button onclick="closeDeleteModal()" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 text-sm">Cancel</button>
        <button id="confirmDeleteBtn" class="px-4 py-2 bg-red-600 text-white rounded-lg hover:bg-red-700 text-sm">Delete</button>
      </div>
    </div>
  </div>
</div>
