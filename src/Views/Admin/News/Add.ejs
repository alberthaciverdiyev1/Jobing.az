<div class="p-6">
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-gray-800">Add New News</h1>
      <a href="/admin/news" class="text-sm text-indigo-600 hover:text-indigo-800 font-medium">&larr; Back to News</a>
    </div>

    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
      <!-- Language Tabs -->
      <div class="border-b border-gray-200">
        <div class="flex" id="addLangTabs">
          <button type="button" onclick="switchAddLang('az')" class="add-lang-tab px-6 py-3 text-sm font-medium border-b-2 border-indigo-600 text-indigo-600" data-lang="az">AZ</button>
          <button type="button" onclick="switchAddLang('en')" class="add-lang-tab px-6 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700" data-lang="en">EN</button>
          <button type="button" onclick="switchAddLang('ru')" class="add-lang-tab px-6 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700" data-lang="ru">RU</button>
        </div>
      </div>

      <form id="addNewsForm" class="p-6 space-y-6">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <!-- AZ Tab -->
        <div class="add-lang-content" data-lang="az">
          <div>
            <label for="addTitle" class="block text-sm font-medium text-gray-700 mb-1">Title *</label>
            <input type="text" id="addTitle" required
                   class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-indigo-500 focus:border-indigo-500">
          </div>
          <div class="mt-4">
            <label for="addDescription" class="block text-sm font-medium text-gray-700 mb-1">Description (short summary)</label>
            <textarea id="addDescription" rows="3"
                      class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-indigo-500 focus:border-indigo-500"></textarea>
          </div>
          <div class="mt-4">
            <label for="addContent" class="block text-sm font-medium text-gray-700 mb-1">Content</label>
            <textarea id="addContent" rows="12"
                      class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-indigo-500 focus:border-indigo-500"></textarea>
          </div>
        </div>

        <!-- EN Tab -->
        <div class="add-lang-content hidden" data-lang="en">
          <div>
            <label for="addTitleEn" class="block text-sm font-medium text-gray-700 mb-1">Title (EN)</label>
            <input type="text" id="addTitleEn"
                   class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-indigo-500 focus:border-indigo-500">
          </div>
          <div class="mt-4">
            <label for="addDescriptionEn" class="block text-sm font-medium text-gray-700 mb-1">Description (EN)</label>
            <textarea id="addDescriptionEn" rows="3"
                      class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-indigo-500 focus:border-indigo-500"></textarea>
          </div>
          <div class="mt-4">
            <label for="addContentEn" class="block text-sm font-medium text-gray-700 mb-1">Content (EN)</label>
            <textarea id="addContentEn" rows="12"
                      class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-indigo-500 focus:border-indigo-500"></textarea>
          </div>
        </div>

        <!-- RU Tab -->
        <div class="add-lang-content hidden" data-lang="ru">
          <div>
            <label for="addTitleRu" class="block text-sm font-medium text-gray-700 mb-1">Title (RU)</label>
            <input type="text" id="addTitleRu"
                   class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-indigo-500 focus:border-indigo-500">
          </div>
          <div class="mt-4">
            <label for="addDescriptionRu" class="block text-sm font-medium text-gray-700 mb-1">Description (RU)</label>
            <textarea id="addDescriptionRu" rows="3"
                      class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-indigo-500 focus:border-indigo-500"></textarea>
          </div>
          <div class="mt-4">
            <label for="addContentRu" class="block text-sm font-medium text-gray-700 mb-1">Content (RU)</label>
            <textarea id="addContentRu" rows="12"
                      class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-indigo-500 focus:border-indigo-500"></textarea>
          </div>
        </div>

        <!-- Common fields -->
        <div class="border-t border-gray-200 pt-6 space-y-6">
          <div>
            <label for="addSlug" class="block text-sm font-medium text-gray-700 mb-1">Slug</label>
            <input type="text" id="addSlug"
                   class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-indigo-500 focus:border-indigo-500"
                   placeholder="Leave empty to auto-generate">
          </div>
          <div>
            <label for="addCategory" class="block text-sm font-medium text-gray-700 mb-1">Category</label>
            <input type="text" id="addCategory" placeholder="e.g. Technology, Business, etc."
                   class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-indigo-500 focus:border-indigo-500">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Image</label>
            <div class="flex items-start gap-4">
              <div class="flex-1">
                <input type="url" id="addImageUrl" placeholder="Image URL..."
                       class="w-full px-4 py-2 border border-gray-300 rounded-lg text-sm focus:ring-indigo-500 focus:border-indigo-500 mb-2">
                <div class="flex items-center gap-3">
                  <input type="file" id="addImageFile" accept="image/*"
                         class="block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-indigo-50 file:text-indigo-700 hover:file:bg-indigo-100">
                  <span class="px-3 py-2 bg-gray-100 text-gray-400 rounded-lg text-sm">Saxlandıqda yüklənəcək</span>
                </div>
              </div>
              <div id="addImagePreview" class="hidden w-32 h-24 rounded-lg overflow-hidden border border-gray-200 flex-shrink-0">
                <img id="addImagePreviewImg" class="w-full h-full object-cover" alt="Preview">
              </div>
            </div>
          </div>
          <div class="flex items-center gap-3">
            <input type="checkbox" id="addIsActive" checked class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
            <label for="addIsActive" class="text-sm text-gray-700">Active</label>
          </div>
          <div class="flex justify-end gap-3 pt-2">
            <a href="/admin/news" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 text-sm">Cancel</a>
            <button type="submit" class="px-6 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm font-medium">Save</button>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
function switchAddLang(lang) {
  document.querySelectorAll('.add-lang-tab').forEach(function(t) {
    t.classList.remove('border-indigo-600', 'text-indigo-600');
    t.classList.add('border-transparent', 'text-gray-500');
  });
  var tab = document.querySelector('.add-lang-tab[data-lang="' + lang + '"]');
  if (tab) tab.classList.add('border-indigo-600', 'text-indigo-600');

  document.querySelectorAll('.add-lang-content').forEach(function(el) {
    el.classList.toggle('hidden', el.dataset.lang !== lang);
  });
}
</script>
