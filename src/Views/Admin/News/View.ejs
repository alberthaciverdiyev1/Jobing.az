<div class="p-6">
  <div class="max-w-4xl mx-auto">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-2xl font-bold text-gray-800">View News</h1>
      <div class="flex gap-2">
        <a href="/admin/news/edit/<%= news._id %>" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm font-medium">Edit</a>
        <a href="/admin/news" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 text-sm font-medium">&larr; Back</a>
      </div>
    </div>

    <!-- Language Tabs -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden mb-6">
      <div class="border-b border-gray-200">
        <div class="flex" id="viewLangTabs">
          <button onclick="switchViewLang('az')" class="view-lang-tab px-6 py-3 text-sm font-medium border-b-2 border-indigo-600 text-indigo-600" data-lang="az">AZ</button>
          <button onclick="switchViewLang('en')" class="view-lang-tab px-6 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700" data-lang="en">EN</button>
          <button onclick="switchViewLang('ru')" class="view-lang-tab px-6 py-3 text-sm font-medium border-b-2 border-transparent text-gray-500 hover:text-gray-700" data-lang="ru">RU</button>
        </div>
      </div>

      <div class="p-6">
        <!-- Image -->
        <% if (news.imageUrl) { %>
          <div class="mb-6 rounded-lg overflow-hidden border border-gray-200 max-h-80">
            <img src="<%= news.imageUrl %>" alt="<%= news.title %>" class="w-full h-64 object-cover">
          </div>
        <% } %>

        <!-- Title (locale-aware) -->
        <div class="view-lang-content" data-lang="az">
          <h2 class="text-2xl font-bold text-gray-900 mb-2"><%= news.title || '-' %></h2>
        </div>
        <div class="view-lang-content hidden" data-lang="en">
          <h2 class="text-2xl font-bold text-gray-900 mb-2"><%= news.title_en || news.title || '-' %></h2>
        </div>
        <div class="view-lang-content hidden" data-lang="ru">
          <h2 class="text-2xl font-bold text-gray-900 mb-2"><%= news.title_ru || news.title || '-' %></h2>
        </div>

        <!-- Meta -->
        <div class="flex flex-wrap items-center gap-3 text-sm text-gray-500 mb-6">
          <span class="px-2.5 py-0.5 rounded-md text-xs font-medium bg-indigo-50 text-indigo-600 border border-indigo-100"><%= news.category || 'Uncategorized' %></span>
          <span><i class="far fa-calendar mr-1"></i><%= new Date(news.createdAt).toLocaleDateString('az-AZ') %></span>
          <span><i class="far fa-eye mr-1"></i><%= news.views || 0 %> views</span>
          <span class="<%= news.isActive ? 'text-green-600' : 'text-amber-600' %>">
            <i class="fas fa-circle text-[8px] mr-1"></i><%= news.isActive ? 'Active' : 'Inactive' %>
          </span>
        </div>

        <!-- Description (locale-aware) -->
        <div class="view-lang-content" data-lang="az">
          <h3 class="text-sm font-semibold text-gray-700 mb-2">Description (AZ)</h3>
          <p class="text-gray-600 text-sm mb-6 leading-relaxed"><%= news.description || '-' %></p>
        </div>
        <div class="view-lang-content hidden" data-lang="en">
          <h3 class="text-sm font-semibold text-gray-700 mb-2">Description (EN)</h3>
          <p class="text-gray-600 text-sm mb-6 leading-relaxed"><%= news.description_en || news.description || '-' %></p>
        </div>
        <div class="view-lang-content hidden" data-lang="ru">
          <h3 class="text-sm font-semibold text-gray-700 mb-2">Description (RU)</h3>
          <p class="text-gray-600 text-sm mb-6 leading-relaxed"><%= news.description_ru || news.description || '-' %></p>
        </div>

        <!-- Content (locale-aware) -->
        <div class="view-lang-content" data-lang="az">
          <h3 class="text-sm font-semibold text-gray-700 mb-2">Content (AZ)</h3>
          <div class="prose prose-sm max-w-none text-gray-700 border rounded-lg p-4 bg-gray-50">
            <%- news.content || '-' %>
          </div>
        </div>
        <div class="view-lang-content hidden" data-lang="en">
          <h3 class="text-sm font-semibold text-gray-700 mb-2">Content (EN)</h3>
          <div class="prose prose-sm max-w-none text-gray-700 border rounded-lg p-4 bg-gray-50">
            <%- news.content_en || news.content || '-' %>
          </div>
        </div>
        <div class="view-lang-content hidden" data-lang="ru">
          <h3 class="text-sm font-semibold text-gray-700 mb-2">Content (RU)</h3>
          <div class="prose prose-sm max-w-none text-gray-700 border rounded-lg p-4 bg-gray-50">
            <%- news.content_ru || news.content || '-' %>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
function switchViewLang(lang) {
  document.querySelectorAll('.view-lang-tab').forEach(t => {
    t.classList.remove('border-indigo-600', 'text-indigo-600');
    t.classList.add('border-transparent', 'text-gray-500');
  });
  document.querySelector('.view-lang-tab[data-lang="' + lang + '"]').classList.add('border-indigo-600', 'text-indigo-600');
  document.querySelectorAll('.view-lang-content').forEach(el => {
    el.classList.toggle('hidden', el.dataset.lang !== lang);
  });
}
</script>
