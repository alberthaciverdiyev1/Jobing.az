<div class="space-y-4">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold text-gray-800">RSS Mənbələri</h1>
    <div class="flex gap-2">
      <button onclick="importAllSources()" class="px-4 py-2 bg-emerald-500 text-white rounded-lg hover:bg-emerald-600 text-sm font-medium">Hamısını İdxal Et</button>
      <button onclick="showAddModal()" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm font-medium">+ Mənbə Əlavə Et</button>
    </div>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left text-gray-500">
        <thead class="text-xs text-gray-700 uppercase bg-gray-50">
          <tr>
            <th class="px-5 py-3">Ad</th>
            <th class="px-5 py-3">URL</th>
            <th class="px-5 py-3">Kateqoriya</th>
            <th class="px-5 py-3">Son İdxal</th>
            <th class="px-5 py-3">Status</th>
            <th class="px-5 py-3">Əməliyyat</th>
          </tr>
        </thead>
        <tbody id="rssSourceTableBody">
          <tr>
            <td colspan="6" class="px-5 py-8 text-center text-gray-400">Yüklənir...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Add Source Modal -->
<div id="addModal" class="hidden fixed inset-0 z-[99999] bg-black/50 flex items-center justify-center p-4">
  <div class="bg-white rounded-xl w-full max-w-md p-5">
    <h3 class="text-lg font-semibold text-gray-800 mb-4">Yeni RSS Mənbəsi</h3>
    <div class="space-y-3">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Ad</label>
        <input id="sourceName" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="Məsələn: Trend News">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">RSS URL *</label>
        <input id="sourceUrl" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="https://example.com/rss">
      </div>
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Kateqoriya</label>
        <input id="sourceCategory" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none" placeholder="Məsələn: İqtisadiyyat">
      </div>
    </div>
    <div class="flex justify-end gap-3 mt-5 pt-4 border-t border-gray-200">
      <button onclick="closeAddModal()" class="px-4 py-2 text-sm text-gray-600 bg-gray-100 rounded-lg hover:bg-gray-200">İmtina</button>
      <button onclick="addSource()" class="px-4 py-2 text-sm text-white bg-indigo-600 rounded-lg hover:bg-indigo-700">Əlavə Et</button>
    </div>
  </div>
</div>
