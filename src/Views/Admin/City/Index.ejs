<div class="p-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Cities Management</h1>
    <button onclick="openCityModal()" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm font-medium">+ Add City</button>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <table class="w-full text-sm text-left text-gray-500">
      <thead class="text-xs text-gray-700 uppercase bg-gray-50">
        <tr>
          <th class="px-5 py-3">City Name</th>
          <th class="px-5 py-3">Website</th>
          <th class="px-5 py-3">Actions</th>
        </tr>
      </thead>
      <tbody id="citiesTableBody">
        <tr>
          <td colspan="3" class="px-5 py-8 text-center text-gray-400">Loading...</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<!-- City Modal -->
<div id="cityModal" class="fixed inset-0 z-50 hidden overflow-y-auto">
  <div class="flex items-center justify-center min-h-screen px-4">
    <div class="fixed inset-0 bg-black opacity-50"></div>
    <div class="relative bg-white rounded-lg shadow-xl max-w-lg w-full p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-gray-900" id="cityModalTitle">Add City</h3>
        <button onclick="closeCityModal()" class="text-gray-400 hover:text-gray-600">&times;</button>
      </div>
      <form id="cityForm" class="space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" id="cityId">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">City Name *</label>
          <input type="text" id="cityName" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Website</label>
          <input type="text" id="cityWebsite" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500">
        </div>
        <div class="flex justify-end gap-3 pt-4">
          <button type="button" onclick="closeCityModal()" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 text-sm">Cancel</button>
          <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>
