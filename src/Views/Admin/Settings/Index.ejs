<div class="p-6">
  <h1 class="text-2xl font-bold text-gray-800 mb-6">Settings</h1>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

    <!-- Scraping Controls -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
      <h2 class="text-lg font-semibold text-gray-800 mb-4">Scraping Controls</h2>
      <div class="space-y-3">
        <button onclick="triggerScrape('all')" class="w-full px-4 py-2.5 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm font-medium">
          Scrape All Sites (All Cities)
        </button>
        <button onclick="triggerScrape('main')" class="w-full px-4 py-2.5 bg-blue-600 text-white rounded-lg hover:bg-blue-700 text-sm font-medium">
          Scrape All Sites (Main Cities)
        </button>
        <button onclick="triggerScrape('cancel')" class="w-full px-4 py-2.5 bg-red-600 text-white rounded-lg hover:bg-red-700 text-sm font-medium">
          Cancel Running Scrape
        </button>
      </div>
      <div id="scrapeStatus" class="mt-3 text-sm text-gray-500"></div>
    </div>

    <!-- Cron Schedule Info -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
      <h2 class="text-lg font-semibold text-gray-800 mb-4">Scheduled Scraping</h2>
      <div class="space-y-2 text-sm text-gray-600">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-green-400"></span>
          <span><strong>Friday 13:00</strong> - Full scrape (all cities)</span>
        </div>
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-blue-400"></span>
          <span><strong>Daily 09:00, 16:00, 20:00</strong> - Main cities only</span>
        </div>
      </div>
      <div class="mt-4 p-3 bg-yellow-50 border border-yellow-200 rounded-lg text-sm text-yellow-700">
        <strong>Note:</strong> Cron jobs are configured in app.js. To modify the schedule, edit the cron expressions there.
      </div>
    </div>

    <!-- System Info -->
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-5">
      <h2 class="text-lg font-semibold text-gray-800 mb-4">System Information</h2>
      <dl class="space-y-2 text-sm">
        <div class="flex justify-between">
          <dt class="text-gray-500">Node Version</dt>
          <dd class="text-gray-800 font-medium"><%= typeof process !== 'undefined' ? process.version : 'N/A' %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-gray-500">Environment</dt>
          <dd class="text-gray-800 font-medium"><%= typeof process !== 'undefined' ? (process.env.NODE_ENV || 'development') : 'N/A' %></dd>
        </div>
        <div class="flex justify-between">
          <dt class="text-gray-500">Platform</dt>
          <dd class="text-gray-800 font-medium"><%= typeof process !== 'undefined' ? process.platform : 'N/A' %></dd>
        </div>
      </dl>
    </div>

  </div>
</div>
