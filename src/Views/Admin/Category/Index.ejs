<div class="p-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Category Management</h1>
    <button onclick="openCategoryModal()" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm font-medium">+ Add Category</button>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left text-gray-500">
        <thead class="text-xs text-gray-700 uppercase bg-gray-50">
          <tr>
            <th class="px-5 py-3">Category Name</th>
            <th class="px-5 py-3">Boss.az</th>
            <th class="px-5 py-3">SmartJob.az</th>
            <th class="px-5 py-3">Offer.az</th>
            <th class="px-5 py-3">JobSearch</th>
            <th class="px-5 py-3">HelloJob.az</th>
            <th class="px-5 py-3">Actions</th>
          </tr>
        </thead>
        <tbody id="categoryBody">
          <tr>
            <td colspan="7" class="px-5 py-8 text-center text-gray-400">Loading...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Category Modal -->
<div id="categoryModal" class="fixed inset-0 z-50 hidden overflow-y-auto">
  <div class="flex items-center justify-center min-h-screen px-4">
    <div class="fixed inset-0 bg-black opacity-50"></div>
    <div class="relative bg-white rounded-lg shadow-xl max-w-lg w-full p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-gray-900" id="categoryModalTitle">Add Category</h3>
        <button onclick="closeCategoryModal()" class="text-gray-400 hover:text-gray-600">&times;</button>
      </div>
      <form id="categoryForm" class="space-y-4">
        <input type="hidden" id="categoryId">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Category Name *</label>
          <input type="text" id="categoryName" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500">
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Boss.az ID</label>
            <input type="text" id="bossAz" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">SmartJob.az ID</label>
            <input type="text" id="smartJobAz" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Offer.az ID</label>
            <input type="text" id="offerAz" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">JobSearch ID</label>
            <input type="text" id="jobSearch" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">HelloJob.az ID</label>
            <input type="text" id="helloJobAz" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
          </div>
        </div>
        <div class="flex justify-end gap-3 pt-4">
          <button type="button" onclick="closeCategoryModal()" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 text-sm">Cancel</button>
          <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm">Save</button>
        </div>
      </form>
    </div>
  </div>
</div>
