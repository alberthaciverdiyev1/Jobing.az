<div class="p-6">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-800">Qiymət Planları</h1>
    <button onclick="openPlanModal()" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm font-medium">+ Əlavə et</button>
  </div>

  <div class="bg-white rounded-lg shadow-sm border border-gray-200 overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full text-sm text-left text-gray-500">
        <thead class="text-xs text-gray-700 uppercase bg-gray-50">
          <tr>
            <th class="px-5 py-3">Plan Adı</th>
            <th class="px-5 py-3">Qiymət (AZN)</th>
            <th class="px-5 py-3">Tip</th>
            <th class="px-5 py-3">Müddət</th>
            <th class="px-5 py-3">Status</th>
            <th class="px-5 py-3">Əməliyyat</th>
          </tr>
        </thead>
        <tbody id="pricingBody">
          <tr>
            <td colspan="6" class="px-5 py-8 text-center text-gray-400">Yüklənir...</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Pricing Plan Modal -->
<div id="pricingModal" class="fixed inset-0 z-50 hidden overflow-y-auto">
  <div class="flex items-center justify-center min-h-screen px-4">
    <div class="fixed inset-0 bg-black opacity-50"></div>
    <div class="relative bg-white rounded-lg shadow-xl max-w-lg w-full p-6">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-gray-900" id="pricingModalTitle">Plan Əlavə Et</h3>
        <button onclick="closePlanModal()" class="text-gray-400 hover:text-gray-600">&times;</button>
      </div>
      <form id="pricingForm" class="space-y-4">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" id="planId">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Plan Adı *</label>
          <input type="text" id="planName" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Qiymət (AZN) *</label>
          <input type="number" id="planPrice" step="0.01" min="0" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500">
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Tip *</label>
          <select id="planType" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500">
            <option value="">Seçin</option>
            <option value="premium">Premium</option>
            <option value="promote">İrəli Çək</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Müddət *</label>
          <select id="planDuration" required class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500">
            <option value="">Seçin</option>
            <option value="daily">Günlük</option>
            <option value="monthly">Aylıq</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Açıqlama</label>
          <textarea id="planDescription" rows="2" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500" placeholder="Planın qısa açıqlaması..."></textarea>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Xüsusiyyətlər (hər sətirə bir xüsusiyyət)</label>
          <textarea id="planFeatures" rows="3" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500" placeholder="Vakansiyanız önə çəkilir&#10;Hər 4 gündən bir 8 dəfə&#10;Premium nişanı əlavə olunur"></textarea>
        </div>
        <div class="flex items-center gap-2">
          <input type="checkbox" id="planActive" checked class="w-4 h-4 text-indigo-600 border-gray-300 rounded focus:ring-indigo-500">
          <label for="planActive" class="text-sm text-gray-700">Aktiv</label>
        </div>
        <div class="flex justify-end gap-3 pt-4">
          <button type="button" onclick="closePlanModal()" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 text-sm">Ləğv et</button>
          <button type="submit" class="px-4 py-2 bg-indigo-600 text-white rounded-lg hover:bg-indigo-700 text-sm">Yadda saxla</button>
        </div>
      </form>
    </div>
  </div>
</div>
