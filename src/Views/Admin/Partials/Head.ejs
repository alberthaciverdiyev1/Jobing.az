<head>
    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>

    <!-- FontAwesome CDN -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" rel="stylesheet" />

    <!-- CDN Tailwind -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Admin Styles -->
    <link rel="stylesheet" href="/Admin/Css/Satoshi.css">
    <link rel="stylesheet" href="/Admin/Css/Loader.css">

    <!-- Custom Admin Styles -->
    <style>
      body { font-family: 'Satoshi', sans-serif; background-color: #f1f5f9; }
      .sidebar-active { background-color: #eef2ff !important; color: #4f46e5 !important; }
      .sidebar-active svg { color: #4f46e5 !important; }
      .modal-open { overflow: hidden; }
      .modal-overlay { background: rgba(0,0,0,0.5); position: fixed; inset: 0; z-index: 50; }
      .modal-content { position: relative; z-index: 51; }
      .badge { display: inline-flex; align-items: center; padding: 0.125rem 0.625rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 500; }
      .badge-green { background-color: #dcfce7; color: #166534; }
      .badge-red { background-color: #fee2e2; color: #991b1b; }
      .badge-blue { background-color: #dbeafe; color: #1e40af; }
      .badge-yellow { background-color: #fef9c3; color: #854d0e; }
      .badge-purple { background-color: #f3e8ff; color: #6b21a8; }
      .badge-gray { background-color: #f3f4f6; color: #374151; }
      .sidebar-link.active { background-color: #eef2ff !important; color: #4f46e5 !important; }
      .sidebar-link.active svg { color: #4f46e5 !important; }
      /* Z-index layers: sidebar (9998) < modals (99999) < navbar (999999) */
      .fixed.inset-0.z-50 { z-index: 99999 !important; }
      /* CKEditor inside modal fix */
      .ck-editor__editable { min-height: 200px; }
      .ck.ck-editor { width: 100% !important; }
      /* Pagination button styles */
      .pagination-btn { transition: all 0.15s ease; }
    </style>
</head>
