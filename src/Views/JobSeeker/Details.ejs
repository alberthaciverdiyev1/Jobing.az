<section class="min-h-screen bg-gray-50 pt-24 md:pt-28 pb-16">
  <div class="max-w-5xl mx-auto px-3 sm:px-4 lg:px-6">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-gray-400 mb-6 animate-fade-in-up">
      <a href="/" class="hover:text-primary-500 transition-colors">Ana Səhifə</a>
      <i class="fas fa-chevron-right text-[10px]"></i>
      <a href="/is-axtaran" class="hover:text-primary-500 transition-colors">İş Axtaranlar</a>
      <i class="fas fa-chevron-right text-[10px]"></i>
      <span class="text-gray-600 truncate"><%= data.title %></span>
    </nav>

    <div class="lg:grid lg:grid-cols-3 lg:gap-8 animate-fade-in-up">
      <!-- Main Content -->
      <div class="lg:col-span-2 space-y-6">
        <!-- Header Card -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
          <div class="flex items-start gap-5">
            <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-primary-100 to-primary-50 flex items-center justify-center text-primary-600 text-2xl font-bold flex-shrink-0 shadow-sm">
              <%= (data.userName || '?').charAt(0).toUpperCase() %>
            </div>
            <div class="flex-1 min-w-0">
              <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-1"><%= data.title %></h1>
              <p class="text-lg text-gray-500 font-medium"><%= data.userName %></p>
              <div class="flex items-center gap-4 mt-3 text-sm text-gray-400">
                <span><i class="far fa-calendar mr-1.5"></i><%= new Date(data.postedAt || data.createdAt).toLocaleDateString('az-AZ') %></span>
                <% if (data.cityName) { %>
                <span><i class="fas fa-map-marker-alt mr-1.5"></i><%= data.cityName %></span>
                <% } %>
                <span><i class="far fa-eye mr-1.5"></i><%= data.viewCount || 0 %> baxış</span>
              </div>
              <% if (data.age) { %>
              <div class="mt-3 inline-flex items-center gap-1 px-3 py-1 bg-primary-50 text-primary-600 rounded-full text-xs font-medium">
                <i class="fas fa-calendar-alt"></i> <%= data.age %> yaş
              </div>
              <% } %>
            </div>
          </div>
        </div>

        <!-- Overview Strip -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
          <div class="grid grid-cols-2 sm:grid-cols-3 gap-5">
            <% if (data.cityName) { %>
            <div>
              <p class="text-xs text-gray-400 uppercase tracking-wider mb-1">Şəhər</p>
              <p class="text-sm font-semibold text-gray-900"><%= data.cityName %></p>
            </div>
            <% } %>
            <% if (data.education) { %>
            <div>
              <p class="text-xs text-gray-400 uppercase tracking-wider mb-1">Təhsil</p>
              <p class="text-sm font-semibold text-gray-900"><%= data.education %></p>
            </div>
            <% } %>
            <% if (data.experience) { %>
            <div>
              <p class="text-xs text-gray-400 uppercase tracking-wider mb-1">Təcrübə</p>
              <p class="text-sm font-semibold text-gray-900"><%= data.experience %></p>
            </div>
            <% } %>
          </div>
        </div>

        <!-- Description -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
          <h2 class="text-lg font-semibold text-gray-900 mb-4">Özü Haqqında</h2>
          <div class="prose prose-sm max-w-none text-gray-600 leading-relaxed">
            <%- data.description %>
          </div>
        </div>
      </div>

      <!-- Sidebar -->
      <div class="space-y-6 mt-6 lg:mt-0">
        <!-- Contact Info -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
          <h3 class="font-semibold text-gray-900 mb-4 flex items-center gap-2 text-sm">
            <i class="fas fa-address-card text-primary-500"></i> Əlaqə Məlumatları
          </h3>
          <div class="space-y-3">
            <p class="text-sm text-gray-500 flex items-center gap-2">
              <i class="fas fa-user text-gray-400 w-4 text-center"></i>
              <span><%= data.userName %></span>
            </p>
            <% if (data.email) { %>
            <a href="mailto:<%= data.email %>" class="text-sm flex items-center gap-2 text-primary-500 hover:text-primary-600 transition-colors">
              <i class="fas fa-envelope text-gray-400 w-4 text-center"></i>
              <span class="truncate"><%= data.email %></span>
            </a>
            <% } %>
            <% if (data.phone) { %>
            <a href="tel:<%= data.phone %>" class="text-sm flex items-center gap-2 text-primary-500 hover:text-primary-600 transition-colors">
              <i class="fas fa-phone text-gray-400 w-4 text-center"></i>
              <span><%= data.phone %></span>
            </a>
            <% } %>
          </div>
        </div>

        <% if (data.cvUrl) { %>
        <!-- CV Download -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
          <h3 class="font-semibold text-gray-900 mb-4 flex items-center gap-2 text-sm">
            <i class="fas fa-file-pdf text-primary-500"></i> CV
          </h3>
          <a href="<%= data.cvUrl %>" target="_blank" class="flex items-center gap-3 p-4 rounded-xl bg-primary-50 hover:bg-primary-100 transition-all group">
            <div class="w-10 h-10 rounded-lg bg-primary-100 flex items-center justify-center text-primary-500 group-hover:bg-primary-200 transition-all">
              <i class="fas fa-file-download"></i>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-primary-700 truncate"><%= data.cvFileName || 'CV' %></p>
              <p class="text-xs text-primary-400">CV-ə bax</p>
            </div>
            <i class="fas fa-external-link-alt text-xs text-primary-400 group-hover:text-primary-500"></i>
          </a>
        </div>
        <% } %>

        <!-- Details -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
          <h3 class="font-semibold text-gray-900 mb-4 flex items-center gap-2 text-sm">
            <i class="fas fa-info-circle text-primary-500"></i> Digər Məlumatlar
          </h3>
          <div class="space-y-3 text-sm">
            <div class="flex justify-between">
              <span class="text-gray-400">Kateqoriya</span>
              <span class="font-medium text-gray-700"><%= data.category || 'Göstərilməyib' %></span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-400">Təhsil</span>
              <span class="font-medium text-gray-700"><%= data.education || 'Göstərilməyib' %></span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-400">Təcrübə</span>
              <span class="font-medium text-gray-700"><%= data.experience || 'Göstərilməyib' %></span>
            </div>
            <div class="flex justify-between">
              <span class="text-gray-400">Yerləşdirilib</span>
              <span class="font-medium text-gray-700"><%= new Date(data.postedAt || data.createdAt).toLocaleDateString('az-AZ') %></span>
            </div>
          </div>
        </div>

        <!-- Share -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
          <h3 class="font-semibold text-gray-900 mb-4 flex items-center gap-2 text-sm">
            <i class="fas fa-share-alt text-primary-500"></i> Paylaş
          </h3>
          <div class="flex gap-2">
            <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent('https://jobing.az/is-axtaran/' + data.slug) %>" target="_blank" class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center text-blue-500 hover:bg-blue-100 transition-all">
              <i class="fab fa-facebook-f"></i>
            </a>
            <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent('https://jobing.az/is-axtaran/' + data.slug) %>" target="_blank" class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center text-blue-600 hover:bg-blue-100 transition-all">
              <i class="fab fa-linkedin-in"></i>
            </a>
            <a href="https://wa.me/?text=<%= encodeURIComponent('https://jobing.az/is-axtaran/' + data.slug) %>" target="_blank" class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center text-green-500 hover:bg-green-100 transition-all">
              <i class="fab fa-whatsapp"></i>
            </a>
            <button id="copyLinkButton" class="w-10 h-10 rounded-xl bg-gray-50 flex items-center justify-center text-gray-400 hover:bg-gray-100 transition-all">
              <i class="fas fa-link"></i>
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
document.getElementById('copyLinkButton')?.addEventListener('click', function () {
    navigator.clipboard.writeText(window.location.href).then(function () {
        alertify.success('Link kopyalandı');
    }).catch(function () {
        alertify.success('Link kopyalana bilmədi');
    });
});
</script>
