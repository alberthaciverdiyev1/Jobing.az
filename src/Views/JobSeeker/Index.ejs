<section class="min-h-screen bg-gray-50 pt-24 md:pt-28 pb-16">
  <div class="max-w-[1440px] mx-auto px-3 sm:px-4 lg:px-6">
    <!-- Header -->
    <div class="text-center mb-8 animate-fade-in-up">
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3">İş Axtaranlar</h1>
      <p class="text-gray-500 text-lg">İş axtaran namizədlərə baxın, əlaqə qurun</p>
    </div>

    <div class="lg:flex lg:gap-8 animate-fade-in-up">
      <!-- Desktop Sidebar -->
      <div class="hidden lg:block lg:w-[280px] flex-shrink-0">
        <div class="lg:sticky lg:top-28 space-y-4">
          <%- include('../Partials/FilterContent') %>
        </div>
      </div>

      <!-- Content -->
      <div class="flex-1 min-w-0">
        <!-- Header Bar -->
        <div class="flex items-center justify-between mb-5">
          <p class="text-sm text-gray-500">
            <span id="job-count">0</span> nəticə
          </p>
          <!-- Mobile Filter Trigger -->
          <button id="mobileFilterBtn" class="lg:hidden inline-flex items-center gap-2 px-4 py-2.5 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-700 hover:bg-gray-50 transition-all shadow-sm">
            <i class="fas fa-sliders-h"></i>
            Filtrlər
            <span id="mobile-filter-count" class="hidden w-5 h-5 rounded-full bg-primary-500 text-white text-[10px] font-bold flex items-center justify-center">0</span>
          </button>
        </div>

        <!-- Cards Grid -->
        <div id="card-section" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="col-span-full flex items-center justify-center py-16">
            <div class="text-center">
              <div class="w-10 h-10 border-2 border-primary-500/30 border-t-primary-500 rounded-full animate-spin mx-auto mb-3"></div>
              <p class="text-gray-400 text-sm">Yüklənir...</p>
            </div>
          </div>
        </div>

        <!-- Load More -->
        <div id="load-more-container" class="hidden text-center mt-8">
          <button id="load-more-btn" class="px-8 py-3 bg-white border border-gray-200 rounded-xl text-sm font-medium text-gray-600 hover:bg-gray-50 hover:border-gray-300 transition-all shadow-sm">
            Daha çox yüklə
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Mobile Filter Bottom Sheet -->
<div id="mobileFilterSheet" class="fixed inset-0 z-[60] hidden lg:!hidden">
  <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="closeMobileFilterSheet()"></div>
  <div class="absolute bottom-0 left-0 right-0 bg-white rounded-t-2xl shadow-xl max-h-[85vh] overflow-y-auto transition-all duration-300 translate-y-full" id="mobileFilterPanel">
    <div class="sticky top-0 bg-white border-b border-gray-100 px-5 py-4 flex items-center justify-between rounded-t-2xl">
      <h3 class="font-semibold text-gray-900 text-base">Filtrlər</h3>
      <button onclick="closeMobileFilterSheet()" class="w-8 h-8 rounded-lg hover:bg-gray-100 flex items-center justify-center text-gray-400">
        <i class="fas fa-times"></i>
      </button>
    </div>
    <div class="p-5 space-y-4">
      <%- include('../Partials/FilterContent', { prefix: 'mobile-' }) %>
      <button id="mobileApplyFiltersBtn" class="w-full py-3 bg-gradient-to-r from-primary-500 to-primary-600 text-white rounded-xl font-semibold hover:from-primary-600 hover:to-primary-700 transition-all shadow-sm">
        Filtrləri Tətbiq Et
      </button>
      <button id="mobileClearFiltersBtn" class="w-full py-3 bg-gray-100 text-gray-600 rounded-xl font-semibold hover:bg-gray-200 transition-all">
        Təmizlə
      </button>
    </div>
  </div>
</div>
