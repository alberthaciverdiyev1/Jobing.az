<section class="min-h-screen bg-gray-50 pt-24 md:pt-28 pb-16 md:pb-20">
    <div class="max-w-3xl mx-auto px-3 sm:px-4 lg:px-6">
        <!-- Page Header -->
        <div class="text-center mb-8 animate-fade-in-up">
            <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3">Mən İş Axtarıram</h1>
            <p class="text-gray-500 text-lg">Özünüz haqqında məlumatları paylaşın, işəgötürənlər sizi tapsın</p>
        </div>

        <!-- Global Error -->
        <div id="form-error" class="hidden mb-6 animate-fade-in-up">
            <div class="flex items-start gap-3 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700">
                <div class="flex-shrink-0 mt-0.5"><i class="fas fa-exclamation-circle"></i></div>
                <div class="flex-1 text-sm" id="form-error-text"></div>
                <button type="button" onclick="this.closest('#form-error').classList.add('hidden')" class="flex-shrink-0 text-red-400 hover:text-red-600 transition-colors">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>

        <!-- Form Card -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8 lg:p-10 animate-fade-in-up">
            <!-- CONTACT INFO -->
            <div class="mb-10">
                <div class="flex items-center gap-3 mb-6 pb-4 border-b border-gray-100">
                    <div class="w-10 h-10 rounded-xl bg-primary-50 flex items-center justify-center text-primary-500">
                        <i class="fas fa-user"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-semibold text-gray-900">Əlaqə Məlumatları</h2>
                        <p class="text-sm text-gray-500">Email və ya Telefon mütləq qeyd olunmalıdır.</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div>
                        <label for="username" class="block text-sm font-medium text-gray-700 mb-1.5">
                            Adınız <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
                                <i class="fas fa-user"></i>
                            </span>
                            <input id="username" type="text" placeholder="Adınızı daxil edin"
                                   value="<%= user ? user.name + ' ' + user.surname : '' %>"
                                   class="w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 placeholder:text-gray-400">
                        </div>
                        <span id="username-error" class="error-message text-red-500 text-xs mt-1.5 hidden flex items-center gap-1">
                            <i class="fas fa-exclamation-circle"></i>
                            <span class="error-text">Bu xana doldurulmalıdır</span>
                        </span>
                    </div>

                    <div>
                        <label for="email" class="block text-sm font-medium text-gray-700 mb-1.5">Email</label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
                                <i class="fas fa-envelope"></i>
                            </span>
                            <input id="email" type="email" placeholder="Emailinizi daxil edin"
                                   value="<%= user?.email || '' %>"
                                   class="w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 placeholder:text-gray-400">
                        </div>
                        <span id="email-error" class="error-message text-red-500 text-xs mt-1.5 hidden flex items-center gap-1">
                            <i class="fas fa-exclamation-circle"></i>
                            <span class="error-text">Bu xana doldurulmalıdır</span>
                        </span>
                    </div>

                    <div>
                        <label for="phone" class="block text-sm font-medium text-gray-700 mb-1.5">Telefon Nömrəsi</label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
                                <i class="fas fa-phone"></i>
                            </span>
                            <input id="phone" type="tel" placeholder="Telefon nömrəsi"
                                   value="<%= user?.phone || '' %>"
                                   class="w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 placeholder:text-gray-400">
                        </div>
                        <span id="phone-error" class="error-message text-red-500 text-xs mt-1.5 hidden flex items-center gap-1">
                            <i class="fas fa-exclamation-circle"></i>
                            <span class="error-text">Bu xana doldurulmalıdır</span>
                        </span>
                    </div>
                </div>
            </div>

            <!-- POSITION INFO -->
            <div class="mb-10">
                <div class="flex items-center gap-3 mb-6 pb-4 border-b border-gray-100">
                    <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center text-blue-500">
                        <i class="fas fa-briefcase"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-semibold text-gray-900">İş Məlumatları</h2>
                        <p class="text-sm text-gray-500">Hansı vəzifədə iş axtardığınızı qeyd edin</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div class="md:col-span-2">
                        <label for="position" class="block text-sm font-medium text-gray-700 mb-1.5">
                            Axtardığınız Vəzifə <span class="text-red-500">*</span>
                        </label>
                        <input id="position" type="text" placeholder="Məs: Satış meneceri, Proqram təminatçısı, Mühasib"
                               class="w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 placeholder:text-gray-400">
                        <span id="position-error" class="error-message text-red-500 text-xs mt-1.5 hidden flex items-center gap-1">
                            <i class="fas fa-exclamation-circle"></i>
                            <span class="error-text">Bu xana doldurulmalıdır</span>
                        </span>
                    </div>

                    <div>
                        <label for="category" class="block text-sm font-medium text-gray-700 mb-1.5">
                            Kateqoriya <span class="text-red-500">*</span>
                        </label>
                        <select id="category" class="w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900">
                            <option value="">Seçin</option>
                        </select>
                        <span id="category-error" class="error-message text-red-500 text-xs mt-1.5 hidden flex items-center gap-1">
                            <i class="fas fa-exclamation-circle"></i>
                            <span class="error-text">Seçim edilməlidir</span>
                        </span>
                    </div>

                    <div>
                        <label for="city" class="block text-sm font-medium text-gray-700 mb-1.5">
                            Şəhər <span class="text-red-500">*</span>
                        </label>
                        <select id="city" data-user-city="<%= user?.cityId || '' %>" class="w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900">
                            <option value="">Seçin</option>
                        </select>
                        <span id="city-error" class="error-message text-red-500 text-xs mt-1.5 hidden flex items-center gap-1">
                            <i class="fas fa-exclamation-circle"></i>
                            <span class="error-text">Seçim edilməlidir</span>
                        </span>
                    </div>

                    <div>
                        <label for="education" class="block text-sm font-medium text-gray-700 mb-1.5">Təhsil</label>
                        <select id="education" class="w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900">
                            <option value="">Seçin</option>
                        </select>
                    </div>

                    <div>
                        <label for="experience" class="block text-sm font-medium text-gray-700 mb-1.5">Təcrübə</label>
                        <select id="experience" class="w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900">
                            <option value="">Seçin</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- ABOUT ME -->
            <div class="mb-8">
                <div class="flex items-center gap-3 mb-6 pb-4 border-b border-gray-100">
                    <div class="w-10 h-10 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-500">
                        <i class="fas fa-file-alt"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-semibold text-gray-900">Özünüz Haqqında</h2>
                        <p class="text-sm text-gray-500">Təcrübəniz, bacarıqlarınız və işəgötürənlərə demək istədikləriniz</p>
                    </div>
                </div>

                <div>
                    <textarea id="aboutJob" rows="8" class="w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900" placeholder="Təcrübəniz, bacarıqlarınız, iş gözləntiləriniz..."></textarea>
                    <span id="aboutJob-error" class="error-message text-red-500 text-xs mt-1.5 hidden flex items-center gap-1">
                        <i class="fas fa-exclamation-circle"></i>
                        <span class="error-text">Bu xana doldurulmalıdır</span>
                    </span>
                </div>
            </div>

            <!-- CV SELECTION -->
            <div class="mb-8">
                <div class="flex items-center gap-3 mb-6 pb-4 border-b border-gray-100">
                    <div class="w-10 h-10 rounded-xl bg-purple-50 flex items-center justify-center text-purple-500">
                        <i class="fas fa-paperclip"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-semibold text-gray-900">CV əlavə et</h2>
                        <p class="text-sm text-gray-500">Mövcud CV-lərinizdən seçin və ya yeni CV yükləyin</p>
                    </div>
                </div>

                <div class="space-y-4">
                    <% if (typeof cvs !== 'undefined' && cvs.length > 0) { %>
                    <div>
                        <label for="selectedCV" class="block text-sm font-medium text-gray-700 mb-1.5">CV seçin</label>
                        <select id="selectedCV" class="w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900">
                            <option value="">Seçilməyib (istəyə bağlı)</option>
                            <% cvs.forEach(cv => { %>
                            <option value="<%= cv._id %>" data-cv-url="<%= cv.fileUrl || '' %>"><%= cv.title %><%= cv.fileName ? ' (' + cv.fileName + ')' : '' %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="text-center">
                        <span class="text-sm text-gray-400">və ya</span>
                    </div>
                    <% } %>

                    <div>
                        <div id="drop-zone" class="border-2 border-dashed border-gray-300 rounded-xl p-8 text-center hover:border-primary-400 hover:bg-primary-50/30 transition-all duration-200 cursor-pointer">
                            <input id="cvFile" type="file" accept=".pdf,.doc,.docx,.txt,.rtf,.png,.jpg,.jpeg" class="hidden">
                            <div id="cv-placeholder">
                                <div class="w-14 h-14 mx-auto bg-gray-100 rounded-full flex items-center justify-center mb-3">
                                    <i class="fas fa-cloud-upload-alt text-2xl text-gray-400"></i>
                                </div>
                                <p class="text-gray-600 font-medium">CV-nizi yükləmək üçün klikləyin</p>
                                <p class="text-xs text-gray-400 mt-1">PDF, DOC, DOCX, TXT, RTF, JPG, PNG (maks. 10 MB)</p>
                            </div>
                            <div id="cv-preview" class="hidden">
                                <div class="w-14 h-14 mx-auto bg-green-50 rounded-full flex items-center justify-center mb-3">
                                    <i class="fas fa-check-circle text-2xl text-green-500"></i>
                                </div>
                                <p id="cv-file-name" class="text-gray-700 font-medium"></p>
                                <p id="cv-file-size" class="text-xs text-gray-400 mt-1"></p>
                                <button type="button" id="cv-change-btn" class="mt-3 text-sm text-primary-500 hover:text-primary-700 font-medium">Dəyiş</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Submit -->
            <div class="flex flex-col items-center gap-3 pt-6 border-t border-gray-100">
                <button type="button" id="addJobSeeker"
                        class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-gradient-to-r from-primary-500 to-primary-600 hover:from-primary-600 hover:to-primary-700 text-white font-semibold px-10 py-3.5 rounded-xl transition-all duration-200 shadow-md hover:shadow-lg active:scale-[0.97] text-base">
                    <i class="fas fa-paper-plane"></i>
                    Paylaş
                </button>
                <p class="text-xs text-gray-400">Elanınız yoxlamadan sonra dərc ediləcək.</p>
            </div>
        </div>
    </div>
</section>

<script>
window.validationMessages = {
    position: 'Vəzifə adı daxil edin',
    username: 'Ad daxil edin',
    email: 'Düzgün email daxil edin',
    phone: 'Telefon nömrəsi daxil edin',
    category: 'Kateqoriya seçin',
    city: 'Şəhər seçin',
    aboutJob: 'Özünüz haqqında məlumat daxil edin'
};
</script>
