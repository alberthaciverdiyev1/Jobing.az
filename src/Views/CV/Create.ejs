<!-- ============================================ -->
<!-- CV CREATE / EDIT FORM -->
<!-- ============================================ -->
<section class="min-h-screen bg-gray-50 pt-24 md:pt-28 pb-20">
    <div class="max-w-3xl mx-auto px-3 sm:px-4">
        <!-- Header -->
        <div class="text-center mb-8 animate-fade-in-up">
            <div class="w-16 h-16 mx-auto bg-gradient-to-br from-primary-50 to-amber-50 rounded-2xl flex items-center justify-center mb-4 shadow-sm border border-primary-100">
                <i class="fas fa-file-alt text-2xl text-primary-500"></i>
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2"><%= typeof cv !== 'undefined' ? 'CV Redaktə Et' : 'CV Yarat' %></h1>
            <p class="text-gray-500">Peşəkar CV-nizi yaradın</p>
        </div>

        <!-- Form Card -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 sm:p-8 animate-fade-in-up">
            <form id="cv-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <!-- CV Title -->
                <div class="mb-6">
                    <label class="block text-sm font-medium text-gray-700 mb-1.5">CV Başlığı <span class="text-red-500">*</span></label>
                    <input type="text" id="cv-title" placeholder="Məs: Frontend Developer CV" value="<%= typeof cv !== 'undefined' ? cv.title : '' %>" required
                           class="w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 placeholder:text-gray-400">
                </div>

                <!-- Contact Info Section -->
                <div class="mb-8">
                    <div class="flex items-center gap-3 mb-5 pb-4 border-b border-gray-100">
                        <div class="w-10 h-10 rounded-xl bg-primary-50 flex items-center justify-center text-primary-500">
                            <i class="fas fa-address-card"></i>
                        </div>
                        <div>
                            <h2 class="text-lg font-semibold text-gray-900">Əlaqə Məlumatları</h2>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">Ad Soyad</label>
                            <input type="text" id="cv-fullname" value="<%= typeof cv !== 'undefined' ? cv.fullName : '' %>"
                                   class="w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">Email</label>
                            <input type="email" id="cv-email" value="<%= typeof cv !== 'undefined' ? cv.email : '' %>"
                                   class="w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">Telefon</label>
                            <input type="tel" id="cv-phone" value="<%= typeof cv !== 'undefined' ? cv.phone : '' %>"
                                   class="w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">Ünvan</label>
                            <input type="text" id="cv-address" value="<%= typeof cv !== 'undefined' ? cv.address : '' %>"
                                   class="w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900">
                        </div>
                    </div>
                </div>

                <!-- Social Links -->
                <div class="mb-8">
                    <div class="flex items-center gap-3 mb-5 pb-4 border-b border-gray-100">
                        <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center text-blue-500">
                            <i class="fas fa-link"></i>
                        </div>
                        <div>
                            <h2 class="text-lg font-semibold text-gray-900">Sosial Linklər</h2>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                                   class="w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 placeholder:text-gray-400">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1.5">Vebsayt</label>
                            <input type="url" id="cv-website" value="<%= typeof cv !== 'undefined' ? cv.website : '' %>" placeholder="https://..."
                                   class="w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 placeholder:text-gray-400">
                        </div>
                    </div>
                </div>

                <!-- Professional Summary -->
                <div class="mb-8">
                    <div class="flex items-center gap-3 mb-5 pb-4 border-b border-gray-100">
                        <div class="w-10 h-10 rounded-xl bg-amber-50 flex items-center justify-center text-amber-500">
                            <i class="fas fa-quote-right"></i>
                        </div>
                        <div>
                            <h2 class="text-lg font-semibold text-gray-900">Peşəkar Xülasə</h2>
                        </div>
                    </div>
                    <textarea id="cv-summary" rows="4" placeholder="Özünüz və təcrübəniz haqqında qısa məlumat..."
                              class="w-full px-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 placeholder:text-gray-400"><%= typeof cv !== 'undefined' ? cv.summary : '' %></textarea>
                </div>

                <!-- Education -->
                <div class="mb-8">
                    <div class="flex items-center justify-between mb-5 pb-4 border-b border-gray-100">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-green-50 flex items-center justify-center text-green-500">
                                <i class="fas fa-graduation-cap"></i>
                            </div>
                            <div>
                                <h2 class="text-lg font-semibold text-gray-900">Təhsil</h2>
                            </div>
                        </div>
                        <button type="button" id="add-education" class="text-primary-500 hover:text-primary-600 text-sm font-medium flex items-center gap-1">
                            <i class="fas fa-plus-circle"></i> Əlavə et
                        </button>
                    </div>
                    <div id="education-list">
                        <% if (typeof cv !== 'undefined' && cv.education && cv.education.length > 0) { %>
                            <% cv.education.forEach((edu, i) => { %>
                                <%= includeEducationItem(edu, i) %>
                            <% }); %>
                        <% } %>
                    </div>
                </div>

                <!-- Experience -->
                <div class="mb-8">
                    <div class="flex items-center justify-between mb-5 pb-4 border-b border-gray-100">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-purple-50 flex items-center justify-center text-purple-500">
                                <i class="fas fa-briefcase"></i>
                            </div>
                            <div>
                                <h2 class="text-lg font-semibold text-gray-900">İş Təcrübəsi</h2>
                            </div>
                        </div>
                        <button type="button" id="add-experience" class="text-primary-500 hover:text-primary-600 text-sm font-medium flex items-center gap-1">
                            <i class="fas fa-plus-circle"></i> Əlavə et
                        </button>
                    </div>
                    <div id="experience-list">
                        <% if (typeof cv !== 'undefined' && cv.experience && cv.experience.length > 0) { %>
                            <% cv.experience.forEach((exp, i) => { %>
                                <%= includeExperienceItem(exp, i) %>
                            <% }); %>
                        <% } %>
                    </div>
                </div>

                <!-- Skills -->
                <div class="mb-8">
                    <div class="flex items-center gap-3 mb-5 pb-4 border-b border-gray-100">
                        <div class="w-10 h-10 rounded-xl bg-red-50 flex items-center justify-center text-red-500">
                            <i class="fas fa-code"></i>
                        </div>
                        <div>
                            <h2 class="text-lg font-semibold text-gray-900">Bacarıqlar</h2>
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-2 mb-3" id="skills-container">
                        <% if (typeof cv !== 'undefined' && cv.skills && cv.skills.length > 0) { %>
                            <% cv.skills.forEach(skill => { %>
                                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-primary-50 text-primary-700 rounded-lg text-sm font-medium">
                                    <%= skill %>
                                    <button type="button" class="remove-skill text-primary-400 hover:text-red-500">&times;</button>
                                </span>
                            <% }); %>
                        <% } %>
                    </div>
                    <div class="flex gap-2">
                        <input type="text" id="skill-input" placeholder="Bacarıq əlavə edin..."
                               class="flex-1 px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all text-gray-900 placeholder:text-gray-400">
                        <button type="button" id="add-skill" class="px-4 py-3 bg-primary-500 hover:bg-primary-600 text-white rounded-xl transition-all">Əlavə et</button>
                    </div>
                </div>

                <!-- Languages -->
                <div class="mb-8">
                    <div class="flex items-center justify-between mb-5 pb-4 border-b border-gray-100">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-500">
                                <i class="fas fa-language"></i>
                            </div>
                            <div>
                                <h2 class="text-lg font-semibold text-gray-900">Dillər</h2>
                            </div>
                        </div>
                        <button type="button" id="add-language" class="text-primary-500 hover:text-primary-600 text-sm font-medium flex items-center gap-1">
                            <i class="fas fa-plus-circle"></i> Əlavə et
                        </button>
                    </div>
                    <div id="language-list">
                        <% if (typeof cv !== 'undefined' && cv.languages && cv.languages.length > 0) { %>
                            <% cv.languages.forEach((lang, i) => { %>
                                <%= includeLanguageItem(lang, i) %>
                            <% }); %>
                        <% } %>
                    </div>
                </div>

                <!-- Submit -->
                <div class="pt-6 border-t border-gray-100">
                    <button type="submit"
                            class="w-full bg-gradient-to-r from-primary-500 to-primary-600 hover:from-primary-600 hover:to-primary-700 text-white font-semibold py-4 rounded-xl transition-all duration-200 shadow-sm hover:shadow-md hover:shadow-primary-500/20 active:scale-[0.98] flex items-center justify-center gap-2 text-lg">
                        <i class="fas fa-save"></i>
                        <%= typeof cv !== 'undefined' ? 'Yadda Saxla' : 'CV-ni Yarat' %>
                    </button>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- EJS helper functions for rendering items -->
<%
function includeEducationItem(edu, index) {
    if (!edu) return '';
    const school = edu.school || '';
    const degree = edu.degree || '';
    const field = edu.field || '';
    const startDate = edu.startDate || '';
    const endDate = edu.endDate || '';
    const description = edu.description || '';
    return `
    <div class="education-item bg-gray-50 rounded-xl p-4 mb-3 relative">
        <button type="button" class="remove-education absolute top-3 right-3 text-gray-400 hover:text-red-500"><i class="fas fa-times"></i></button>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div><input type="text" class="edu-school w-full px-3 py-2.5 bg-white border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500" placeholder="Məktəb / Universitet" value="${school}"></div>
            <div><input type="text" class="edu-degree w-full px-3 py-2.5 bg-white border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500" placeholder="Dərəcə (Bakalavr, Magistr)" value="${degree}"></div>
            <div><input type="text" class="edu-field w-full px-3 py-2.5 bg-white border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500" placeholder="İxtisas" value="${field}"></div>
            <div class="grid grid-cols-2 gap-2">
                <input type="text" class="edu-start w-full px-3 py-2.5 bg-white border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500" placeholder="Başlama" value="${startDate}">
                <input type="text" class="edu-end w-full px-3 py-2.5 bg-white border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500" placeholder="Bitmə" value="${endDate}">
            </div>
        </div>
        <textarea class="edu-desc w-full mt-2 px-3 py-2.5 bg-white border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500" rows="2" placeholder="Əlavə məlumat">${description}</textarea>
    </div>`;
}

function includeExperienceItem(exp, index) {
    if (!exp) return '';
    const company = exp.company || '';
    const position = exp.position || '';
    const startDate = exp.startDate || '';
    const endDate = exp.endDate || '';
    const description = exp.description || '';
    return `
    <div class="experience-item bg-gray-50 rounded-xl p-4 mb-3 relative">
        <button type="button" class="remove-experience absolute top-3 right-3 text-gray-400 hover:text-red-500"><i class="fas fa-times"></i></button>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div><input type="text" class="exp-company w-full px-3 py-2.5 bg-white border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500" placeholder="Şirkət" value="${company}"></div>
            <div><input type="text" class="exp-position w-full px-3 py-2.5 bg-white border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500" placeholder="Vəzifə" value="${position}"></div>
            <div class="grid grid-cols-2 gap-2">
                <input type="text" class="exp-start w-full px-3 py-2.5 bg-white border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500" placeholder="Başlama" value="${startDate}">
                <input type="text" class="exp-end w-full px-3 py-2.5 bg-white border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500" placeholder="Bitmə" value="${endDate}">
            </div>
        </div>
        <textarea class="exp-desc w-full mt-2 px-3 py-2.5 bg-white border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500" rows="2" placeholder="Vəzifə öhdəlikləri">${description}</textarea>
    </div>`;
}

function includeLanguageItem(lang, index) {
    if (!lang) return '';
    const name = lang.name || '';
    const level = lang.level || 'intermediate';
    const levels = [
        { value: 'beginner', label: 'Başlanğıc' },
        { value: 'intermediate', label: 'Orta' },
        { value: 'advanced', label: 'Qabaqcıl' },
        { value: 'native', label: 'Ana dili' }
    ];
    const options = levels.map(l => `<option value="${l.value}" ${level === l.value ? 'selected' : ''}>${l.label}</option>`).join('');
    return `
    <div class="language-item flex items-center gap-3 bg-gray-50 rounded-xl p-4 mb-3">
        <button type="button" class="remove-language text-gray-400 hover:text-red-500"><i class="fas fa-times"></i></button>
        <input type="text" class="lang-name flex-1 px-3 py-2.5 bg-white border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500" placeholder="Dil" value="${name}">
        <select class="lang-level px-3 py-2.5 bg-white border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500">${options}</select>
    </div>`;
}
%>
