<!-- ============================================================
     Premium Candidate Directory — Card-Based Layout
     Sticky sidebar filters · 3‑col card grid · Floating search
     ============================================================ -->
<section class="min-h-screen bg-[#FAFAFB] dark:bg-gray-950 pt-24 md:pt-28">
  <!-- Subtle background texture -->
  <div class="fixed inset-0 bg-gradient-to-b from-white via-gray-50/30 to-gray-50/50 dark:from-gray-950 dark:via-gray-900/30 dark:to-gray-900/50 pointer-events-none"></div>

  <!-- ====== TOP BAR ====== -->
  <div class="bg-white/80 dark:bg-gray-900/80 backdrop-blur-lg border-b border-gray-100/80 dark:border-gray-800/80">
    <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10">
      <div class="flex items-center justify-between h-16 sm:h-[72px]">
        <div class="flex items-baseline gap-3">
          <h1 class="text-lg sm:text-xl font-bold tracking-[-0.02em] text-gray-900 dark:text-white"><%= __('cv.candidates') %></h1>
          <span class="text-sm text-gray-300 dark:text-gray-600" id="header-count">—</span>
        </div>
        <div class="flex items-center gap-4">
          <kbd class="hidden sm:inline-flex items-center gap-1 px-2 py-1 bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg text-[10px] text-gray-400 dark:text-gray-500 font-mono">
            <span>⌘K</span>
          </kbd>
        </div>
      </div>

      <!-- ====== SEARCH BAR ====== -->
      <div class="relative pb-4 sm:pb-5">
        <div class="relative flex items-center h-11 sm:h-12 bg-gray-50/90 dark:bg-gray-800/90 border border-gray-200/70 dark:border-gray-700/70 rounded-xl transition-all duration-300 focus-within:bg-white dark:focus-within:bg-gray-800 focus-within:border-primary-500/40 focus-within:shadow-[0_0_0_3px_rgba(255,107,0,0.06)] group">
          <div class="flex items-center justify-center w-11 sm:w-12 h-full flex-shrink-0">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-gray-300 dark:text-gray-600 group-focus-within:text-primary-400 transition-colors" stroke-width="1.5" stroke-linecap="round">
              <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
            </svg>
          </div>
          <input
            type="text" id="cv-search" autocomplete="off" spellcheck="false"
            placeholder="<%= __('cv.searchCandidates') %>"
            class="flex-1 bg-transparent border-0 outline-none text-sm text-gray-900 dark:text-gray-100 placeholder:text-gray-300 dark:placeholder:text-gray-500 py-0 pr-3 min-w-0"
          >
          <button id="search-clear" class="hidden mr-2 w-6 h-6 rounded-full bg-gray-200/60 dark:bg-gray-700/60 hover:bg-gray-300/70 dark:hover:bg-gray-600/70 flex items-center justify-center transition-all duration-200">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-gray-500 dark:text-gray-400" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        </div>

        <!-- Trending tags -->
        <div class="flex items-center gap-1.5 sm:gap-2 mt-2.5 overflow-x-auto scrollbar-none">
          <span class="text-[11px] font-medium text-gray-300 dark:text-gray-600 flex-shrink-0"><%= __('cv.trend') %></span>
          <button data-skill="JavaScript" class="quick-filter flex-shrink-0 px-2.5 py-1 rounded-md text-[11px] font-medium bg-gray-100/70 dark:bg-gray-800/70 text-gray-500 dark:text-gray-400 hover:bg-primary-50 hover:text-primary-600 hover:ring-1 hover:ring-primary-200/60 dark:hover:bg-primary-900/20 dark:hover:text-primary-400 dark:hover:ring-primary-700/40 transition-all duration-200">JavaScript</button>
          <button data-skill="React" class="quick-filter flex-shrink-0 px-2.5 py-1 rounded-md text-[11px] font-medium bg-gray-100/70 dark:bg-gray-800/70 text-gray-500 dark:text-gray-400 hover:bg-primary-50 hover:text-primary-600 hover:ring-1 hover:ring-primary-200/60 dark:hover:bg-primary-900/20 dark:hover:text-primary-400 dark:hover:ring-primary-700/40 transition-all duration-200">React</button>
          <button data-skill="Python" class="quick-filter flex-shrink-0 px-2.5 py-1 rounded-md text-[11px] font-medium bg-gray-100/70 dark:bg-gray-800/70 text-gray-500 dark:text-gray-400 hover:bg-primary-50 hover:text-primary-600 hover:ring-1 hover:ring-primary-200/60 dark:hover:bg-primary-900/20 dark:hover:text-primary-400 dark:hover:ring-primary-700/40 transition-all duration-200">Python</button>
          <button data-skill="Node.js" class="quick-filter flex-shrink-0 px-2.5 py-1 rounded-md text-[11px] font-medium bg-gray-100/70 dark:bg-gray-800/70 text-gray-500 dark:text-gray-400 hover:bg-primary-50 hover:text-primary-600 hover:ring-1 hover:ring-primary-200/60 dark:hover:bg-primary-900/20 dark:hover:text-primary-400 dark:hover:ring-primary-700/40 transition-all duration-200">Node.js</button>
          <button data-skill="UI/UX" class="quick-filter flex-shrink-0 px-2.5 py-1 rounded-md text-[11px] font-medium bg-gray-100/70 dark:bg-gray-800/70 text-gray-500 dark:text-gray-400 hover:bg-primary-50 hover:text-primary-600 hover:ring-1 hover:ring-primary-200/60 dark:hover:bg-primary-900/20 dark:hover:text-primary-400 dark:hover:ring-primary-700/40 transition-all duration-200">UI/UX</button>
          <button data-skill="Java" class="quick-filter flex-shrink-0 px-2.5 py-1 rounded-md text-[11px] font-medium bg-gray-100/70 dark:bg-gray-800/70 text-gray-500 dark:text-gray-400 hover:bg-primary-50 hover:text-primary-600 hover:ring-1 hover:ring-primary-200/60 dark:hover:bg-primary-900/20 dark:hover:text-primary-400 dark:hover:ring-primary-700/40 transition-all duration-200">Java</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ====== BODY ====== -->
  <div class="max-w-7xl mx-auto px-5 sm:px-8 lg:px-10 py-6 sm:py-8">
    <div class="flex gap-8">

      <!-- ====== FILTER SIDEBAR ====== -->
      <aside class="hidden lg:block w-[260px] flex-shrink-0">
        <div class="sticky top-[140px] space-y-5">

          <!-- Skills -->
          <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-100/80 dark:border-gray-800/80 shadow-sm p-5">
            <div class="flex items-center justify-between mb-3">
              <h3 class="text-xs font-semibold text-gray-900 dark:text-white uppercase tracking-wider"><%= __('cv.skills') %></h3>
              <button class="filter-sidebar-clear text-[10px] text-gray-300 dark:text-gray-600 hover:text-gray-500 dark:hover:text-gray-300 transition-colors"><%= __('cv.clear') %></button>
            </div>
            <div class="space-y-1 max-h-[200px] overflow-y-auto scrollbar-none">
              <label class="flex items-center gap-2.5 px-2 py-1.5 rounded-lg cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                <input type="checkbox" data-skill="JavaScript" class="skill-filter w-4 h-4 rounded border-gray-300 text-primary-500 focus:ring-primary-500/30 accent-[#FF6B00]">
                <span class="text-xs text-gray-600 dark:text-gray-400">JavaScript</span>
              </label>
              <label class="flex items-center gap-2.5 px-2 py-1.5 rounded-lg cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                <input type="checkbox" data-skill="React" class="skill-filter w-4 h-4 rounded border-gray-300 text-primary-500 focus:ring-primary-500/30 accent-[#FF6B00]">
                <span class="text-xs text-gray-600 dark:text-gray-400">React</span>
              </label>
            </div>
            <div id="sidebar-skills-list" class="space-y-1 max-h-[200px] overflow-y-auto scrollbar-none"></div>
          </div>

          <!-- Education -->
          <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-100/80 dark:border-gray-800/80 shadow-sm p-5">
            <h3 class="text-xs font-semibold text-gray-900 dark:text-white uppercase tracking-wider mb-3"><%= __('cv.eduFilter') %></h3>
            <div class="space-y-1">
              <label class="flex items-center gap-2.5 px-2 py-1.5 rounded-lg cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                <input type="checkbox" data-edu="Ali" class="edu-filter w-4 h-4 rounded border-gray-300 text-primary-500 accent-[#FF6B00]">
                <span class="text-xs text-gray-600 dark:text-gray-400"><%= __('cv.eduAli') %></span>
              </label>
              <label class="flex items-center gap-2.5 px-2 py-1.5 rounded-lg cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                <input type="checkbox" data-edu="Magistr" class="edu-filter w-4 h-4 rounded border-gray-300 text-primary-500 accent-[#FF6B00]">
                <span class="text-xs text-gray-600 dark:text-gray-400"><%= __('cv.eduMagistr') %></span>
              </label>
              <label class="flex items-center gap-2.5 px-2 py-1.5 rounded-lg cursor-pointer hover:bg-gray-50 dark:hover:bg-gray-800 transition-colors">
                <input type="checkbox" data-edu="Orta" class="edu-filter w-4 h-4 rounded border-gray-300 text-primary-500 accent-[#FF6B00]">
                <span class="text-xs text-gray-600 dark:text-gray-400"><%= __('cv.eduOrta') %></span>
              </label>
            </div>
          </div>

          <!-- Status filters -->
          <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-100/80 dark:border-gray-800/80 shadow-sm p-5">
            <h3 class="text-xs font-semibold text-gray-900 dark:text-white uppercase tracking-wider mb-3"><%= __('cv.status') %></h3>
            <div class="flex flex-wrap gap-2">
              <button class="availability-filter px-3 py-1.5 rounded-lg text-xs font-medium border border-gray-200/80 dark:border-gray-700/80 text-gray-500 dark:text-gray-400 hover:border-emerald-300 hover:text-emerald-600 hover:bg-emerald-50/50 dark:hover:bg-emerald-900/20 dark:hover:text-emerald-400 dark:hover:border-emerald-700 transition-all duration-200" data-avail="active"><%= __('cv.statusActive') %></button>
              <button class="availability-filter px-3 py-1.5 rounded-lg text-xs font-medium border border-gray-200/80 dark:border-gray-700/80 text-gray-500 dark:text-gray-400 hover:border-amber-300 hover:text-amber-600 hover:bg-amber-50/50 dark:hover:bg-amber-900/20 dark:hover:text-amber-400 dark:hover:border-amber-700 transition-all duration-200" data-avail="passive"><%= __('cv.statusPassive') %></button>
              <button class="availability-filter px-3 py-1.5 rounded-lg text-xs font-medium border border-gray-200/80 dark:border-gray-700/80 text-gray-500 dark:text-gray-400 hover:border-blue-300 hover:text-blue-600 hover:bg-blue-50/50 dark:hover:bg-blue-900/20 dark:hover:text-blue-400 dark:hover:border-blue-700 transition-all duration-200" data-avail="open"><%= __('cv.statusOpen') %></button>
            </div>
          </div>

          <button id="sidebar-clear-all" class="w-full py-2.5 text-xs text-gray-400 dark:text-gray-500 hover:text-gray-600 dark:hover:text-gray-300 border border-dashed border-gray-200/80 dark:border-gray-700/80 rounded-xl hover:border-gray-300 dark:hover:border-gray-600 transition-all duration-200">
            <%= __('cv.clearAll') %>
          </button>
        </div>
      </aside>

      <!-- ====== MAIN CONTENT ====== -->
      <div class="flex-1 min-w-0">

        <!-- Toolbar -->
        <div class="flex items-center justify-between mb-5">
          <div class="flex items-center gap-3">
            <select id="page-size" class="appearance-none text-xs text-gray-400 dark:text-gray-500 bg-transparent border border-gray-200/70 dark:border-gray-700/70 rounded-lg px-3 py-1.5 pr-7 cursor-pointer hover:border-gray-300 dark:hover:border-gray-600 transition-colors">
              <option value="12">12 <%= __('cv.results') %></option>
              <option value="24" selected>24 <%= __('cv.results') %></option>
              <option value="48">48 <%= __('cv.results') %></option>
            </select>
          </div>
          <button id="active-filters-clear" class="hidden text-xs text-gray-300 dark:text-gray-600 hover:text-gray-500 dark:hover:text-gray-300 transition-colors"><%= __('cv.clear') %></button>
        </div>

        <!-- Active filter chips -->
        <div id="active-filters" class="hidden flex flex-wrap gap-1.5 mb-4"></div>

        <!-- Skeleton -->
        <div id="skeleton-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          <% for (var i = 0; i < 6; i++) { %>
          <div class="bg-white dark:bg-gray-900 rounded-2xl border border-gray-100/80 dark:border-gray-800/80 shadow-sm overflow-hidden">
            <div class="p-5 space-y-4">
              <div class="flex items-start gap-3">
                <div class="w-11 h-11 rounded-xl bg-gray-100 dark:bg-gray-800 animate-pulse flex-shrink-0"></div>
                <div class="flex-1 space-y-2 pt-1">
                  <div class="h-4 bg-gray-100 dark:bg-gray-800 rounded-md animate-pulse w-2/3"></div>
                  <div class="h-3 bg-gray-50 dark:bg-gray-800/50 rounded-md animate-pulse w-1/2"></div>
                </div>
              </div>
              <div class="space-y-2">
                <div class="h-3 bg-gray-50 dark:bg-gray-800/50 rounded-md animate-pulse w-full"></div>
                <div class="h-3 bg-gray-50 dark:bg-gray-800/50 rounded-md animate-pulse w-4/5"></div>
              </div>
              <div class="flex gap-1.5">
                <div class="h-7 w-16 bg-gray-50 dark:bg-gray-800/50 rounded-lg animate-pulse"></div>
                <div class="h-7 w-20 bg-gray-50 dark:bg-gray-800/50 rounded-lg animate-pulse"></div>
                <div class="h-7 w-14 bg-gray-50 dark:bg-gray-800/50 rounded-lg animate-pulse"></div>
              </div>
              <div class="h-9 w-full bg-gray-50 dark:bg-gray-800/50 rounded-xl animate-pulse"></div>
            </div>
          </div>
          <% } %>
        </div>

        <!-- Card grid -->
        <div id="cv-grid" class="hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5"></div>

        <!-- Empty -->
        <div id="empty-state" class="hidden py-24 text-center">
          <div class="max-w-xs mx-auto">
            <div class="w-14 h-14 mx-auto mb-5 bg-gray-100 dark:bg-gray-800 rounded-2xl flex items-center justify-center">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-gray-300 dark:text-gray-600" stroke-width="1.2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            </div>
            <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-1"><%= __('cv.emptyListTitle') %></h3>
            <p class="text-sm text-gray-400 dark:text-gray-500 leading-relaxed mb-6"><%= __('cv.emptyListSub') %></p>
            <button id="reset-search" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-600 dark:text-gray-400 bg-white dark:bg-gray-900 border border-gray-200/80 dark:border-gray-700/80 rounded-xl hover:border-gray-300 dark:hover:border-gray-600 hover:text-gray-800 dark:hover:text-gray-200 transition-all duration-200">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg>
              <%= __('cv.reset') %>
            </button>
          </div>
        </div>

        <!-- Error -->
        <div id="cv-error" class="hidden py-24 text-center">
          <div class="max-w-xs mx-auto">
            <div class="w-14 h-14 mx-auto mb-5 bg-red-50 dark:bg-red-900/20 rounded-2xl flex items-center justify-center">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="text-red-300 dark:text-red-500" stroke-width="1.2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
            </div>
            <h3 class="text-base font-semibold text-gray-900 dark:text-white mb-1"><%= __('cv.errorTitle') %></h3>
            <p class="text-sm text-gray-400 dark:text-gray-500 leading-relaxed mb-6"><%= __('cv.errorSub') %></p>
            <button id="retry-load" class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-600 dark:text-gray-400 bg-white dark:bg-gray-900 border border-gray-200/80 dark:border-gray-700/80 rounded-xl hover:border-gray-300 dark:hover:border-gray-600 hover:text-gray-800 dark:hover:text-gray-200 transition-all duration-200">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg>
              <%= __('cv.retry') %>
            </button>
          </div>
        </div>

        <!-- Pagination -->
        <div id="cv-pagination" class="hidden flex items-center justify-center gap-1 mt-10 pb-12"></div>

      </div>
    </div>
  </div>
</section>

<script>
window._CVT = {
  active: '<%= __('cv.activeBadge') %>',
  viewProfile: '<%= __('cv.viewProfile') %>',
  cvUploaded: '<%= __('cv.cvUploaded') %>',
  today: '<%= __('cv.today') %>',
  yesterday: '<%= __('cv.yesterday') %>',
  daysAgo: '<%= __('cv.daysAgo') %>',
  weeksAgo: '<%= __('cv.weeksAgo') %>',
  loading: '<%= __('cv.loadingList') %>',
  result: '<%= __('cv.count') %>',
  error: '<%= __('cv.errorHeader') %>',
  clear: '<%= __('cv.clear') %>',
  expYear: '<%= __('cv.expYear') %>',
  expCount: '<%= __('cv.expCount') %>',
};
</script>

<style>
.scrollbar-none::-webkit-scrollbar { display: none; }
.scrollbar-none { -ms-overflow-style: none; scrollbar-width: none; }

@keyframes pulse { 50% { opacity: .5; } }
.animate-pulse { animation: pulse 2s cubic-bezier(.4,0,.6,1) infinite; }

@keyframes cardIn {
  from { opacity: 0; transform: translateY(12px); }
  to { opacity: 1; transform: translateY(0); }
}
.candidate-card-enter {
  animation: cardIn 0.4s ease-out both;
}

.skill-filter:checked, .edu-filter:checked { accent-color: #FF6B00; }
.filter-chip { transition: all 0.15s ease; }

.page-btn { transition: all 0.15s ease; }
.page-btn:hover { background: #f3f4f6; color: #111; }
.dark .page-btn:hover { background: #1f2937; color: #f3f4f6; }
.page-btn.active { color: #FF6B00; font-weight: 600; }
</style>
