<section class="bg-gradient-to-b from-gray-50 to-white min-h-screen pt-20 pb-16">
    <div class="max-w-[1440px] mx-auto px-3 sm:px-4 lg:px-6">

        <!-- ========== BREADCRUMB ========== -->
        <nav class="flex items-center gap-2 text-sm text-gray-400 mb-6 pt-6 animate-fade-in-down">
            <a href="/" class="hover:text-primary-500 transition-colors"><%= __('jobDetail.breadcrumbHome') %></a>
            <i class="fas fa-chevron-right text-[10px]"></i>
            <a href="/vakansiyalar" class="hover:text-primary-500 transition-colors"><%= __('jobDetail.breadcrumbJobs') %></a>
            <i class="fas fa-chevron-right text-[10px]"></i>
            <span class="text-gray-600 truncate max-w-[200px] font-medium"><%= data.title %></span>
        </nav>

        <!-- ========== JSON-LD: JobPosting ========== -->
        <% const _desc = (data.description || '').replace(/<[^>]*>/g, '').trim(); %>
        <% const _jobTypeMap = { '0x001': 'FULL_TIME', '0x002': 'PART_TIME', '0x003': 'CONTRACTOR', '0x004': 'INTERN', '0x005': 'OTHER' }; %>
        <% const _empType = data.jobType ? (_jobTypeMap[String(data.jobType)] || 'FULL_TIME') : 'FULL_TIME'; %>
        <script type="application/ld+json">
        {
            "@context": "https://schema.org",
            "@type": "JobPosting",
            "title": <%- JSON.stringify(data.title) %>,
            "description": <%- JSON.stringify(_desc.slice(0, 5000)) %>,
            "datePosted": <%- JSON.stringify(new Date(data.postedAt).toISOString().split('T')[0]) %>,
            "validThrough": <%- JSON.stringify(new Date(new Date(data.postedAt).setDate(new Date(data.postedAt).getDate() + 30)).toISOString().split('T')[0]) %>,
            "hiringOrganization": {
                "@type": "Organization",
                "name": <%- JSON.stringify(data.companyName || '') %>,
                "sameAs": "https://jobing.az",
                "logo": <%- JSON.stringify(data.companyImage || 'https://jobing.az/Images/DefaultCompany.png') %>
            },
            "jobLocation": {
                "@type": "Place",
                "address": {
                    "@type": "PostalAddress",
                    "addressLocality": <%- JSON.stringify(data.location || '') %>,
                    "addressCountry": "AZ"
                }
            },
            <% if (data.minSalary || data.maxSalary) { %>
            "baseSalary": {
                "@type": "MonetaryAmount",
                "currency": "AZN",
                "value": {
                    "@type": "QuantitativeValue",
                    <% if (data.minSalary && data.maxSalary) { %>
                    "minValue": <%= Number(data.minSalary) %>,
                    "maxValue": <%= Number(data.maxSalary) %>,
                    <% } else if (data.minSalary) { %>
                    "value": <%= Number(data.minSalary) %>,
                    <% } else { %>
                    "value": <%= Number(data.maxSalary) %>,
                    <% } %>
                    "unitText": "MONTH"
                }
            },
            <% } %>
            "employmentType": <%- JSON.stringify(_empType) %>,
            "educationRequirements": <%- JSON.stringify(data.education || 'Qeyd olunmayıb') %>,
            "experienceRequirements": <%- JSON.stringify(data.experience || 'Qeyd olunmayıb') %>,
            "identifier": {
                "@type": "PropertyValue",
                "name": <%- JSON.stringify(data.companyName || '') %>,
                "value": <%- JSON.stringify(String(data._id || '')) %>
            }
        }
        </script>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-8 items-start">

            <!-- ========== MAIN CONTENT ========== -->
            <div class="lg:col-span-2 space-y-6">

                <!-- ===== JOB HEADER CARD ===== -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden animate-fade-in-up">
                    <!-- Gradient accent bar -->
                    <div class="h-1.5 bg-gradient-to-r from-primary-400 via-primary-500 to-primary-600"></div>

                    <div class="p-4 sm:p-8">
                        <div class="flex items-start gap-3 sm:gap-6">
                            <!-- Company Logo -->
                            <div class="w-12 h-12 sm:w-24 sm:h-24 rounded-xl sm:rounded-2xl bg-gradient-to-br from-gray-50 to-gray-100 border border-gray-100 flex-shrink-0 overflow-hidden flex items-center justify-center shadow-sm ring-1 ring-black/5">
                                <img src="<%= data.companyImage ? data.companyImage : '/Images/DefaultCompany.png' %>"
                                     alt="<%= data.companyName %>" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/Images/DefaultCompany.png'">
                            </div>

                            <div class="flex-1 min-w-0 sm:text-left">
                                <!-- Title -->
                                <h1 class="text-xl sm:text-2xl lg:text-3xl font-bold text-gray-900 leading-tight break-words">
                                    <%= data.title %>
                                </h1>

                                <!-- Company name -->
                                <p class="text-sm sm:text-base text-gray-500 font-medium mt-1.5 flex items-center gap-1.5 truncate">
                                    <i class="fas fa-building text-gray-300 text-xs flex-shrink-0"></i>
                                    <%= data.companyName %>
                                </p>

                                <!-- Meta row -->
                                <div class="flex flex-wrap items-center gap-x-3 gap-y-1.5 mt-3">
                                    <span class="inline-flex items-center gap-1.5 text-xs sm:text-sm text-gray-400 bg-gray-50 px-2.5 py-1 rounded-lg">
                                        <i class="fas fa-map-marker-alt"></i>
                                        <%= data.location %>
                                    </span>
                                    <span class="inline-flex items-center gap-1.5 text-xs sm:text-sm text-gray-400 bg-gray-50 px-2.5 py-1 rounded-lg">
                                        <i class="far fa-calendar"></i>
                                        <%= new Date(data.postedAt).toLocaleString('az-AZ', { day: '2-digit', month: 'long', year: 'numeric' }) %>
                                    </span>
                                    <span class="inline-flex items-center gap-1.5 text-xs sm:text-sm text-gray-400 bg-gray-50 px-2.5 py-1 rounded-lg">
                                        <i class="far fa-clock"></i>
                                        <%= __('jobDetail.lastDate') %> <%= new Date(new Date(data.postedAt).setDate(new Date(data.postedAt).getDate() + 30)).toLocaleString('az-AZ', { day: '2-digit', month: 'long', year: 'numeric' }) %>
                                    </span>
                                </div>

                                <!-- Tags -->
                                <div class="flex flex-wrap items-center gap-2 mt-3">
                                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-lg text-xs font-medium bg-emerald-50 text-emerald-700 border border-emerald-100">
                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse-subtle"></span>
                                        <%= __('jobDetail.active') %>
                                    </span>
                                    <% if (data.education) { %>
                                        <span class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium bg-purple-50 text-purple-700 border border-purple-100"><i class="fas fa-graduation-cap mr-1 text-[10px]"></i><%= data.education %></span>
                                    <% } %>
                                    <% if (data.experience) { %>
                                        <span class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium bg-blue-50 text-blue-700 border border-blue-100"><i class="fas fa-briefcase mr-1 text-[10px]"></i><%= data.experience %></span>
                                    <% } %>
                                    <% if (data.minSalary || data.maxSalary) { %>
                                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-lg text-xs font-semibold bg-primary-50 text-primary-600 border border-primary-100">
                                            <i class="fas fa-money-bill-wave text-[10px]"></i>
                                            <%= data.minSalary || '' %><% if (data.minSalary && data.maxSalary) { %> - <% } %><%= data.maxSalary || '' %>
                                            <i class="fa-solid fa-manat-sign text-[10px]"></i>
                                        </span>
                                    <% } else { %>
                                        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-lg text-xs font-medium bg-gray-50 text-gray-500 border border-gray-100">
                                            <i class="fas fa-handshake"></i>
                                            <%= __('jobDetail.salaryNegotiable') %>
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===== JOB OVERVIEW STRIP ===== -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5 sm:p-6 animate-fade-in-up" style="animation-delay: 50ms">
                    <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-wider mb-4"><%= __('jobDetail.overview') %></h2>
                    <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-5 gap-3 sm:gap-4">
                        <div class="flex sm:flex-col items-center sm:text-center gap-3 sm:gap-0 p-3 sm:p-3 rounded-xl bg-gray-50/80">
                            <div class="w-8 h-8 sm:w-9 sm:h-9 flex-shrink-0 rounded-lg bg-primary-50 flex items-center justify-center text-primary-500 sm:mx-auto sm:mb-2">
                                <i class="fas fa-money-bill-wave text-xs sm:text-sm"></i>
                            </div>
                            <div class="min-w-0 flex-1 sm:flex-none">
                                <p class="text-xs text-gray-400 mb-0 sm:mb-0.5"><%= __('jobDetail.salary') %></p>
                                <% if (data.minSalary || data.maxSalary) { %>
                                    <p class="text-sm font-semibold text-gray-900 truncate"><%= data.minSalary || '' %><% if (data.minSalary && data.maxSalary) { %>-<% } %><%= data.maxSalary || '' %> ₼</p>
                                <% } else { %>
                                    <p class="text-sm font-semibold text-gray-500"><%= __('jobDetail.salaryNegotiable') %></p>
                                <% } %>
                            </div>
                        </div>
                        <div class="flex sm:flex-col items-center sm:text-center gap-3 sm:gap-0 p-3 sm:p-3 rounded-xl bg-gray-50/80">
                            <div class="w-8 h-8 sm:w-9 sm:h-9 flex-shrink-0 rounded-lg bg-blue-50 flex items-center justify-center text-blue-500 sm:mx-auto sm:mb-2">
                                <i class="fas fa-map-marker-alt text-xs sm:text-sm"></i>
                            </div>
                            <div class="min-w-0 flex-1 sm:flex-none">
                                <p class="text-xs text-gray-400 mb-0 sm:mb-0.5"><%= __('jobDetail.city') %></p>
                                <p class="text-sm font-semibold text-gray-900 truncate"><%= data.location %></p>
                            </div>
                        </div>
                        <div class="flex sm:flex-col items-center sm:text-center gap-3 sm:gap-0 p-3 sm:p-3 rounded-xl bg-gray-50/80">
                            <div class="w-8 h-8 sm:w-9 sm:h-9 flex-shrink-0 rounded-lg bg-purple-50 flex items-center justify-center text-purple-500 sm:mx-auto sm:mb-2">
                                <i class="fas fa-graduation-cap text-xs sm:text-sm"></i>
                            </div>
                            <div class="min-w-0 flex-1 sm:flex-none">
                                <p class="text-xs text-gray-400 mb-0 sm:mb-0.5"><%= __('jobDetail.education') %></p>
                                <p class="text-sm font-semibold text-gray-900 truncate"><%= data.education ? data.education : __('jobDetail.noRequirement') %></p>
                            </div>
                        </div>
                        <div class="flex sm:flex-col items-center sm:text-center gap-3 sm:gap-0 p-3 sm:p-3 rounded-xl bg-gray-50/80">
                            <div class="w-8 h-8 sm:w-9 sm:h-9 flex-shrink-0 rounded-lg bg-emerald-50 flex items-center justify-center text-emerald-500 sm:mx-auto sm:mb-2">
                                <i class="fas fa-briefcase text-xs sm:text-sm"></i>
                            </div>
                            <div class="min-w-0 flex-1 sm:flex-none">
                                <p class="text-xs text-gray-400 mb-0 sm:mb-0.5"><%= __('jobDetail.experience') %></p>
                                <p class="text-sm font-semibold text-gray-900 truncate"><%= data.experience ? data.experience : __('jobDetail.noRequirement') %></p>
                            </div>
                        </div>
                        <div class="flex sm:flex-col items-center sm:text-center gap-3 sm:gap-0 p-3 sm:p-3 rounded-xl bg-gray-50/80">
                            <div class="w-8 h-8 sm:w-9 sm:h-9 flex-shrink-0 rounded-lg bg-amber-50 flex items-center justify-center text-amber-500 sm:mx-auto sm:mb-2">
                                <i class="fas fa-user text-xs sm:text-sm"></i>
                            </div>
                            <div class="min-w-0 flex-1 sm:flex-none">
                                <p class="text-xs text-gray-400 mb-0 sm:mb-0.5"><%= __('jobDetail.age') %></p>
                                <p class="text-sm font-semibold text-gray-900 truncate">
                                    <%= data.minAge && data.maxAge ? `${data.minAge}-${data.maxAge}` : data.minAge ? `${data.minAge}+` : data.maxAge ? `-${data.maxAge}` : __('jobDetail.notSpecified') %>
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ===== MOBILE APPLY (visible only below lg, no pricing — shown once in sidebar) ===== -->
                <div class="lg:hidden animate-fade-in-up" style="animation-delay: 75ms">
                    <% if (typeof user !== 'undefined' && user && user.role === 'user') { %>
                        <div class="w-full p-3 bg-amber-50 border border-amber-200 rounded-xl text-sm text-amber-700">
                            <p class="font-medium"><i class="fas fa-building mr-1"></i><%= __('jobDetail.needCompanyAccount') %></p>
                        </div>
                    <% } else if (typeof user === 'undefined' || !user) { %>
                        <a href="/auth"
                           class="w-full inline-flex items-center justify-center gap-2 bg-gradient-to-r from-primary-500 to-primary-600 hover:from-primary-600 hover:to-primary-700 text-white font-medium px-5 py-3.5 rounded-xl transition-all duration-200 shadow-sm hover:shadow-md active:scale-[0.98]">
                            <i class="fas fa-paper-plane"></i>
                            <%= __('jobDetail.apply') %>
                        </a>
                    <% } %>
                    <% if (data.phone) { %>
                        <a href="tel:<%= data.phone %>"
                           class="mt-3 w-full inline-flex items-center justify-center gap-2 bg-white hover:bg-gray-50 text-gray-700 font-medium px-5 py-3.5 rounded-xl border border-gray-200 transition-all duration-200 shadow-sm hover:shadow-md">
                            <i class="fas fa-phone"></i>
                            <%= data.phone %>
                        </a>
                    <% } %>
                </div>

                <!-- ===== JOB DESCRIPTION ===== -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8 animate-fade-in-up" style="animation-delay: 100ms">
                    <div class="flex items-center gap-3 mb-6 pb-4 border-b border-gray-50">
                        <div class="w-8 h-8 rounded-lg bg-primary-50 flex items-center justify-center text-primary-500">
                            <i class="fas fa-file-alt text-sm"></i>
                        </div>
                        <div>
                            <h2 class="text-lg font-bold text-gray-900"><%= __('jobDetail.description') %></h2>
                            <p class="text-xs text-gray-400"><%= __('jobDetail.descriptionSub') %></p>
                        </div>
                    </div>
                    <div class="default-html text-gray-700 leading-relaxed text-sm sm:text-base">
                        <%- data.description %>
                    </div>
                </div>

                <!-- ===== MOBILE SIDEBAR CONTENT (visible only below lg) ===== -->
                <div class="lg:hidden space-y-5 animate-fade-in-up" style="animation-delay: 125ms">

                    <!-- Company Info -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                        <div class="h-1.5 bg-gradient-to-r from-primary-300 via-primary-400 to-primary-500"></div>
                        <div class="p-5">
                            <div class="flex items-center gap-4 pb-4 border-b border-gray-50">
                                <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-gray-50 to-gray-100 border border-gray-100 overflow-hidden flex items-center justify-center flex-shrink-0 shadow-sm">
                                    <img src="<%= data.companyImage ? data.companyImage : '/Images/DefaultCompany.png' %>"
                                         alt="<%= data.companyName %>" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/Images/DefaultCompany.png'">
                                </div>
                                <div class="min-w-0">
                                    <h3 class="font-semibold text-gray-900 truncate"><%= data.companyName %></h3>
                                    <a href="/vakansiyalar?keyword=<%= data.companyName %>"
                                       class="text-sm text-primary-500 hover:text-primary-600 transition-colors">
                                        <%= __('jobDetail.companyJobs') %> →
                                    </a>
                                </div>
                            </div>
                            <ul class="space-y-3 mt-4">
                                <li class="flex items-center justify-between">
                                    <span class="text-sm text-gray-400"><%= __('jobDetail.sidebarCategory') %></span>
                                    <span class="text-sm font-medium text-gray-900"><%= data.category %></span>
                                </li>
                                <li class="flex items-center justify-between">
                                    <span class="text-sm text-gray-400"><%= __('jobDetail.salary') %></span>
                                    <% if (data.minSalary || data.maxSalary) { %>
                                        <span class="text-sm font-semibold text-primary-500"><%= data.minSalary || '' %><% if (data.minSalary && data.maxSalary) { %> - <% } %><%= data.maxSalary || '' %> ₼</span>
                                    <% } else { %>
                                        <span class="text-sm text-gray-500"><%= __('jobDetail.salaryNegotiable') %></span>
                                    <% } %>
                                </li>
                                <li class="flex items-center justify-between pt-2 border-t border-gray-50">
                                    <span class="text-sm text-gray-400"><%= __('jobDetail.sidebarDeadline') %></span>
                                    <span class="text-sm font-medium text-gray-900">
                                        <%= new Date(new Date(data.postedAt).setDate(new Date(data.postedAt).getDate() + 30)).toLocaleString('az-AZ', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                    </span>
                                </li>
                                <% if (data.userName) { %>
                                <li class="flex items-center justify-between">
                                    <span class="text-sm text-gray-400"><i class="fas fa-user-tie text-gray-300 w-3.5 mr-1"></i><%= __('jobDetail.sidebarContact') %></span>
                                    <span class="text-sm font-medium text-gray-900"><%= data.userName %></span>
                                </li>
                                <% } %>
                            </ul>
                        </div>
                    </div>

                    <!-- Contact Info -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
                        <h3 class="font-semibold text-gray-900 mb-3 flex items-center gap-2 text-sm">
                            <i class="fas fa-address-card text-gray-400"></i>
                            <%= __('jobDetail.contactInfo') %>
                        </h3>
                        <div class="space-y-2.5">
                            <% if (data.phone) { %>
                                <a href="tel:<%= data.phone %>" class="flex items-center gap-3 p-2.5 rounded-xl bg-gray-50 hover:bg-primary-50 transition-colors group">
                                    <div class="w-8 h-8 rounded-lg bg-green-100 flex items-center justify-center text-green-600 group-hover:bg-green-200 transition-colors">
                                        <i class="fas fa-phone text-xs"></i>
                                    </div>
                                    <span class="text-sm font-medium text-gray-700 group-hover:text-primary-600"><%= data.phone %></span>
                                </a>
                            <% } %>
                            <% if (data.email) { %>
                                <a href="mailto:<%= data.email %>" class="flex items-center gap-3 p-2.5 rounded-xl bg-gray-50 hover:bg-primary-50 transition-colors group">
                                    <div class="w-8 h-8 rounded-lg bg-blue-100 flex items-center justify-center text-blue-600 group-hover:bg-blue-200 transition-colors">
                                        <i class="fas fa-envelope text-xs"></i>
                                    </div>
                                    <span class="text-sm font-medium text-gray-700 truncate group-hover:text-primary-600"><%= data.email %></span>
                                </a>
                            <% } %>
                        </div>
                    </div>

                    <!-- Pricing Actions -->
                    <div class="bg-gradient-to-br from-amber-50 to-orange-50 rounded-2xl shadow-sm border border-amber-200/60 p-5">
                        <h3 class="font-semibold text-gray-900 mb-3 flex items-center gap-2 text-sm">
                            <i class="fas fa-star text-amber-500"></i> Vakansiyanı önə çək
                        </h3>
                        <div class="space-y-2.5">
                            <button data-pricing-type="promote"
                                    class="w-full flex items-center justify-center gap-2 px-4 py-3 bg-gradient-to-r from-amber-500 to-orange-500 text-white rounded-xl hover:from-amber-600 hover:to-orange-600 transition-all text-sm font-semibold shadow-sm active:scale-[0.98]">
                                <i class="fas fa-rocket"></i> İrəli Çək
                            </button>
                            <button data-pricing-type="premium"
                                    class="w-full flex items-center justify-center gap-2 px-4 py-3 bg-gradient-to-r from-purple-500 to-indigo-500 text-white rounded-xl hover:from-purple-600 hover:to-indigo-600 transition-all text-sm font-semibold shadow-sm active:scale-[0.98]">
                                <i class="fas fa-crown"></i> Premium Et
                            </button>
                        </div>
                    </div>

                    <!-- Share -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
                        <h3 class="font-semibold text-gray-900 mb-4 flex items-center gap-2 text-sm">
                            <i class="fas fa-share-alt text-gray-400"></i>
                            <%= __('jobDetail.share') %>
                        </h3>
                        <div class="flex items-center gap-2.5">
                            <a href="https://www.facebook.com/sharer/sharer.php?u=<%=data.redirectUrl%>"
                               target="_blank"
                               class="flex-1 flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl bg-blue-50 text-blue-600 hover:bg-blue-100 transition-all text-sm font-medium">
                                <i class="fab fa-facebook-f"></i>
                            </a>
                            <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%=data.redirectUrl%>"
                               target="_blank"
                               class="flex-1 flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl bg-blue-50 text-blue-700 hover:bg-blue-100 transition-all text-sm font-medium">
                                <i class="fab fa-linkedin-in"></i>
                            </a>
                            <a href="https://wa.me/?text=<%=data.redirectUrl%>"
                               target="_blank"
                               class="flex-1 flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl bg-green-50 text-green-600 hover:bg-green-100 transition-all text-sm font-medium">
                                <i class="fab fa-whatsapp"></i>
                            </a>
                            <button id="copyLinkButtonMobile"
                                    class="flex items-center justify-center px-3 py-2.5 rounded-xl bg-gray-100 text-gray-600 hover:bg-gray-200 transition-all text-sm">
                                <i class="fa-regular fa-copy"></i>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ===== SIMILAR JOBS ===== -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8 animate-fade-in-up" style="animation-delay: 150ms">
                    <div class="flex items-center gap-3 mb-6">
                        <div class="w-8 h-8 rounded-lg bg-blue-50 flex items-center justify-center text-blue-500">
                            <i class="fas fa-briefcase text-sm"></i>
                        </div>
                        <div>
                            <h2 class="text-lg font-bold text-gray-900"><%= __('jobDetail.similarJobs') %></h2>
                            <p class="text-xs text-gray-400"><%= __('jobDetail.similarJobsSub') %></p>
                        </div>
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" id="home-card-section">
                        <div class="col-span-full flex items-center justify-center py-10">
                            <div class="flex flex-col items-center gap-3">
                                <div class="w-6 h-6 border-2 border-primary-500/30 border-t-primary-500 rounded-full animate-spin"></div>
                                <span class="text-gray-400 text-sm"><%= __('common.loading') %></span>
                            </div>
                        </div>
                    </div>
                    <div class="text-center mt-6 pt-4 border-t border-gray-50">
                        <a href="/vakansiyalar"
                           class="inline-flex items-center gap-2 px-6 py-2.5 rounded-xl border border-gray-200 text-sm font-medium text-gray-600 hover:text-primary-500 hover:border-primary-200 hover:bg-primary-50/30 transition-all duration-200">
                            <%= __('jobDetail.viewAll') %>
                            <i class="fas fa-arrow-right text-xs"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- ========== SIDEBAR (hidden on mobile) ========== -->
            <aside class="space-y-5 animate-fade-in-up hidden lg:block" style="animation-delay: 100ms">

                <!-- ===== STICKY SIDEBAR WRAPPER ===== -->
                <div class="lg:sticky lg:top-28 space-y-5">

                    <!-- Company Info Card -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
                        <div class="h-1.5 bg-gradient-to-r from-primary-300 via-primary-400 to-primary-500"></div>
                        <div class="p-5">
                            <div class="flex items-center gap-4 pb-4 border-b border-gray-50">
                                <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-gray-50 to-gray-100 border border-gray-100 overflow-hidden flex items-center justify-center flex-shrink-0 shadow-sm">
                                    <img src="<%= data.companyImage ? data.companyImage : '/Images/DefaultCompany.png' %>"
                                         alt="<%= data.companyName %>" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/Images/DefaultCompany.png'">
                                </div>
                                <div class="min-w-0">
                                    <h3 class="font-semibold text-gray-900 truncate"><%= data.companyName %></h3>
                                    <a href="/vakansiyalar?keyword=<%= data.companyName %>"
                                       class="text-sm text-primary-500 hover:text-primary-600 transition-colors">
                                        <%= __('jobDetail.companyJobs') %> →
                                    </a>
                                </div>
                            </div>

                            <!-- Detail list -->
                            <ul class="space-y-3 mt-4">
                                <li class="flex items-center justify-between">
                                    <span class="text-sm text-gray-400 flex items-center gap-2"><i class="fas fa-tag text-gray-300 w-3.5"></i><%= __('jobDetail.sidebarCategory') %></span>
                                    <span class="text-sm font-medium text-gray-900"><%= data.category %></span>
                                </li>
                                <li class="flex items-center justify-between">
                                    <span class="text-sm text-gray-400 flex items-center gap-2"><i class="fas fa-money-bill-wave text-gray-300 w-3.5"></i><%= __('jobDetail.salary') %></span>
                                    <% if (data.minSalary || data.maxSalary) { %>
                                        <span class="text-sm font-semibold text-primary-500">
                                            <%= data.minSalary || '' %><% if (data.minSalary && data.maxSalary) { %> - <% } %><%= data.maxSalary || '' %>
                                            <i class="fa-solid fa-manat-sign text-[10px]"></i>
                                        </span>
                                    <% } else { %>
                                        <span class="text-sm text-gray-500"><%= __('jobDetail.salaryNegotiable') %></span>
                                    <% } %>
                                </li>
                                <li class="flex items-center justify-between">
                                    <span class="text-sm text-gray-400 flex items-center gap-2"><i class="fas fa-map-marker-alt text-gray-300 w-3.5"></i><%= __('jobDetail.city') %></span>
                                    <span class="text-sm font-medium text-gray-900"><%= data.location %></span>
                                </li>
                                <li class="flex items-center justify-between">
                                    <span class="text-sm text-gray-400 flex items-center gap-2"><i class="fas fa-graduation-cap text-gray-300 w-3.5"></i><%= __('jobDetail.education') %></span>
                                    <span class="text-sm font-medium text-gray-900"><%= data.education ? data.education : '-' %></span>
                                </li>
                                <li class="flex items-center justify-between">
                                    <span class="text-sm text-gray-400 flex items-center gap-2"><i class="fas fa-briefcase text-gray-300 w-3.5"></i><%= __('jobDetail.experience') %></span>
                                    <span class="text-sm font-medium text-gray-900"><%= data.experience ? data.experience : '-' %></span>
                                </li>
                                <% if (data.minAge || data.maxAge) { %>
                                <li class="flex items-center justify-between">
                                    <span class="text-sm text-gray-400 flex items-center gap-2"><i class="fas fa-user text-gray-300 w-3.5"></i><%= __('jobDetail.age') %></span>
                                    <span class="text-sm font-medium text-gray-900"><%= data.minAge && data.maxAge ? `${data.minAge}-${data.maxAge}` : data.minAge ? `${data.minAge}+` : `-${data.maxAge}` %></span>
                                </li>
                                <% } %>
                                <li class="flex items-center justify-between pt-2 border-t border-gray-50">
                                    <span class="text-sm text-gray-400 flex items-center gap-2"><i class="far fa-calendar-alt text-gray-300 w-3.5"></i><%= __('jobDetail.sidebarDeadline') %></span>
                                    <span class="text-sm font-medium text-gray-900">
                                        <%= new Date(new Date(data.postedAt).setDate(new Date(data.postedAt).getDate() + 30)).toLocaleString('az-AZ', { day: '2-digit', month: 'short', year: 'numeric' }) %>
                                    </span>
                                </li>
                                <% if (data.userName) { %>
                                <li class="flex items-center justify-between">
                                    <span class="text-sm text-gray-400 flex items-center gap-2"><i class="fas fa-user-tie text-gray-300 w-3.5"></i><%= __('jobDetail.sidebarContact') %></span>
                                    <span class="text-sm font-medium text-gray-900"><%= data.userName %></span>
                                </li>
                                <% } %>
                            </ul>
                        </div>
                    </div>

                    <!-- Apply Card -->
                    <div class="bg-gradient-to-br from-primary-500 to-primary-600 rounded-2xl shadow-md p-5 hidden lg:block">
                        <% if (typeof user !== 'undefined' && user && user.role === 'user') { %>
                            <div class="w-full p-3 bg-white/15 rounded-xl text-sm text-white/90 text-center">
                                <p class="font-medium"><i class="fas fa-building mr-1"></i><%= __('jobDetail.needCompanyAccount') %></p>
                            </div>
                        <% } else if (typeof user === 'undefined' || !user) { %>
                            <a href="/auth"
                               class="block w-full bg-white text-primary-600 hover:bg-primary-50 font-semibold py-3.5 px-6 rounded-xl text-center transition-all duration-200 shadow-sm hover:shadow-md">
                                <i class="fas fa-paper-plane mr-2"></i>
                                <%= __('jobDetail.apply') %>
                            </a>
                            <p class="text-xs text-white/60 text-center mt-2"><%= __('jobDetail.applySub') %></p>
                        <% } else { %>
                            <p class="text-sm text-white/80 text-center py-2"><%= __('jobDetail.youCannotApply') %></p>
                        <% } %>
                    </div>

                    <!-- Contact Info -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
                        <h3 class="font-semibold text-gray-900 mb-3 flex items-center gap-2 text-sm">
                            <i class="fas fa-address-card text-gray-400"></i>
                            <%= __('jobDetail.contactInfo') %>
                        </h3>
                        <div class="space-y-2.5">
                            <% if (data.phone) { %>
                                <a href="tel:<%= data.phone %>" class="flex items-center gap-3 p-2.5 rounded-xl bg-gray-50 hover:bg-primary-50 transition-colors group">
                                    <div class="w-8 h-8 rounded-lg bg-green-100 flex items-center justify-center text-green-600 group-hover:bg-green-200 transition-colors">
                                        <i class="fas fa-phone text-xs"></i>
                                    </div>
                                    <span class="text-sm font-medium text-gray-700 group-hover:text-primary-600"><%= data.phone %></span>
                                </a>
                            <% } %>
                            <% if (data.email) { %>
                                <a href="mailto:<%= data.email %>" class="flex items-center gap-3 p-2.5 rounded-xl bg-gray-50 hover:bg-primary-50 transition-colors group">
                                    <div class="w-8 h-8 rounded-lg bg-blue-100 flex items-center justify-center text-blue-600 group-hover:bg-blue-200 transition-colors">
                                        <i class="fas fa-envelope text-xs"></i>
                                    </div>
                                    <span class="text-sm font-medium text-gray-700 truncate group-hover:text-primary-600"><%= data.email %></span>
                                </a>
                            <% } %>
                        </div>
                    </div>

                    <!-- Pricing Actions -->
                    <div class="bg-gradient-to-br from-amber-50 to-orange-50 rounded-2xl shadow-sm border border-amber-200/60 p-5">
                        <h3 class="font-semibold text-gray-900 mb-3 flex items-center gap-2 text-sm">
                            <i class="fas fa-star text-amber-500"></i> Vakansiyanı önə çək
                        </h3>
                        <div class="space-y-2.5">
                            <button data-pricing-type="promote"
                                    class="w-full flex items-center justify-center gap-2 px-4 py-3 bg-gradient-to-r from-amber-500 to-orange-500 text-white rounded-xl hover:from-amber-600 hover:to-orange-600 transition-all text-sm font-semibold shadow-sm">
                                <i class="fas fa-rocket"></i> İrəli Çək
                            </button>
                            <button data-pricing-type="premium"
                                    class="w-full flex items-center justify-center gap-2 px-4 py-3 bg-gradient-to-r from-purple-500 to-indigo-500 text-white rounded-xl hover:from-purple-600 hover:to-indigo-600 transition-all text-sm font-semibold shadow-sm">
                                <i class="fas fa-crown"></i> Premium Et
                            </button>
                        </div>
                    </div>

                    <!-- Share Card -->
                    <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-5">
                        <h3 class="font-semibold text-gray-900 mb-4 flex items-center gap-2 text-sm">
                            <i class="fas fa-share-alt text-gray-400"></i>
                            <%= __('jobDetail.share') %>
                        </h3>
                        <div class="flex items-center gap-2.5">
                            <a href="https://www.facebook.com/sharer/sharer.php?u=<%=data.redirectUrl%>"
                               target="_blank"
                               class="flex-1 flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl bg-blue-50 text-blue-600 hover:bg-blue-100 transition-all text-sm font-medium">
                                <i class="fab fa-facebook-f"></i>
                            </a>
                            <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%=data.redirectUrl%>"
                               target="_blank"
                               class="flex-1 flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl bg-blue-50 text-blue-700 hover:bg-blue-100 transition-all text-sm font-medium">
                                <i class="fab fa-linkedin-in"></i>
                            </a>
                            <a href="https://wa.me/?text=<%=data.redirectUrl%>"
                               target="_blank"
                               class="flex-1 flex items-center justify-center gap-2 px-3 py-2.5 rounded-xl bg-green-50 text-green-600 hover:bg-green-100 transition-all text-sm font-medium">
                                <i class="fab fa-whatsapp"></i>
                            </a>
                            <button id="copyLinkButton"
                                    class="flex items-center justify-center px-3 py-2.5 rounded-xl bg-gray-100 text-gray-600 hover:bg-gray-200 transition-all text-sm">
                                <i class="fa-regular fa-copy"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </aside>
        </div>
    </div>

    <!-- Hidden inputs -->
    <input type="hidden" id="categoryId" value="<%= data.categoryId %>">
    <input type="hidden" id="jobId" value="<%= data._id %>">
</section>

<!-- ========== CV SELECTION MODAL ========== -->
<div id="cvSelectModal" class="fixed inset-0 z-50 hidden overflow-y-auto">
  <div class="flex items-center justify-center min-h-screen px-4">
    <div class="fixed inset-0 bg-black/50 backdrop-blur-sm"></div>
    <div class="relative bg-white rounded-2xl shadow-xl max-w-md w-full p-6 animate-scale-in">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-gray-900"><%= __('modal.selectCV') %></h3>
        <button onclick="closeCvModal()" class="w-8 h-8 rounded-lg hover:bg-gray-100 flex items-center justify-center text-gray-400 hover:text-gray-600 transition-colors">&times;</button>
      </div>
      <p class="text-sm text-gray-400 mb-4"><%= __('modal.selectCVDesc') %></p>
      <div id="cvListContainer" class="space-y-3">
        <div class="text-center py-8">
          <div class="w-6 h-6 border-2 border-primary-500/30 border-t-primary-500 rounded-full animate-spin mx-auto"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ========== NO CV WARNING MODAL ========== -->
<div id="noCvModal" class="fixed inset-0 z-50 hidden overflow-y-auto">
  <div class="flex items-center justify-center min-h-screen px-4">
    <div class="fixed inset-0 bg-black/50 backdrop-blur-sm"></div>
    <div class="relative bg-white rounded-2xl shadow-xl max-w-sm w-full p-6 text-center animate-scale-in">
      <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-amber-100 flex items-center justify-center">
        <i class="fas fa-exclamation-triangle text-2xl text-amber-500"></i>
      </div>
      <h3 class="text-lg font-semibold text-gray-900 mb-2"><%= __('modal.noCVTitle') %></h3>
      <p class="text-sm text-gray-500 mb-6"><%= __('modal.noCVDesc') %></p>
      <div class="flex gap-3 justify-center">
        <button onclick="closeNoCvModal()" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 text-sm font-medium"><%= __('modal.close') %></button>
        <a href="/cv/create" class="px-4 py-2 bg-gradient-to-r from-primary-500 to-primary-600 text-white rounded-lg hover:from-primary-600 hover:to-primary-700 text-sm font-medium shadow-sm"><%= __('modal.createCV') %></a>
      </div>
    </div>
  </div>
</div>

<!-- ========== SUCCESS MODAL ========== -->
<div id="applySuccessModal" class="fixed inset-0 z-50 hidden overflow-y-auto">
  <div class="flex items-center justify-center min-h-screen px-4">
    <div class="fixed inset-0 bg-black/50 backdrop-blur-sm"></div>
    <div class="relative bg-white rounded-2xl shadow-xl max-w-sm w-full p-6 text-center animate-scale-in">
      <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-green-100 flex items-center justify-center">
        <i class="fas fa-check-circle text-2xl text-green-500"></i>
      </div>
      <h3 class="text-lg font-semibold text-gray-900 mb-2"><%= __('modal.successTitle') %></h3>
      <p class="text-sm text-gray-500 mb-6"><%= __('modal.successDesc') %></p>
      <div class="flex gap-3 justify-center">
        <button onclick="closeSuccessModal()" class="px-4 py-2 bg-gradient-to-r from-primary-500 to-primary-600 text-white rounded-lg hover:from-primary-600 hover:to-primary-700 text-sm font-medium shadow-sm"><%= __('modal.close') %></button>
        <a href="/dashboard" class="px-4 py-2 bg-gray-100 text-gray-700 rounded-lg hover:bg-gray-200 text-sm font-medium"><%= __('modal.panelim') %></a>
      </div>
    </div>
  </div>
</div>

<!-- ========== PRICING MODAL ========== -->
<div id="pricingModal" class="fixed inset-0 z-[9999] hidden">
  <div id="pricingModalOverlay" class="fixed inset-0 bg-black/60 backdrop-blur-sm"></div>
  <div class="fixed inset-0 overflow-y-auto">
    <div class="flex min-h-full items-center justify-center p-3 sm:p-4">
      <div class="relative w-full max-w-lg bg-white rounded-2xl shadow-2xl animate-scale-in">
        <!-- Gradient header strip -->
        <div id="pricingModalAccent" class="h-1.5 rounded-t-2xl bg-gradient-to-r from-amber-400 to-orange-500"></div>

        <div class="p-5 sm:p-6">
          <!-- Header -->
          <div class="flex items-start justify-between mb-4">
            <div class="flex items-center gap-3">
              <div id="pricingModalIcon" class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center text-amber-600 flex-shrink-0">
                <i class="fas fa-rocket"></i>
              </div>
              <div>
                <h3 id="pricingModalTitle" class="text-base sm:text-lg font-bold text-gray-900">İrəli Çək</h3>
                <p id="pricingModalBadge" class="hidden text-[10px] font-semibold uppercase tracking-wider text-purple-600">Premium</p>
              </div>
            </div>
            <button onclick="closePricingModal()" class="w-8 h-8 rounded-lg hover:bg-gray-100 flex items-center justify-center text-gray-400 hover:text-gray-600 transition-colors flex-shrink-0" title="Bağla">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
          </div>

          <!-- Info box -->
          <div id="pricingInfoBox" class="rounded-xl bg-amber-50 border border-amber-200 p-3 sm:p-4 mb-4">
            <div class="flex gap-2.5">
              <div class="w-6 h-6 rounded-lg bg-amber-100 flex items-center justify-center text-amber-600 flex-shrink-0 mt-0.5">
                <i class="fas fa-lightbulb text-[10px]"></i>
              </div>
              <div>
                <p id="pricingInfoTitle" class="text-xs font-semibold text-amber-900 mb-0.5">İrəli Çəkmə Nədir?</p>
                <p id="pricingInfoText" class="text-xs text-amber-800 leading-relaxed">
                  İrəli çəkmə planı ilə vakansiyanız müntəzəm olaraq vakansiyalar siyahısında yuxarı qaldırılır.
                  <span class="font-semibold text-amber-900">Aylıq planlarda hər 4 gündən bir (ayda 8 dəfə)</span> irəli çəkilir.
                </p>
              </div>
            </div>
          </div>

          <!-- Description -->
          <p id="pricingModalDesc" class="text-sm text-gray-500 mb-4">Mövcud planlardan birini seçin</p>

          <!-- Plans container -->
          <div id="pricingPlansContainer" class="space-y-3 mb-4">
            <div class="text-center py-8">
              <div class="w-6 h-6 border-2 border-primary-500/30 border-t-primary-500 rounded-full animate-spin mx-auto"></div>
            </div>
          </div>

          <!-- Phone -->
          <div class="mb-4">
            <label class="block text-sm font-medium text-gray-700 mb-1.5">
              <i class="fas fa-phone text-gray-400 mr-1"></i> Əlaqə nömrəsi *
            </label>
            <input type="tel" id="pricingPhone" placeholder="+994 XX XXX XX XX"
                   class="w-full px-4 py-3 border-2 border-gray-300 rounded-xl text-sm focus:ring-2 focus:ring-primary-500 focus:border-primary-500 outline-none transition-shadow bg-white hover:border-gray-400">
            <p id="pricingPhoneNote" class="text-[11px] text-gray-500 mt-1.5">
              <i class="fas fa-info-circle mr-0.5"></i> Profilinizdə qeyd edilmiş nömrə avtomatik əlavə olunub.
            </p>
          </div>

          <!-- Submit -->
          <button id="submitPricingBtn"
                  class="w-full py-3 bg-gradient-to-r from-primary-500 to-primary-600 text-white rounded-xl font-semibold text-sm hover:from-primary-600 hover:to-primary-700 transition-all shadow-sm hover:shadow-md active:scale-[0.98] disabled:opacity-60 disabled:cursor-not-allowed">
            Göndər
          </button>

          <p class="text-[10px] text-gray-400 text-center mt-3">Müraciətiniz admin tərəfindən dəyərləndiriləcək.</p>
        </div>
      </div>
    </div>
  </div>
</div>
