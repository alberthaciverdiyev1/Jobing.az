<section class="bg-gray-50 min-h-screen pt-24 pb-16">
    <div class="max-w-[1440px] mx-auto px-3 sm:px-4 lg:px-6">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-gray-400 mb-6 animate-fade-in">
            <a href="/" class="hover:text-primary-500 transition-colors">Ana Səhifə</a>
            <i class="fas fa-chevron-right text-[10px]"></i>
            <a href="/vakansiyalar" class="hover:text-primary-500 transition-colors">Vakansiyalar</a>
            <i class="fas fa-chevron-right text-[10px]"></i>
            <span class="text-gray-600 truncate max-w-[200px]"><%= data.title %></span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-start">
            <!-- ========== MAIN CONTENT ========== -->
            <div class="lg:col-span-2 space-y-6">

                <!-- Job Header Card -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
                    <div class="flex flex-col sm:flex-row gap-5 sm:gap-6">
                        <!-- Company Logo -->
                        <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-2xl bg-gray-50 border border-gray-100 flex-shrink-0 overflow-hidden flex items-center justify-center mx-auto sm:mx-0 shadow-sm">
                            <img src="<%= data.companyImage ? data.companyImage : '/Images/DefaultCompany.png' %>"
                                 alt="<%= data.companyName %>" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/Images/DefaultCompany.png'">
                        </div>

                        <div class="flex-1 text-center sm:text-left">
                            <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3 leading-tight">
                                <%= data.title %>
                            </h1>

                            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-x-4 gap-y-2 text-sm text-gray-500 mb-4">
                                <span class="inline-flex items-center gap-1.5">
                                    <i class="fas fa-building text-gray-300"></i>
                                    <%= data.companyName %>
                                </span>
                                <span class="inline-flex items-center gap-1.5">
                                    <i class="fas fa-map-marker-alt text-gray-300"></i>
                                    <%= data.location %>
                                </span>
                                <span class="inline-flex items-center gap-1.5">
                                    <i class="far fa-calendar text-gray-300"></i>
                                    <%= new Date(data.postedAt).toLocaleString('az-AZ', { day: '2-digit', month: '2-digit', year: 'numeric' }) %>
                                </span>
                            </div>

                            <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2">
                                <span class="inline-flex items-center gap-1 px-3 py-1 rounded-lg text-xs font-medium bg-emerald-50 text-emerald-700">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                                    Aktiv
                                </span>
                                <% if (data.education) { %>
                                    <span class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium bg-purple-50 text-purple-700"><%= data.education %></span>
                                <% } %>
                                <% if (data.experience) { %>
                                    <span class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-medium bg-blue-50 text-blue-700"><%= data.experience %></span>
                                <% } %>
                                <% if (data.minSalary || data.maxSalary) { %>
                                    <span class="inline-flex items-center gap-1 px-3 py-1 rounded-lg text-xs font-semibold bg-primary-50 text-primary-600">
                                        <i class="fas fa-money-bill-wave"></i>
                                        <%= data.minSalary || '' %> <% if (data.minSalary && data.maxSalary) { %>-<% } %> <%= data.maxSalary || '' %>
                                        <i class="fa-solid fa-manat-sign text-[10px]"></i>
                                    </span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Job Description -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
                    <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
                        <i class="fas fa-file-alt text-primary-500 text-sm"></i>
                        Vakansiyanın təsviri
                    </h2>
                    <div class="default-html text-gray-700 leading-relaxed">
                        <%- data.description %>
                    </div>
                </div>

                <!-- Apply Buttons -->
                <div class="flex flex-wrap gap-3">
                    <a href="mailto:<%= data.email %>"
                       class="inline-flex items-center gap-2 bg-primary-500 hover:bg-primary-600 text-white font-medium px-7 py-3.5 rounded-xl transition-all duration-200 shadow-sm hover:shadow-md">
                        <i class="fas fa-paper-plane"></i>
                        Müraciət Et
                    </a>
                    <% if (data.phone) { %>
                        <a href="tel:<%= data.phone %>"
                           class="inline-flex items-center gap-2 bg-white hover:bg-gray-50 text-gray-700 font-medium px-7 py-3.5 rounded-xl border border-gray-200 transition-all duration-200 shadow-sm hover:shadow-md">
                            <i class="fas fa-phone"></i>
                            <%= data.phone %>
                        </a>
                    <% } %>
                </div>

                <!-- Similar Jobs -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
                    <h2 class="text-lg font-bold text-gray-900 mb-4 flex items-center gap-2">
                        <i class="fas fa-briefcase text-primary-500 text-sm"></i>
                        Oxşar Vakansiyalar
                    </h2>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4" id="home-card-section">
                        <div class="col-span-full flex items-center justify-center py-10">
                            <div class="flex flex-col items-center gap-3">
                                <div class="w-6 h-6 border-2 border-primary-500/30 border-t-primary-500 rounded-full animate-spin"></div>
                                <span class="text-gray-400 text-sm">Yüklənir...</span>
                            </div>
                        </div>
                    </div>
                    <div class="text-center mt-6">
                        <a href="/vakansiyalar"
                           class="inline-flex items-center gap-2 bg-white hover:bg-gray-50 text-gray-700 font-medium px-6 py-2.5 rounded-xl border border-gray-200 transition-all duration-200 text-sm">
                            Bütün Vakansiyalar
                            <i class="fas fa-arrow-right text-xs"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- ========== SIDEBAR ========== -->
            <aside class="space-y-6">

                <!-- Company Info Card -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                    <div class="flex items-center gap-4 mb-5 pb-5 border-b border-gray-100">
                        <div class="w-14 h-14 rounded-xl bg-gray-50 border border-gray-100 overflow-hidden flex items-center justify-center flex-shrink-0 shadow-sm">
                            <img src="<%= data.companyImage ? data.companyImage : '/Images/DefaultCompany.png' %>"
                                 alt="<%= data.companyName %>" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/Images/DefaultCompany.png'">
                        </div>
                        <div class="min-w-0">
                            <h3 class="font-semibold text-gray-900 truncate"><%= data.companyName %></h3>
                            <a href="/vakansiyalar?keyword=<%= data.companyName %>"
                               class="text-sm text-primary-500 hover:text-primary-600 transition-colors">
                                Şirkətin bütün vakansiyaları
                            </a>
                        </div>
                    </div>

                    <ul class="space-y-3.5">
                        <li class="flex items-center justify-between">
                            <span class="text-sm text-gray-400">Kategoriya</span>
                            <span class="text-sm font-medium text-gray-900"><%= data.category %></span>
                        </li>
                        <li class="flex items-center justify-between">
                            <span class="text-sm text-gray-400">Maaş</span>
                            <% if (data.minSalary || data.maxSalary) { %>
                                <span class="text-sm font-semibold text-primary-500">
                                    <%= data.minSalary || '' %> <% if (data.minSalary && data.maxSalary) { %>-<% } %> <%= data.maxSalary || '' %>
                                    <i class="fa-solid fa-manat-sign text-[10px]"></i>
                                </span>
                            <% } else { %>
                                <span class="text-sm text-gray-500">Razılaşma yolu ilə</span>
                            <% } %>
                        </li>
                        <li class="flex items-center justify-between">
                            <span class="text-sm text-gray-400">Şəhər</span>
                            <span class="text-sm font-medium text-gray-900"><%= data.location %></span>
                        </li>
                        <li class="flex items-center justify-between">
                            <span class="text-sm text-gray-400">Təhsil</span>
                            <span class="text-sm font-medium text-gray-900"><%= data.education %></span>
                        </li>
                        <li class="flex items-center justify-between">
                            <span class="text-sm text-gray-400">Təcrübə</span>
                            <span class="text-sm font-medium text-gray-900"><%= data.experience %></span>
                        </li>
                        <li class="flex items-center justify-between">
                            <span class="text-sm text-gray-400">Əlaqədar şəxs</span>
                            <span class="text-sm font-medium text-gray-900"><%= data.userName %></span>
                        </li>
                        <% if (data.phone) { %>
                            <li class="flex items-center justify-between">
                                <span class="text-sm text-gray-400">Telefon</span>
                                <span class="text-sm font-medium text-gray-900"><%= data.phone %></span>
                            </li>
                        <% } %>
                        <% if (data.email) { %>
                            <li class="flex items-center justify-between">
                                <span class="text-sm text-gray-400">Email</span>
                                <span class="text-sm font-medium text-gray-900 truncate max-w-[150px]"><%= data.email %></span>
                            </li>
                        <% } %>
                        <% if (data.minAge || data.maxAge) { %>
                            <li class="flex items-center justify-between">
                                <span class="text-sm text-gray-400">Yaş</span>
                                <span class="text-sm font-medium text-gray-900">
                                    <%= data.minAge && data.maxAge ? `${data.minAge}-${data.maxAge} arası` : data.minAge ? `${data.minAge}+` : `-${data.maxAge}` %>
                                </span>
                            </li>
                        <% } %>
                        <li class="flex items-center justify-between pt-2 border-t border-gray-50">
                            <span class="text-sm text-gray-400">Bitmə tarixi</span>
                            <span class="text-sm font-medium text-gray-900">
                                <%= new Date(new Date(data.postedAt).setDate(new Date(data.postedAt).getDate() + 30)).toLocaleString('az-AZ', { day: '2-digit', month: '2-digit', year: 'numeric' }) %>
                            </span>
                        </li>
                    </ul>
                </div>

                <!-- Share Card -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
                    <h3 class="font-semibold text-gray-900 mb-4 flex items-center gap-2">
                        <i class="fas fa-share-alt text-gray-400 text-sm"></i>
                        Paylaş
                    </h3>
                    <div class="flex items-center gap-3">
                        <a href="https://www.facebook.com/sharer/sharer.php?u=<%=data.redirectUrl%>"
                           target="_blank"
                           class="w-10 h-10 flex items-center justify-center rounded-xl bg-blue-50 text-blue-600 hover:bg-blue-100 transition-all hover:scale-105">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                        <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%=data.redirectUrl%>"
                           target="_blank"
                           class="w-10 h-10 flex items-center justify-center rounded-xl bg-blue-50 text-blue-700 hover:bg-blue-100 transition-all hover:scale-105">
                            <i class="fab fa-linkedin-in"></i>
                        </a>
                        <a href="https://wa.me/?text=<%=data.redirectUrl%>"
                           target="_blank"
                           class="w-10 h-10 flex items-center justify-center rounded-xl bg-green-50 text-green-600 hover:bg-green-100 transition-all hover:scale-105">
                            <i class="fab fa-whatsapp"></i>
                        </a>
                        <button id="copyLinkButton"
                                class="w-10 h-10 flex items-center justify-center rounded-xl bg-gray-100 text-gray-600 hover:bg-gray-200 transition-all hover:scale-105">
                            <i class="fa-regular fa-copy"></i>
                        </button>
                    </div>
                </div>

                <!-- Apply Card (Sticky on desktop) -->
                <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 lg:sticky lg:top-28">
                    <a href="mailto:<%= data.email %>"
                       class="block w-full bg-primary-500 hover:bg-primary-600 text-white font-medium py-3.5 px-6 rounded-xl text-center transition-all duration-200 shadow-sm hover:shadow-md">
                        <i class="fas fa-paper-plane mr-2"></i>
                        Müraciət Et
                    </a>
                </div>
            </aside>
        </div>
    </div>
    <input type="hidden" id="categoryId" value="<%= data.categoryId %>">
</section>
