<section class="bg-gray-50 min-h-screen pt-24 pb-16 md:pb-24">
    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Page Header -->
        <div class="flex items-center justify-between mb-6">
            <div>
                <h1 class="text-xl sm:text-2xl font-bold text-gray-900"><%= __('jobs.title') %></h1>
                <p class="text-gray-500 text-sm mt-0.5"><%= __('jobs.subtitle') %></p>
            </div>
        </div>

        <!-- ============================================ -->
        <!-- DESKTOP LAYOUT: SIDEBAR + CONTENT -->
        <!-- ============================================ -->
        <div class="flex flex-col lg:flex-row gap-6">

            <!-- ========== DESKTOP SIDEBAR ========== -->
            <aside class="hidden lg:block lg:w-[280px] lg:flex-shrink-0">
                <div class="bg-white rounded-lg border border-gray-200 p-5 lg:sticky lg:top-28">
                    <div class="flex items-center justify-between mb-4 pb-3 border-b border-gray-100">
                        <h3 class="font-semibold text-gray-900 text-sm flex items-center gap-2">
                            <i class="fas fa-sliders-h text-primary-500 text-xs"></i>
                            <%= __('jobs.filters') %>
                        </h3>
                        <button id="clearFilters" class="text-xs text-gray-400 hover:text-gray-600 transition-colors"><%= __('jobs.clear') %></button>
                    </div>
                    <!-- Desktop filter content -->
                    <%- include('../Partials/FilterContent') %>
                </div>
            </aside>

            <!-- ========== JOB LISTINGS ========== -->
            <div class="flex-1 min-w-0">
                <!-- Results Count & Mobile Filter Button -->
                <div class="flex items-center justify-between mb-4">
                    <p class="text-sm text-gray-500">
                        <span id="job-count"><%= typeof totalCount !== 'undefined' ? totalCount : 0 %></span> <%= __('jobs.results') %>
                    </p>
                    <button id="mobile-filter-btn"
                            class="lg:hidden inline-flex items-center gap-2 text-sm font-medium text-gray-700 bg-white border border-gray-200 px-3 py-2 rounded-lg hover:bg-gray-50 transition-all">
                        <i class="fas fa-sliders-h text-primary-500"></i>
                        <%= __('jobs.filters') %>
                        <span class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-primary-500 text-white text-[10px] font-bold" id="active-filter-count">0</span>
                    </button>
                </div>

                <!-- Cards Container -->
                <div id="card-section" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <% if (typeof jobs !== 'undefined' && jobs.length > 0) { %>
                        <% var defaultLogo = "../Images/DefaultCompany.png"; %>
                        <% jobs.forEach(function(el) { %>
                            <% var logoUrl = defaultLogo; %>
                            <% if (el.companyImageUrl && el.companyImageUrl !== "/nologo.png") { %>
                                <% if (el.companyImageUrl.startsWith('http')) { logoUrl = el.companyImageUrl; } %>
                                <% else if (el.companyImageUrl.startsWith('/uploads/')) { logoUrl = el.companyImageUrl; } %>
                                <% else if (el.companyImageUrl.includes('src/Public/')) { logoUrl = '../' + el.companyImageUrl.slice(el.companyImageUrl.indexOf('src/Public/') + 11); } %>
                                <% else { logoUrl = el.companyImageUrl.replace(/\\/g, '/'); } %>
                            <% } %>
                            <% var hasMin = el.minSalary != null && !isNaN(+el.minSalary) && +el.minSalary > 0; %>
                            <% var hasMax = el.maxSalary != null && !isNaN(+el.maxSalary) && +el.maxSalary > 0; %>
                            <% var salaryText = ''; %>
                            <% if (hasMin || hasMax) { %>
                                <% if (hasMin && hasMax && +el.minSalary === +el.maxSalary) { %>
                                    <% salaryText = (+el.minSalary) + ' ' + el.currencySign; %>
                                <% } else { %>
                                    <% salaryText = (hasMin ? +el.minSalary : '') + (hasMin && hasMax ? ' - ' : '') + (hasMax ? +el.maxSalary + ' ' + el.currencySign : ''); %>
                                <% } %>
                            <% } else { %>
                                <% salaryText = 'Razılaşma Yolu ilə'; %>
                            <% } %>
                            <% var detailLink = el.redirectUrl && el.redirectUrl !== '#' ? el.redirectUrl : '/vakansiyalar/' + encodeURIComponent(el.slug || el.uniqueKey || el._id) + '/details'; %>
                            <% var postedDate = el.postedAt ? el.postedAt.slice(0, 10) : ''; %>
                            <% var title = el.title; %>
                            <% var companyName = el.companyName; %>
                            <% var location = el.location || 'Azərbaycan'; %>
                            <% var imgError = "this.onerror=null;this.src='" + defaultLogo + "'"; %>
                            <div class="job-card group bg-white rounded-xl p-6 cursor-pointer transition-all duration-200 hover:shadow-lg hover:-translate-y-1 border border-gray-300" role="button" tabindex="0" aria-label="<%= title %> - <%= companyName %>" data-original-link="<%= detailLink %>">
                                <div class="flex gap-5">
                                    <div class="w-16 h-16 rounded-xl bg-gray-50 border border-gray-100 flex-shrink-0 overflow-hidden flex items-center justify-center shadow-sm">
                                        <img src="<%= logoUrl %>" alt="<%= companyName %>" class="w-full h-full object-cover" onerror="<%= imgError %>">
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <div class="flex items-start justify-between gap-3 mb-1">
                                            <div class="min-w-0">
                                                <h3 class="text-lg font-bold text-gray-900 leading-snug line-clamp-2"><%= title %></h3>
                                                <p class="text-base text-gray-500 mt-1 font-medium"><%= companyName %></p>
                                            </div>
                                            <% if (salaryText) { %>
                                                <span class="text-sm font-semibold text-primary-500 whitespace-nowrap flex-shrink-0"><%= salaryText %></span>
                                            <% } %>
                                        </div>
                                        <div class="flex items-center gap-4 text-sm text-gray-400 mt-3">
                                            <span><i class="far fa-calendar mr-1.5"></i><%= postedDate %></span>
                                            <span><i class="fas fa-map-marker-alt mr-1.5"></i><%= location %></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }); %>
                    <% } else { %>
                        <div class="col-span-full flex items-center justify-center min-h-[300px] bg-white rounded-lg border border-gray-200">
                            <div class="flex flex-col items-center gap-2">
                                <div class="w-6 h-6 border-2 border-primary-500/30 border-t-primary-500 rounded-full animate-spin"></div>
                                <span class="text-gray-400 text-sm"><%= __('jobs.loading') %></span>
                            </div>
                        </div>
                    <% } %>
                    <% if (typeof totalCount !== 'undefined' && totalCount > 100 && typeof jobs !== 'undefined' && jobs.length > 0) { %>
                        <div class="col-span-full flex items-center justify-center mt-6">
                            <button class="inline-flex items-center gap-2 bg-white hover:bg-gray-50 text-gray-700 font-medium px-6 py-3 rounded-xl border border-gray-200 transition-all shadow-sm hover:shadow-md active:scale-[0.98]" id="load-more-btn">
                                Daha Çox <i class="fas fa-chevron-down text-xs"></i>
                            </button>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- ============================================ -->
    <!-- MOBILE FILTER BOTTOM SHEET -->
    <!-- ============================================ -->
    <div id="mobile-filter-overlay" class="fixed inset-0 bg-black/50 backdrop-blur-sm z-[60] hidden lg:!hidden">
        <!-- Backdrop click zone covers entire screen -->
        <div id="mobile-filter-backdrop" class="absolute inset-0"></div>

        <!-- Bottom Sheet Panel -->
        <div id="mobile-filter-sheet"
             class="absolute bottom-0 left-0 right-0 bg-white rounded-t-xl shadow-lg max-h-[85vh] flex flex-col transform translate-y-full transition-transform duration-300 ease-out">

            <!-- Sheet Handle -->
            <div class="flex justify-center pt-2 pb-1 flex-shrink-0">
                <div class="w-8 h-1 rounded-full bg-gray-300"></div>
            </div>

            <!-- Sheet Header -->
            <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100 flex-shrink-0">
                <h3 class="font-semibold text-gray-900 text-sm flex items-center gap-2">
                    <i class="fas fa-sliders-h text-primary-500 text-xs"></i>
                    <%= __('jobs.filters') %>
                </h3>
                <div class="flex items-center gap-2">
                    <button id="mobile-clear-filters" class="text-xs text-gray-400 hover:text-gray-600 transition-colors"><%= __('jobs.clear') %></button>
                    <button id="mobile-filter-close" class="w-7 h-7 flex items-center justify-center rounded-md bg-gray-100 text-gray-500 hover:bg-gray-200 transition-colors">
                        <i class="fas fa-times text-xs"></i>
                    </button>
                </div>
            </div>

            <!-- Sheet Body -->
            <div class="flex-1 overflow-y-auto px-4 py-4 custom-scroll">
                <%- include('../Partials/FilterContent', { prefix: 'mobile-' }) %>
            </div>

            <!-- Sheet Footer -->
            <div class="p-4 border-t border-gray-100 flex-shrink-0">
                <button id="mobile-apply-filters"
                        class="w-full bg-primary-500 hover:bg-primary-600 text-white font-medium px-5 py-2.5 rounded-lg transition-all text-sm">
                    <i class="fas fa-search mr-2"></i>
                    <%= __('jobs.showResults') %>
                </button>
            </div>
        </div>
    </div>
</section>
