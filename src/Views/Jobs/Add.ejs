<section class="min-h-screen bg-gray-50 pt-24 md:pt-28 pb-16 md:pb-20">
    <div class="max-w-4xl mx-auto px-3 sm:px-4 lg:px-6">
        <!-- Page Header -->
        <div class="text-center mb-8 animate-fade-in-up">
            <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mb-3">Yeni Elan</h1>
            <p class="text-gray-500 text-lg">Vakansiyanızı paylaşın, namizədlər sizi tapsın</p>
        </div>

        <!-- Warning Banner: shown to unauthenticated users and user-role users -->
        <% if (!user || user.role === 'user') { %>
        <div id="company-warning-banner" class="mb-8 animate-fade-in-up">
            <div class="flex items-start gap-3 p-4 bg-amber-50 border border-amber-200 rounded-xl text-amber-800">
                <div class="flex-shrink-0 mt-0.5">
                    <i class="fas fa-lightbulb text-amber-500"></i>
                </div>
                <div class="flex-1 text-sm">
                    <p class="font-medium">Daha yaxşı təcrübə üçün şirkət hesabı yaradın</p>
                    <p class="text-amber-700 mt-1">Şirkət hesabı ilə vakansiyalarınızı idarə edə, statistikaları izləyə və daha peşəkar görünə bilərsiniz.</p>
                    <% if (!user) { %>
                    <a href="/auth" class="inline-flex items-center gap-1 mt-2 text-amber-600 hover:text-amber-700 font-medium underline underline-offset-2">
                        <i class="fas fa-user-plus text-xs"></i> Qeydiyyatdan keç <i class="fas fa-arrow-right text-xs"></i>
                    </a>
                    <% } %>
                </div>
                <button type="button" onclick="this.closest('#company-warning-banner').remove()" class="flex-shrink-0 text-amber-400 hover:text-amber-600 transition-colors">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>
        <% } %>

        <!-- Global Error -->
        <div id="form-error" class="hidden mb-6 animate-fade-in-up">
            <div class="flex items-start gap-3 p-4 bg-red-50 border border-red-200 rounded-xl text-red-700">
                <div class="flex-shrink-0 mt-0.5"><i class="fas fa-exclamation-circle"></i></div>
                <div class="flex-1 text-sm" id="form-error-text"></div>
                <button type="button" onclick="this.closest('#form-error').classList.add('hidden')" class="flex-shrink-0 text-red-400 hover:text-red-600 transition-colors">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>

        <!-- Form Card -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8 lg:p-10 animate-fade-in-up">

            <!-- ============================================================ -->
            <!-- CONTACT INFO SECTION -->
            <!-- ============================================================ -->
            <div class="mb-10">
                <div class="flex items-center gap-3 mb-6 pb-4 border-b border-gray-100">
                    <div class="w-10 h-10 rounded-xl bg-primary-50 flex items-center justify-center text-primary-500">
                        <i class="fas fa-user"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-semibold text-gray-900">Əlaqə Məlumatları</h2>
                        <p class="text-sm text-gray-500">İş elanı üçün əlaqə məlumatlarınızı daxil edin. <span class="text-amber-600 font-medium">Email və ya Telefon mütləq qeyd olunmalıdır.</span></p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <!-- Email -->
                    <div>
                        <label for="email" class="block text-sm font-medium text-gray-700 mb-1.5">
                            Email
                        </label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
                                <i class="fas fa-envelope"></i>
                            </span>
                            <input id="email" type="email" placeholder="Emailinizi daxil edin"
                                   value="<%= companyInfo ? companyInfo.email : '' %>"
                                   <%= companyInfo ? 'disabled' : '' %>
                                   class="w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 placeholder:text-gray-400 <%= companyInfo ? 'opacity-75 cursor-not-allowed' : '' %>">
                        </div>
                        <span id="email-error" class="error-message text-red-500 text-xs mt-1.5 hidden flex items-center gap-1">
                            <i class="fas fa-exclamation-circle"></i>
                            <span class="error-text">Bu xana doldurulmalıdır</span>
                        </span>
                    </div>

                    <!-- Username -->
                    <div>
                        <label for="username" class="block text-sm font-medium text-gray-700 mb-1.5">
                            Əlaqədar Şəxs <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
                                <i class="fas fa-user"></i>
                            </span>
                            <input id="username" type="text" placeholder="Adınızı daxil edin"
                                   value="<%= companyInfo ? (typeof user !== 'undefined' && user ? user.name || user.surname || '' : '') : '' %>"
                                   <%= companyInfo ? 'disabled' : '' %>
                                   class="w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 placeholder:text-gray-400 <%= companyInfo ? 'opacity-75 cursor-not-allowed' : '' %>">
                        </div>
                        <span id="username-error" class="error-message text-red-500 text-xs mt-1.5 hidden flex items-center gap-1">
                            <i class="fas fa-exclamation-circle"></i>
                            <span class="error-text">Bu xana doldurulmalıdır</span>
                        </span>
                    </div>

                    <!-- Phone -->
                    <div>
                        <label for="phone" class="block text-sm font-medium text-gray-700 mb-1.5">
                            Telefon Nömrəsi
                        </label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
                                <i class="fas fa-phone"></i>
                            </span>
                            <input id="phone" type="tel" placeholder="Telefon nömrəsi"
                                   value="<%= companyInfo ? companyInfo.phone : '' %>"
                                   <%= companyInfo ? 'disabled' : '' %>
                                   class="w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 placeholder:text-gray-400 <%= companyInfo ? 'opacity-75 cursor-not-allowed' : '' %>">
                        </div>
                        <span id="phone-error" class="error-message text-red-500 text-xs mt-1.5 hidden flex items-center gap-1">
                            <i class="fas fa-exclamation-circle"></i>
                            <span class="error-text">Bu xana doldurulmalıdır</span>
                        </span>
                    </div>

                    <!-- Application Method -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1.5">Müraciət üsulu</label>
                        <div class="flex gap-3 h-full items-center pt-1">
                            <label class="flex items-center gap-2 px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl cursor-pointer hover:border-primary-300 hover:bg-primary-50/30 transition-all has-[:checked]:border-primary-500 has-[:checked]:bg-primary-50/50 has-[:checked]:ring-2 has-[:checked]:ring-primary-500/20 flex-1">
                                <input type="radio" name="applicationMethod" value="both" checked class="accent-primary-500">
                                <div>
                                    <span class="text-sm font-medium text-gray-700">Hər ikisi</span>
                                    <p class="text-xs text-gray-400">CV + Email/Telefon</p>
                                </div>
                            </label>
                            <label class="flex items-center gap-2 px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl cursor-pointer hover:border-primary-300 hover:bg-primary-50/30 transition-all has-[:checked]:border-primary-500 has-[:checked]:bg-primary-50/50 has-[:checked]:ring-2 has-[:checked]:ring-primary-500/20 flex-1">
                                <input type="radio" name="applicationMethod" value="contact" class="accent-primary-500">
                                <div>
                                    <span class="text-sm font-medium text-gray-700">Yalnız əlaqə</span>
                                    <p class="text-xs text-gray-400">Email / Telefon</p>
                                </div>
                            </label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- COMPANY INFO SECTION -->
            <!-- ============================================================ -->
            <div class="mb-10">
                <div class="flex items-center gap-3 mb-6 pb-4 border-b border-gray-100">
                    <div class="w-10 h-10 rounded-xl bg-primary-50 flex items-center justify-center text-primary-500">
                        <i class="fas fa-building"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-semibold text-gray-900">Şirkət Məlumatları</h2>
                        <p class="text-sm text-gray-500">Şirkətiniz haqqında məlumatları daxil edin</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <!-- Company Name -->
                    <div>
                        <label for="companyName" class="block text-sm font-medium text-gray-700 mb-1.5">
                            Şirkət Adı <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
                                <i class="fas fa-building"></i>
                            </span>
                            <input id="companyName" type="text" placeholder="Şirkət adı"
                                   value="<%= companyInfo ? companyInfo.companyName : '' %>"
                                   <%= companyInfo ? 'disabled' : '' %>
                                   class="w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 placeholder:text-gray-400 <%= companyInfo ? 'opacity-75 cursor-not-allowed' : '' %>">
                        </div>
                        <span id="companyName-error" class="error-message text-red-500 text-xs mt-1.5 hidden flex items-center gap-1">
                            <i class="fas fa-exclamation-circle"></i>
                            <span class="error-text">Bu xana doldurulmalıdır</span>
                        </span>
                    </div>

                    <!-- Company Image -->
                    <div>
                        <label for="companyImage" class="block text-sm font-medium text-gray-700 mb-1.5">Şirkət Rəsmi</label>
                        <div class="relative">
                            <label for="companyImage"
                                   class="flex items-center gap-3 w-full px-4 py-3.5 bg-gray-50 border border-gray-200 border-dashed rounded-xl cursor-pointer hover:border-primary-500 hover:bg-primary-50/20 transition-all duration-200">
                                <div class="w-10 h-10 rounded-lg bg-gray-200 flex items-center justify-center text-gray-500">
                                    <i class="fas fa-cloud-upload-alt"></i>
                                </div>
                                <div>
                                    <p class="text-sm font-medium text-gray-700">Şəkil seçin</p>
                                    <p class="text-xs text-gray-400">PNG, JPG max 5MB</p>
                                </div>
                            </label>
                            <input id="companyImage" type="file" accept="image/*" class="hidden">
                        </div>
                    </div>
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- JOB DETAILS SECTION -->
            <!-- ============================================================ -->
            <div class="mb-10">
                <div class="flex items-center gap-3 mb-6 pb-4 border-b border-gray-100">
                    <div class="w-10 h-10 rounded-xl bg-primary-50 flex items-center justify-center text-primary-500">
                        <i class="fas fa-briefcase"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-semibold text-gray-900">Vakansiya Detalları</h2>
                        <p class="text-sm text-gray-500">İş elanı məlumatlarını daxil edin</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <!-- Category -->
                    <div>
                        <label for="category" class="block text-sm font-medium text-gray-700 mb-1.5">
                            Kategoriya <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
                                <i class="fas fa-tag"></i>
                            </span>
                            <select id="category"
                                    class="w-full pl-11 pr-10 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 appearance-none cursor-pointer">
                                <option value="" disabled selected>Kategoriyanı seçin</option>
                            </select>
                            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">
                                <i class="fas fa-chevron-down text-xs"></i>
                            </span>
                        </div>
                        <span id="category-error" class="error-message text-red-500 text-xs mt-1.5 hidden flex items-center gap-1">
                            <i class="fas fa-exclamation-circle"></i>
                            <span class="error-text">Kategoriya seçilməlidir</span>
                        </span>
                    </div>

                    <!-- City -->
                    <div>
                        <label for="city" class="block text-sm font-medium text-gray-700 mb-1.5">
                            Şəhər <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
                                <i class="fas fa-map-marker-alt"></i>
                            </span>
                            <select id="city"
                                    class="w-full pl-11 pr-10 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 appearance-none cursor-pointer">
                                <option value="" disabled selected>Şəhəri seçin</option>
                            </select>
                            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">
                                <i class="fas fa-chevron-down text-xs"></i>
                            </span>
                        </div>
                        <span id="city-error" class="error-message text-red-500 text-xs mt-1.5 hidden flex items-center gap-1">
                            <i class="fas fa-exclamation-circle"></i>
                            <span class="error-text">Şəhər seçilməlidir</span>
                        </span>
                    </div>

                    <!-- Position -->
                    <div>
                        <label for="position" class="block text-sm font-medium text-gray-700 mb-1.5">
                            Vakansiyanın adı <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
                                <i class="fas fa-briefcase"></i>
                            </span>
                            <input id="position" type="text" placeholder="Vəzifəni daxil edin"
                                   class="w-full pl-11 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 placeholder:text-gray-400">
                        </div>
                        <span id="position-error" class="error-message text-red-500 text-xs mt-1.5 hidden flex items-center gap-1">
                            <i class="fas fa-exclamation-circle"></i>
                            <span class="error-text">Vakansiya adı daxil edilməlidir</span>
                        </span>
                    </div>

                    <!-- Education -->
                    <div>
                        <label for="education" class="block text-sm font-medium text-gray-700 mb-1.5">
                            Təhsil <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
                                <i class="fas fa-graduation-cap"></i>
                            </span>
                            <select id="education"
                                    class="w-full pl-11 pr-10 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 appearance-none cursor-pointer">
                                <option value="" disabled selected>Təhsili seçin</option>
                            </select>
                            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">
                                <i class="fas fa-chevron-down text-xs"></i>
                            </span>
                        </div>
                        <span id="education-error" class="error-message text-red-500 text-xs mt-1.5 hidden flex items-center gap-1">
                            <i class="fas fa-exclamation-circle"></i>
                            <span class="error-text">Təhsil seçilməlidir</span>
                        </span>
                    </div>

                    <!-- Experience -->
                    <div>
                        <label for="experience" class="block text-sm font-medium text-gray-700 mb-1.5">
                            Təcrübə <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
                                <i class="fas fa-briefcase"></i>
                            </span>
                            <select id="experience"
                                    class="w-full pl-11 pr-10 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900 appearance-none cursor-pointer">
                                <option value="" disabled selected>Təcrübə səviyyəsini seçin</option>
                            </select>
                            <span class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">
                                <i class="fas fa-chevron-down text-xs"></i>
                            </span>
                        </div>
                        <span id="experience-error" class="error-message text-red-500 text-xs mt-1.5 hidden flex items-center gap-1">
                            <i class="fas fa-exclamation-circle"></i>
                            <span class="error-text">Təcrübə səviyyəsi seçilməlidir</span>
                        </span>
                    </div>
                </div>
            </div>

            <!-- ============================================================ -->
            <!-- SALARY & AGE SECTION -->
            <!-- ============================================================ -->
            <div class="mb-10">
                <div class="flex items-center gap-3 mb-6 pb-4 border-b border-gray-100">
                    <div class="w-10 h-10 rounded-xl bg-primary-50 flex items-center justify-center text-primary-500">
                        <i class="fas fa-coins"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-semibold text-gray-900">Maaş və Yaş</h2>
                        <p class="text-sm text-gray-500">Rəqəmsal məlumatları daxil edin</p>
                    </div>
                </div>

                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-3">
                    <!-- Min Salary -->
                    <div>
                        <label for="minSalary" class="block text-sm font-medium text-gray-700 mb-1.5">Minimum Maaş</label>
                        <div class="relative">
                            <input id="minSalary" type="number" placeholder="AZN" min="0"
                                   class="w-full pl-4 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900">
                        </div>
                        <span id="minSalary-error" class="error-message text-red-500 text-xs mt-1.5 hidden flex items-center gap-1">
                            <i class="fas fa-exclamation-circle"></i>
                            <span class="error-text"></span>
                        </span>
                    </div>

                    <!-- Max Salary -->
                    <div>
                        <label for="maxSalary" class="block text-sm font-medium text-gray-700 mb-1.5">Maksimum Maaş</label>
                        <div class="relative">
                            <input id="maxSalary" type="number" placeholder="AZN" min="0"
                                   class="w-full pl-4 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900">
                        </div>
                        <span id="maxSalary-error" class="error-message text-red-500 text-xs mt-1.5 hidden flex items-center gap-1">
                            <i class="fas fa-exclamation-circle"></i>
                            <span class="error-text"></span>
                        </span>
                    </div>

                    <!-- Min Age -->
                    <div>
                        <label for="minAge" class="block text-sm font-medium text-gray-700 mb-1.5">Minimum Yaş</label>
                        <div class="relative">
                            <input id="minAge" type="number" placeholder="Yaş" min="16" max="80"
                                   class="w-full pl-4 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900">
                        </div>
                        <span id="minAge-error" class="error-message text-red-500 text-xs mt-1.5 hidden flex items-center gap-1">
                            <i class="fas fa-exclamation-circle"></i>
                            <span class="error-text"></span>
                        </span>
                    </div>

                    <!-- Max Age -->
                    <div>
                        <label for="maxAge" class="block text-sm font-medium text-gray-700 mb-1.5">Maksimum Yaş</label>
                        <div class="relative">
                            <input id="maxAge" type="number" placeholder="Yaş" min="16" max="80"
                                   class="w-full pl-4 pr-4 py-3.5 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-primary-500/20 focus:border-primary-500 transition-all duration-200 text-gray-900">
                        </div>
                        <span id="maxAge-error" class="error-message text-red-500 text-xs mt-1.5 hidden flex items-center gap-1">
                            <i class="fas fa-exclamation-circle"></i>
                            <span class="error-text"></span>
                        </span>
                    </div>
                </div>

                <!-- Salary Negotiable Checkbox -->
                <div id="salary-toggle-container" class="flex items-center gap-3 p-4 bg-gray-50 border border-gray-200 rounded-xl transition-all duration-200">
                    <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="salaryNegotiable" class="sr-only peer">
                        <div class="w-11 h-6 bg-gray-300 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-primary-500/30 rounded-full peer peer-checked:bg-primary-500 peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all after:duration-200"></div>
                    </label>
                    <div>
                        <span id="salary-toggle-label" class="text-sm font-medium text-gray-700 transition-colors duration-200">Maaş razılaşma yolu ilə</span>
                        <p class="text-xs text-gray-400">Bu qeyd edilərsə, maaş aralığı göstərilməyəcək</p>
                    </div>
                </div>

                <span id="salary-error" class="error-message text-red-500 text-xs mt-3 hidden flex items-center gap-1">
                    <i class="fas fa-exclamation-circle"></i> <span class="error-text">Ən azı bir maaş dəyəri daxil edilməlidir</span>
                </span>
            </div>

            <!-- ============================================================ -->
            <!-- DESCRIPTION SECTION -->
            <!-- ============================================================ -->
            <div class="mb-8">
                <div class="flex items-center gap-3 mb-6 pb-4 border-b border-gray-100">
                    <div class="w-10 h-10 rounded-xl bg-primary-50 flex items-center justify-center text-primary-500">
                        <i class="fas fa-file-alt"></i>
                    </div>
                    <div>
                        <h2 class="text-lg font-semibold text-gray-900">Mətn Məlumatları</h2>
                        <p class="text-sm text-gray-500">Vakansiya təsviri və tələblər</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <!-- About Job -->
                    <div>
                        <label for="aboutJob" class="block text-sm font-medium text-gray-700 mb-1.5">
                            İş Haqqında Məlumat <span class="text-red-500">*</span>
