<section class="min-h-screen bg-gradient-to-b from-gray-50 to-white pt-24 md:pt-28 pb-20">
    <div class="max-w-5xl mx-auto px-3 sm:px-4 lg:px-6">
        <!-- Breadcrumb -->
        <nav class="flex items-center gap-2 text-sm text-gray-400 mb-6 animate-fade-in-down">
            <a href="/" class="hover:text-primary-500 transition-colors">Ana Səhifə</a>
            <i class="fas fa-chevron-right text-[10px]"></i>
            <a href="/sirketler" class="hover:text-primary-500 transition-colors">Şirkətlər</a>
            <i class="fas fa-chevron-right text-[10px]"></i>
            <span class="text-gray-600 truncate max-w-[200px]" id="company-name-breadcrumb">Şirkət</span>
        </nav>

        <!-- Company Hero -->
        <div id="company-hero" class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden mb-6 animate-fade-in-up">
            <div class="h-2 bg-gradient-to-r from-primary-400 via-primary-500 to-primary-600"></div>
            <div class="p-6 sm:p-8 text-center">
                <div class="w-20 h-20 sm:w-24 sm:h-24 mx-auto rounded-2xl bg-gradient-to-br from-gray-50 to-gray-100 border border-gray-100 overflow-hidden flex items-center justify-center shadow-sm ring-1 ring-black/5 mb-4">
                    <img id="company-logo" src="/Images/DefaultCompany.png" alt="" class="w-full h-full object-cover" onerror="this.onerror=null;this.src='/Images/DefaultCompany.png'">
                </div>
                <h1 id="company-name" class="text-2xl sm:text-3xl font-bold text-gray-900"></h1>
                <p id="company-website" class="text-primary-500 hover:text-primary-600 text-sm mt-1"></p>
                <p id="company-jobs-count" class="text-gray-400 text-sm mt-2"></p>
            </div>
        </div>

        <!-- Vacancies -->
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden animate-fade-in-up" style="animation-delay: 100ms;">
            <div class="px-6 py-5 border-b border-gray-100">
                <h2 class="text-lg font-semibold text-gray-900">Vakansiyalar</h2>
            </div>
            <div id="company-jobs">
                <div class="text-center py-12">
                    <div class="w-8 h-8 border-2 border-primary-500/30 border-t-primary-500 rounded-full animate-spin mx-auto"></div>
                </div>
            </div>
        </div>
    </div>
</section>
