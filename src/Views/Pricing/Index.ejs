<!-- ===== TAB FILTER ===== -->
<section class="pt-12 pb-2 bg-white">
  <div class="max-w-[1000px] mx-auto px-3 sm:px-4 lg:px-6">
    <div class="flex justify-center gap-2 mt-8 mb-8">
      <button onclick="switchPricingTab('daily')" id="pricingTabDaily" class="px-6 py-2 rounded-full text-sm font-medium bg-primary-500 text-white shadow-sm transition-all duration-200">Günlük</button>
      <button onclick="switchPricingTab('monthly')" id="pricingTabMonthly" class="px-6 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 transition-all duration-200">Aylıq</button>
    </div>

    <% if (!hasDaily && !hasMonthly) { %>
    <div class="text-center py-16">
      <div class="text-5xl text-gray-200 mb-4"><i class="fas fa-tag"></i></div>
      <p class="text-gray-400">Hələ ki, heç bir plan mövcud deyil</p>
    </div>
    <% } %>

    <!-- ===== DAILY SECTION ===== -->
    <div id="pricingDailySection" class="<%= !hasDaily ? 'hidden' : '' %>">
      <% if (promoteDaily && promoteDaily.length > 0) { %>
      <div class="text-center mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-100 text-amber-700 text-xs font-semibold mb-4">
          <i class="fas fa-rocket"></i> İrəli Çək
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3">Vakansiyanızı İrəli Çəkin</h2>
        <p class="text-gray-500 max-w-xl mx-auto">
          İrəli çəkmə planı ilə vakansiyanız müntəzəm olaraq vakansiyalar siyahısında yuxarı qaldırılır.
          Günlük plan 1 gün müddətində keçərlidir.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-2xl mx-auto mb-16">
        <% promoteDaily.forEach(function(plan) { %>
          <%- include('_Card', { plan, accent: 'from-amber-400 to-orange-500', icon: 'fa-rocket', iconBg: 'bg-amber-100 text-amber-600', btnGrad: 'from-amber-500 to-orange-500', badge: null }) %>
        <% }); %>
      </div>
      <% } %>

      <hr class="border-gray-200 mb-16">

      <% if (premiumDaily && premiumDaily.length > 0) { %>
      <div class="text-center mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-purple-100 text-purple-700 text-xs font-semibold mb-4">
          <i class="fas fa-crown"></i> Premium
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3">Vakansiyanızı Premium Edin</h2>
        <p class="text-gray-500 max-w-xl mx-auto">
          Premium planı ilə vakansiyanız premium elanlar kateqoriyasında xüsusi olaraq göstərilir
          və <strong>"Premium" nişanı</strong> ilə qeyd olunur.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-2xl mx-auto">
        <% premiumDaily.forEach(function(plan) { %>
          <%- include('_Card', { plan, accent: 'from-purple-400 to-indigo-500', icon: 'fa-crown', iconBg: 'bg-purple-100 text-purple-600', btnGrad: 'from-purple-500 to-indigo-500', badge: 'Premium' }) %>
        <% }); %>
      </div>
      <% } %>
    </div>

    <!-- ===== MONTHLY SECTION ===== -->
    <div id="pricingMonthlySection" class="hidden">
      <% if (promoteMonthly && promoteMonthly.length > 0) { %>
      <div class="text-center mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-amber-100 text-amber-700 text-xs font-semibold mb-4">
          <i class="fas fa-rocket"></i> İrəli Çək
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3">Vakansiyanızı İrəli Çəkin</h2>
        <p class="text-gray-500 max-w-xl mx-auto">
          İrəli çəkmə planı ilə vakansiyanız müntəzəm olaraq vakansiyalar siyahısında yuxarı qaldırılır.
          Aylıq planlarda <strong>hər 4 gündən bir (ayda 8 dəfə)</strong> irəli çəkilir.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-2xl mx-auto mb-16">
        <% promoteMonthly.forEach(function(plan) { %>
          <%- include('_Card', { plan, accent: 'from-amber-400 to-orange-500', icon: 'fa-rocket', iconBg: 'bg-amber-100 text-amber-600', btnGrad: 'from-amber-500 to-orange-500', badge: null }) %>
        <% }); %>
      </div>
      <% } %>

      <hr class="border-gray-200 mb-16">

      <% if (premiumMonthly && premiumMonthly.length > 0) { %>
      <div class="text-center mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-purple-100 text-purple-700 text-xs font-semibold mb-4">
          <i class="fas fa-crown"></i> Premium
        </div>
        <h2 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-3">Vakansiyanızı Premium Edin</h2>
        <p class="text-gray-500 max-w-xl mx-auto">
          Premium planı ilə vakansiyanız premium elanlar kateqoriyasında xüsusi olaraq göstərilir
          və <strong>"Premium" nişanı</strong> ilə qeyd olunur.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-2xl mx-auto">
        <% premiumMonthly.forEach(function(plan) { %>
          <%- include('_Card', { plan, accent: 'from-purple-400 to-indigo-500', icon: 'fa-crown', iconBg: 'bg-purple-100 text-purple-600', btnGrad: 'from-purple-500 to-indigo-500', badge: 'Premium' }) %>
        <% }); %>
      </div>
      <% } %>
    </div>
  </div>
</section>

<!-- ===== FAQ SECTION ===== -->
<section class="py-12 sm:py-14 bg-gray-50/60">
  <div class="max-w-[1000px] mx-auto px-3 sm:px-4 lg:px-6">
    <div class="text-center mb-8">
      <h2 class="text-xl sm:text-2xl font-bold text-gray-900">Tez-tez Verilən Suallar</h2>
    </div>
    <div class="max-w-2xl mx-auto space-y-3">
      <details class="bg-white rounded-xl border border-gray-200 p-4 group open:border-primary-200 open:ring-1 open:ring-primary-100">
        <summary class="flex items-center justify-between cursor-pointer font-medium text-gray-900 list-none text-sm">
          <span>İrəli çəkmək nə deməkdir?</span>
          <i class="fas fa-chevron-down text-gray-400 text-xs transition-transform group-open:rotate-180 ml-2 flex-shrink-0"></i>
        </summary>
        <p class="mt-2 text-sm text-gray-500 leading-relaxed">
          İrəli çəkmə planı vakansiyanızın vakansiyalar siyahısında yuxarı qaldırılmasını təmin edir.
          Aylıq planlarda hər 4 gündən bir olmaqla ayda 8 dəfə irəli çəkilir.
        </p>
      </details>
      <details class="bg-white rounded-xl border border-gray-200 p-4 group open:border-primary-200 open:ring-1 open:ring-primary-100">
        <summary class="flex items-center justify-between cursor-pointer font-medium text-gray-900 list-none text-sm">
          <span>Premium etmək nə deməkdir?</span>
          <i class="fas fa-chevron-down text-gray-400 text-xs transition-transform group-open:rotate-180 ml-2 flex-shrink-0"></i>
        </summary>
        <p class="mt-2 text-sm text-gray-500 leading-relaxed">
          Premium planı vakansiyanızı premium elanlar kateqoriyasında göstərir,
          əsas səhifədə xüsusi bölmədə nümayiş etdirir və "Premium" nişanı əlavə edir.
        </p>
      </details>
      <details class="bg-white rounded-xl border border-gray-200 p-4 group open:border-primary-200 open:ring-1 open:ring-primary-100">
        <summary class="flex items-center justify-between cursor-pointer font-medium text-gray-900 list-none text-sm">
          <span>Ödəniş necə həyata keçirilir?</span>
          <i class="fas fa-chevron-down text-gray-400 text-xs transition-transform group-open:rotate-180 ml-2 flex-shrink-0"></i>
        </summary>
        <p class="mt-2 text-sm text-gray-500 leading-relaxed">
          Plan seçib müraciət etdikdən sonra admin sizinlə əlaqə saxlayır.
          Ödəniş və aktivləşdirmə admin tərəfindən idarə olunur.
        </p>
      </details>
      <details class="bg-white rounded-xl border border-gray-200 p-4 group open:border-primary-200 open:ring-1 open:ring-primary-100">
        <summary class="flex items-center justify-between cursor-pointer font-medium text-gray-900 list-none text-sm">
          <span>Eyni anda həm irəli çək, həm premium?</span>
          <i class="fas fa-chevron-down text-gray-400 text-xs transition-transform group-open:rotate-180 ml-2 flex-shrink-0"></i>
        </summary>
        <p class="mt-2 text-sm text-gray-500 leading-relaxed">
          Bəli, eyni vakansiya üçün həm irəli çəkmə, həm də premium planından eyni anda istifadə edə bilərsiniz.
        </p>
      </details>
    </div>
  </div>
</section>


<script>
function switchPricingTab(tab) {
  var dailySection = document.getElementById('pricingDailySection');
  var monthlySection = document.getElementById('pricingMonthlySection');
  var tabDaily = document.getElementById('pricingTabDaily');
  var tabMonthly = document.getElementById('pricingTabMonthly');

  if (tab === 'daily') {
    dailySection.classList.remove('hidden');
    monthlySection.classList.add('hidden');
    tabDaily.className = 'px-6 py-2 rounded-full text-sm font-medium bg-primary-500 text-white shadow-sm transition-all duration-200';
    tabMonthly.className = 'px-6 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 transition-all duration-200';
  } else {
    dailySection.classList.add('hidden');
    monthlySection.classList.remove('hidden');
    tabDaily.className = 'px-6 py-2 rounded-full text-sm font-medium bg-gray-100 text-gray-600 hover:bg-gray-200 transition-all duration-200';
    tabMonthly.className = 'px-6 py-2 rounded-full text-sm font-medium bg-primary-500 text-white shadow-sm transition-all duration-200';
  }
}
</script>
