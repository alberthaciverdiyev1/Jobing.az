<!-- ===== TAB FILTER ===== -->
<section class="pt-12 pb-2 bg-white">
  <div class="max-w-[1000px] mx-auto px-3 sm:px-4 lg:px-6">

    <!-- Tabs -->
    <div class="flex justify-center mt-8 mb-8">
      <div class="inline-flex bg-gray-100 rounded-xl p-1">
        <button onclick="switchPricingTab('daily')" id="pricingTabDaily" class="px-6 py-2 rounded-lg text-sm font-medium bg-white text-gray-900 shadow-sm transition-all duration-200">Günlük</button>
        <button onclick="switchPricingTab('monthly')" id="pricingTabMonthly" class="px-6 py-2 rounded-lg text-sm font-medium text-gray-500 hover:text-gray-700 transition-all duration-200">Aylıq</button>
      </div>
    </div>

    <!-- DAILY CARDS -->
    <div id="pricingDailySection">
      <% if (hasDaily) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-2xl mx-auto">
        <% promoteDaily.forEach(function(plan) { %>
          <%- include('_Card', { plan, accent: 'from-amber-400 to-orange-500', icon: 'fa-rocket', iconBg: 'bg-amber-100 text-amber-600', btnGrad: 'from-amber-500 to-orange-500', badge: null }) %>
        <% }); %>
        <% premiumDaily.forEach(function(plan) { %>
          <%- include('_Card', { plan, accent: 'from-purple-400 to-indigo-500', icon: 'fa-crown', iconBg: 'bg-purple-100 text-purple-600', btnGrad: 'from-purple-500 to-indigo-500', badge: 'Premium' }) %>
        <% }); %>
      </div>
      <% } else { %>
      <div class="text-center py-16">
        <div class="text-5xl text-gray-200 mb-4"><i class="fas fa-sun"></i></div>
        <p class="text-gray-400">Günlük plan mövcud deyil</p>
      </div>
      <% } %>
    </div>

    <!-- MONTHLY CARDS -->
    <div id="pricingMonthlySection" style="display:none">
      <% if (hasMonthly) { %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 max-w-2xl mx-auto">
        <% promoteMonthly.forEach(function(plan) { %>
          <%- include('_Card', { plan, accent: 'from-amber-400 to-orange-500', icon: 'fa-rocket', iconBg: 'bg-amber-100 text-amber-600', btnGrad: 'from-amber-500 to-orange-500', badge: null }) %>
        <% }); %>
        <% premiumMonthly.forEach(function(plan) { %>
          <%- include('_Card', { plan, accent: 'from-purple-400 to-indigo-500', icon: 'fa-crown', iconBg: 'bg-purple-100 text-purple-600', btnGrad: 'from-purple-500 to-indigo-500', badge: 'Premium' }) %>
        <% }); %>
      </div>
      <% } else { %>
      <div class="text-center py-16">
        <div class="text-5xl text-gray-200 mb-4"><i class="fas fa-moon"></i></div>
        <p class="text-gray-400">Aylıq plan mövcud deyil</p>
      </div>
      <% } %>
    </div>
  </div>
</section>

<!-- ===== FAQ SECTION ===== -->
<section class="py-12 sm:py-14 bg-gray-50/60">
  <div class="max-w-[1000px] mx-auto px-3 sm:px-4 lg:px-6">
    <div class="text-center mb-8">
      <h2 class="text-xl sm:text-2xl font-bold text-gray-900">Tez-tez Verilən Suallar</h2>
    </div>
    <div class="max-w-2xl mx-auto space-y-3">
      <details class="bg-white rounded-xl border border-gray-200 p-4 group open:border-primary-200 open:ring-1 open:ring-primary-100">
        <summary class="flex items-center justify-between cursor-pointer font-medium text-gray-900 list-none text-sm">
          <span>İrəli çəkmək nə deməkdir?</span>
          <i class="fas fa-chevron-down text-gray-400 text-xs transition-transform group-open:rotate-180 ml-2 flex-shrink-0"></i>
        </summary>
        <p class="mt-2 text-sm text-gray-500 leading-relaxed">
          İrəli çəkmə planı vakansiyanızın vakansiyalar siyahısında yuxarı qaldırılmasını təmin edir.
          Aylıq planlarda hər 4 gündən bir olmaqla ayda 8 dəfə irəli çəkilir.
        </p>
      </details>
      <details class="bg-white rounded-xl border border-gray-200 p-4 group open:border-primary-200 open:ring-1 open:ring-primary-100">
        <summary class="flex items-center justify-between cursor-pointer font-medium text-gray-900 list-none text-sm">
          <span>Premium etmək nə deməkdir?</span>
          <i class="fas fa-chevron-down text-gray-400 text-xs transition-transform group-open:rotate-180 ml-2 flex-shrink-0"></i>
        </summary>
        <p class="mt-2 text-sm text-gray-500 leading-relaxed">
          Premium planı vakansiyanızı premium elanlar kateqoriyasında göstərir,
          əsas səhifədə xüsusi bölmədə nümayiş etdirir və "Premium" nişanı əlavə edir.
        </p>
      </details>
      <details class="bg-white rounded-xl border border-gray-200 p-4 group open:border-primary-200 open:ring-1 open:ring-primary-100">
        <summary class="flex items-center justify-between cursor-pointer font-medium text-gray-900 list-none text-sm">
          <span>Ödəniş necə həyata keçirilir?</span>
          <i class="fas fa-chevron-down text-gray-400 text-xs transition-transform group-open:rotate-180 ml-2 flex-shrink-0"></i>
        </summary>
        <p class="mt-2 text-sm text-gray-500 leading-relaxed">
          Plan seçib müraciət etdikdən sonra admin sizinlə əlaqə saxlayır.
          Ödəniş və aktivləşdirmə admin tərəfindən idarə olunur.
        </p>
      </details>
      <details class="bg-white rounded-xl border border-gray-200 p-4 group open:border-primary-200 open:ring-1 open:ring-primary-100">
        <summary class="flex items-center justify-between cursor-pointer font-medium text-gray-900 list-none text-sm">
          <span>Eyni anda həm irəli çək, həm premium?</span>
          <i class="fas fa-chevron-down text-gray-400 text-xs transition-transform group-open:rotate-180 ml-2 flex-shrink-0"></i>
        </summary>
        <p class="mt-2 text-sm text-gray-500 leading-relaxed">
          Bəli, eyni vakansiya üçün həm irəli çəkmə, həm də premium planından eyni anda istifadə edə bilərsiniz.
        </p>
      </details>
    </div>
  </div>
</section>

<script>
(function() {
  var dailySection = document.getElementById('pricingDailySection');
  var monthlySection = document.getElementById('pricingMonthlySection');
  var tabDaily = document.getElementById('pricingTabDaily');
  var tabMonthly = document.getElementById('pricingTabMonthly');

  if (dailySection) dailySection.style.display = '';
  if (monthlySection) monthlySection.style.display = 'none';

  window.switchPricingTab = function(tab) {
    if (!dailySection || !monthlySection) return;
    if (tab === 'daily') {
      dailySection.style.display = '';
      monthlySection.style.display = 'none';
      if (tabDaily) tabDaily.className = 'px-6 py-2 rounded-lg text-sm font-medium bg-white text-gray-900 shadow-sm transition-all duration-200';
      if (tabMonthly) tabMonthly.className = 'px-6 py-2 rounded-lg text-sm font-medium text-gray-500 hover:text-gray-700 transition-all duration-200';
    } else {
      dailySection.style.display = 'none';
      monthlySection.style.display = '';
      if (tabDaily) tabDaily.className = 'px-6 py-2 rounded-lg text-sm font-medium text-gray-500 hover:text-gray-700 transition-all duration-200';
      if (tabMonthly) tabMonthly.className = 'px-6 py-2 rounded-lg text-sm font-medium bg-white text-gray-900 shadow-sm transition-all duration-200';
    }
  };
})();
</script>
