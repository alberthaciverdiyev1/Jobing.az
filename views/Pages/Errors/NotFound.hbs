<section class="container error-page">
  <p class="error-page__code">404</p>
  <h1 class="error-page__title">{{t "errors.notFound.title"}}</h1>
  <p class="error-page__text">{{t "errors.notFound.text"}}</p>
  <a class="btn btn--primary" href="/">{{t "errors.backHome"}}</a>
  {{#if requestId}}<p class="error-page__meta">Request ID: {{requestId}}</p>{{/if}}
</section>
